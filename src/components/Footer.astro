---
import { siteConfig } from "../data/site";

const whatsappUrl =
  `https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(
    siteConfig.whatsappMessage
  )}`;
---

<footer class="site-footer">
  <div class="container footer-grid">

    <div>
      <h2>{siteConfig.name}</h2>

      <p>
        {siteConfig.description}
      </p>
    </div>


    <div>
      <h3>Layanan</h3>

<a href={`${import.meta.env.BASE_URL}jasa/`}>
  Jasa Pembuatan Mesin
</a>

<a href={`${import.meta.env.BASE_URL}mesin/`}>
  Katalog Mesin
</a>

<a href={`${import.meta.env.BASE_URL}portfolio/`}>
  Portfolio
</a>

<a href={`${import.meta.env.BASE_URL}artikel/`}>
  Artikel
</a>
    </div>


    <div>
      <h3>Kontak</h3>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        WhatsApp
      </a>

      <a href={`mailto:${siteConfig.email}`}>
        {siteConfig.email}
      </a>

<a href={`${import.meta.env.BASE_URL}kontak/`}>
  Halaman Kontak
</a>
    </div>

  </div>


  <div class="footer-bottom">
    <div class="container">

      <p>
        © {new Date().getFullYear()}
        {siteConfig.name}.
        Semua hak dilindungi.
      </p>

    </div>
  </div>
</footer>


<style>
  .site-footer {
    margin-top: 80px;
    background: #0f172a;
    color: #cbd5e1;
  }

  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }

  .footer-grid {
    padding: 60px 0;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 50px;
  }

  h2 {
    margin-top: 0;
    color: #ffffff;
    font-size: 22px;
  }

  h3 {
    color: #ffffff;
    font-size: 16px;
  }

  p {
    line-height: 1.8;
  }

  .footer-grid a {
    display: block;
    margin: 12px 0;
    color: #cbd5e1;
    text-decoration: none;
  }

  .footer-grid a:hover {
    color: #ffffff;
  }

  .footer-bottom {
    border-top: 1px solid #334155;
    padding: 20px 0;
    font-size: 13px;
  }

  @media (max-width: 700px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }
  }
</style>
