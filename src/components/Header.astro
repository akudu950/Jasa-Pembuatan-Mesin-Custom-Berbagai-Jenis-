```astro
---
import { siteConfig } from "../data/site";

const menuItems = siteConfig.navigation;
---

<header class="site-header">
  <div class="container header-inner">

    <a href={import.meta.env.BASE_URL} class="logo">
      <span>JASA PEMBUATAN</span>
      <strong>MESIN CUSTOM</strong>
    </a>

    <nav class="main-nav" aria-label="Navigasi utama">
      {menuItems.map((item) => (
        <a href={`${import.meta.env.BASE_URL}${item.href.replace(/^\//, "")}`}>
  {item.label}
</a>
      ))}
    </nav>

    <a
      href={`https://wa.me/${siteConfig.whatsapp}`}
      class="header-whatsapp"
      target="_blank"
      rel="noopener noreferrer"
    >
      Konsultasi
    </a>

  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;
  }

  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }

  .header-inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1.1;
  }

  .logo span {
    font-size: 11px;
    letter-spacing: 1.5px;
    color: #64748b;
  }

  .logo strong {
    font-size: 18px;
    color: #0f172a;
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .main-nav a {
    color: #334155;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }

  .main-nav a:hover {
    color: #0f766e;
  }

  .header-whatsapp {
    background: #0f766e;
    color: white;
    text-decoration: none;
    padding: 11px 18px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
  }

  .header-whatsapp:hover {
    background: #115e59;
  }

  @media (max-width: 900px) {
    .main-nav {
      display: none;
    }

    .header-inner {
      min-height: 68px;
    }
  }
</style>
```
