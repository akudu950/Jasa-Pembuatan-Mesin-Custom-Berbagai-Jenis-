---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Jasa Otomatisasi Industri dan Sistem Mesin Custom"
  description="Jasa otomatisasi industri dan pembuatan sistem mesin custom untuk meningkatkan efisiensi, konsistensi, kapasitas produksi, dan pengendalian proses."
>

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">

      <div class="hero-content">

        <span class="eyebrow">
          OTOMATISASI INDUSTRI
        </span>

        <h1>
          Jasa Otomatisasi Industri untuk Produksi yang Lebih Efisien
        </h1>

        <p class="hero-description">
          Perancangan dan pembuatan sistem otomatisasi industri sesuai
          kebutuhan proses produksi, mulai dari mekanik, conveyor,
          kontrol mesin, hingga integrasi beberapa tahapan produksi.
        </p>

        <div class="hero-actions">

          <a
            href={`https://wa.me/6281234567890?text=${encodeURIComponent(
              "Halo, saya ingin konsultasi tentang otomatisasi industri."
            )}`}
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            Konsultasi Otomatisasi
          </a>

          <a
            href={`${base}jasa/mesin-custom/`}
            class="btn btn-secondary"
          >
            Mesin Custom
          </a>

        </div>

      </div>

      <div class="hero-card">

        <div class="hero-icon">
          ⚙
        </div>

        <h2>
          Sistem Otomatisasi Sesuai Proses Produksi
        </h2>

        <p>
          Setiap proses produksi memiliki kebutuhan berbeda.
          Sistem otomatisasi dapat dirancang berdasarkan alur kerja,
          kapasitas, material, tingkat presisi, dan target produksi.
        </p>

      </div>

    </div>
  </section>


  <!-- INTRO -->
  <section class="section">

    <div class="container narrow">

      <span class="section-label">
        SOLUSI OTOMATISASI
      </span>

      <h2>
        Apa Itu Otomatisasi Industri?
      </h2>

      <p>
        Otomatisasi industri merupakan penerapan sistem mekanik,
        elektrik, kontrol, sensor, dan perangkat pendukung untuk
        membantu menjalankan proses produksi secara lebih teratur
        dan efisien.
      </p>

      <p>
        Pada kebutuhan tertentu, sistem otomatisasi tidak cukup
        menggunakan mesin standar. Diperlukan perancangan mesin
        custom yang disesuaikan dengan karakteristik produk,
        kapasitas produksi, ruang kerja, dan alur proses.
      </p>

      <p>
        Karena itu, jasa otomatisasi industri dapat dikombinasikan
        dengan pembuatan mesin custom, conveyor, sistem feeding,
        filling, packaging, maupun sistem pemindahan material.
      </p>

    </div>

  </section>


  <!-- SOLUTIONS -->
  <section class="section section-light">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          RUANG LINGKUP
        </span>

        <h2>
          Solusi Otomatisasi yang Dapat Dikembangkan
        </h2>

        <p>
          Sistem dapat dirancang berdasarkan kebutuhan proses dan
          tingkat otomatisasi yang diinginkan.
        </p>

      </div>


      <div class="card-grid">

        <article class="info-card">

          <div class="card-number">
            01
          </div>

          <h3>
            Conveyor Otomatis
          </h3>

          <p>
            Sistem conveyor untuk memindahkan produk atau material
            antarproses produksi secara lebih teratur.
          </p>

        </article>


        <article class="info-card">

          <div class="card-number">
            02
          </div>

          <h3>
            Sistem Feeding
          </h3>

          <p>
            Perancangan sistem feeding untuk memasukkan bahan atau
            produk ke proses berikutnya secara lebih konsisten.
          </p>

        </article>


        <article class="info-card">

          <div class="card-number">
            03
          </div>

          <h3>
            Mesin Filling
          </h3>

          <p>
            Sistem pengisian produk yang dapat disesuaikan dengan
            jenis material, ukuran kemasan, dan kapasitas produksi.
          </p>

        </article>


        <article class="info-card">

          <div class="card-number">
            04
          </div>

          <h3>
            Sistem Packaging
          </h3>

          <p>
            Integrasi proses pengemasan dengan conveyor, sealing,
            filling, counting, atau proses pendukung lainnya.
          </p>

        </article>


        <article class="info-card">

          <div class="card-number">
            05
          </div>

          <h3>
            Kontrol Mesin
          </h3>

          <p>
            Sistem kontrol dapat dikembangkan untuk mengatur
            urutan kerja mesin dan parameter proses produksi.
          </p>

        </article>


        <article class="info-card">

          <div class="card-number">
            06
          </div>

          <h3>
            Integrasi Sistem Produksi
          </h3>

          <p>
            Beberapa mesin dan tahapan proses dapat diintegrasikan
            menjadi satu sistem produksi yang lebih terkoordinasi.
          </p>

        </article>

      </div>

    </div>

  </section>


  <!-- APPLICATIONS -->
  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          PENERAPAN
        </span>

        <h2>
          Otomatisasi untuk Berbagai Kebutuhan Industri
        </h2>

        <p>
          Sistem otomatisasi dapat dikembangkan untuk berbagai
          bidang industri dan karakteristik proses produksi.
        </p>

      </div>


      <div class="application-grid">

        <div class="application-item">
          <strong>Industri Makanan & Minuman</strong>
          <span>
            Filling, conveyor, packaging, mixing, dan proses produksi.
          </span>
        </div>

        <div class="application-item">
          <strong>Industri Manufaktur</strong>
          <span>
            Pemindahan material, assembly, handling, dan proses produksi.
          </span>
        </div>

        <div class="application-item">
          <strong>Industri Packaging</strong>
          <span>
            Feeding, counting, filling, sealing, dan pemindahan produk.
          </span>
        </div>

        <div class="application-item">
          <strong>Pertanian & Agro</strong>
          <span>
            Sortasi, pengolahan hasil panen, conveyor, dan packaging.
          </span>
        </div>

        <div class="application-item">
          <strong>Pengolahan Limbah</strong>
          <span>
            Pemindahan material, pencacahan, pemilahan, dan proses lainnya.
          </span>
        </div>

        <div class="application-item">
          <strong>Produksi Custom</strong>
          <span>
            Sistem khusus berdasarkan alur produksi dan kebutuhan industri.
          </span>
        </div>

      </div>

    </div>

  </section>


  <!-- BENEFITS -->
  <section class="section section-dark">

    <div class="container">

      <div class="section-heading dark">

        <span class="section-label">
          KEUNGGULAN
        </span>

        <h2>
          Mengapa Menggunakan Otomatisasi Industri?
        </h2>

      </div>


      <div class="benefit-grid">

        <div class="benefit-item">

          <span>01</span>

          <div>
            <h3>
              Proses Lebih Konsisten
            </h3>

            <p>
              Sistem otomatisasi dapat membantu menjaga
              konsistensi proses kerja sesuai parameter yang ditentukan.
            </p>
          </div>

        </div>


        <div class="benefit-item">

          <span>02</span>

          <div>
            <h3>
              Efisiensi Produksi
            </h3>

            <p>
              Otomatisasi dapat membantu mengurangi pekerjaan
              berulang dan meningkatkan efisiensi alur produksi.
            </p>
          </div>

        </div>


        <div class="benefit-item">

          <span>03</span>

          <div>
            <h3>
              Kapasitas Dapat Disesuaikan
            </h3>

            <p>
              Sistem dirancang berdasarkan kebutuhan kapasitas,
              ukuran produk, dan target produksi.
            </p>
          </div>

        </div>


        <div class="benefit-item">

          <span>04</span>

          <div>
            <h3>
              Dapat Dikembangkan
            </h3>

            <p>
              Sistem dapat dipersiapkan agar memungkinkan
              pengembangan atau penambahan proses di kemudian hari.
            </p>
          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- PROCESS -->
  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          TAHAPAN
        </span>

        <h2>
          Proses Pengembangan Sistem Otomatisasi
        </h2>

      </div>


      <div class="process-grid">

        <div class="process-card">

          <span>01</span>

          <h3>
            Analisis Proses
          </h3>

          <p>
            Memahami alur produksi, material, kapasitas,
            kebutuhan operator, dan target otomatisasi.
          </p>

        </div>


        <div class="process-card">

          <span>02</span>

          <h3>
            Perancangan
          </h3>

          <p>
            Menentukan konsep mekanik, alur kerja mesin,
            sistem pemindahan material, dan kontrol.
          </p>

        </div>


        <div class="process-card">

          <span>03</span>

          <h3>
            Fabrikasi & Assembly
          </h3>

          <p>
            Pembuatan komponen, rangka, sistem mekanik,
            kemudian dilanjutkan dengan proses perakitan.
          </p>

        </div>


        <div class="process-card">

          <span>04</span>

          <h3>
            Testing
          </h3>

          <p>
            Pengujian dilakukan untuk memastikan sistem
            bekerja sesuai rancangan dan kebutuhan proses.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- REQUIREMENTS -->
  <section class="section section-light">

    <div class="container two-column">

      <div>

        <span class="section-label">
          INFORMASI KEBUTUHAN
        </span>

        <h2>
          Informasi yang Sebaiknya Disiapkan
        </h2>

        <p>
          Semakin lengkap informasi proses produksi,
          semakin mudah konsep otomatisasi dikembangkan
          sesuai kebutuhan.
        </p>

      </div>


      <div class="check-list">

        <div>
          ✓ Jenis produk atau material
        </div>

        <div>
          ✓ Kapasitas produksi
        </div>

        <div>
          ✓ Alur proses produksi
        </div>

        <div>
          ✓ Ukuran dan karakteristik produk
        </div>

        <div>
          ✓ Tingkat otomatisasi yang diinginkan
        </div>

        <div>
          ✓ Kondisi ruang dan area pemasangan
        </div>

      </div>

    </div>

  </section>


  <!-- RELATED -->
  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          LAYANAN TERKAIT
        </span>

        <h2>
          Layanan Mesin yang Berkaitan dengan Otomatisasi
        </h2>

      </div>


      <div class="related-grid">

        <a
          href={`${base}jasa/mesin-produksi-custom/`}
          class="related-card"
        >
          <strong>
            Mesin Produksi Custom
          </strong>

          <span>
            Mesin produksi yang dirancang sesuai proses industri.
          </span>
        </a>


        <a
          href={`${base}jasa/pembuatan-conveyor/`}
          class="related-card"
        >
          <strong>
            Pembuatan Conveyor
          </strong>

          <span>
            Conveyor custom untuk kebutuhan pemindahan material.
          </span>
        </a>


        <a
          href={`${base}jasa/mesin-packaging/`}
          class="related-card"
        >
          <strong>
            Mesin Packaging
          </strong>

          <span>
            Solusi mesin pengemasan untuk berbagai jenis produk.
          </span>
        </a>


        <a
          href={`${base}jasa/fabrikasi-mesin/`}
          class="related-card"
        >
          <strong>
            Jasa Fabrikasi Mesin
          </strong>

          <span>
            Pembuatan rangka dan komponen mesin sesuai spesifikasi.
          </span>
        </a>

      </div>

    </div>

  </section>


  <!-- CTA -->
  <section class="cta-section">

    <div class="container cta-inner">

      <div>

        <span class="section-label">
          KONSULTASI
        </span>

        <h2>
          Ingin Mengembangkan Sistem Otomatisasi untuk Produksi?
        </h2>

        <p>
          Konsultasikan alur produksi, kebutuhan kapasitas,
          dan proses yang ingin diotomatisasi untuk mendapatkan
          konsep mesin yang sesuai.
        </p>

      </div>


      <a
        href={`https://wa.me/6281234567890?text=${encodeURIComponent(
          "Halo, saya ingin konsultasi tentang otomatisasi industri dan sistem mesin custom."
        )}`}
        class="btn btn-light"
        target="_blank"
        rel="noopener noreferrer"
      >
        Konsultasi Sekarang
      </a>

    </div>

  </section>

</BaseLayout>


<style>
  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }

  .narrow {
    max-width: 850px;
  }

  .hero {
    padding: 90px 0;
    background:
      linear-gradient(
        135deg,
        #f0fdfa 0%,
        #ffffff 55%,
        #f8fafc 100%
      );
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    align-items: center;
    gap: 70px;
  }

  .eyebrow,
  .section-label {
    display: inline-block;
    margin-bottom: 14px;
    color: #0f766e;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  h1 {
    max-width: 780px;
    margin: 0;
    color: #0f172a;
    font-size: clamp(38px, 5vw, 64px);
    line-height: 1.08;
    letter-spacing: -1.5px;
  }

  .hero-description {
    max-width: 720px;
    margin: 24px 0 0;
    color: #475569;
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 9px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 800;
    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background: #0f766e;
    color: #ffffff;
  }

  .btn-primary:hover {
    background: #115e59;
  }

  .btn-secondary {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
  }

  .hero-card {
    padding: 34px;
    background: #ffffff;
    border: 1px solid #dbeafe;
    border-radius: 18px;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
  }

  .hero-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    margin-bottom: 24px;
    border-radius: 16px;
    background: #ccfbf1;
    font-size: 32px;
  }

  .hero-card h2 {
    margin: 0 0 14px;
    color: #0f172a;
    font-size: 24px;
    line-height: 1.3;
  }

  .hero-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.8;
  }

  .section {
    padding: 85px 0;
  }

  .section-light {
    background: #f8fafc;
  }

  .section-dark {
    background: #0f172a;
    color: #cbd5e1;
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 42px;
  }

  .section-heading h2,
  .narrow h2,
  .two-column h2 {
    margin: 0 0 18px;
    color: #0f172a;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.2;
  }

  .section-heading p,
  .narrow p,
  .two-column p {
    color: #64748b;
    line-height: 1.8;
  }

  .section-dark .section-heading h2 {
    color: #ffffff;
  }

  .section-dark .section-label {
    color: #5eead4;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .info-card {
    padding: 30px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }

  .card-number {
    margin-bottom: 20px;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .info-card h3 {
    margin: 0 0 12px;
    color: #0f172a;
    font-size: 20px;
  }

  .info-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.75;
  }

  .application-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .application-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
  }

  .application-item strong {
    color: #0f172a;
  }

  .application-item span {
    color: #64748b;
    line-height: 1.7;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .benefit-item {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 18px;
    padding: 26px 0;
    border-top: 1px solid #334155;
  }

  .benefit-item > span {
    color: #5eead4;
    font-size: 13px;
    font-weight: 800;
  }

  .benefit-item h3 {
    margin: 0 0 10px;
    color: #ffffff;
    font-size: 19px;
  }

  .benefit-item p {
    margin: 0;
    line-height: 1.75;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .process-card {
    padding: 28px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }

  .process-card > span {
    color: #0f766e;
    font-weight: 800;
    font-size: 13px;
  }

  .process-card h3 {
    margin: 18px 0 10px;
    color: #0f172a;
    font-size: 19px;
  }

  .process-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.7;
  }

  .two-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: start;
  }

  .check-list {
    display: grid;
    gap: 12px;
  }

  .check-list div {
    padding: 16px 18px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    color: #334155;
    font-weight: 600;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .related-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(15, 23, 42, 0.08);
  }

  .related-card strong {
    color: #0f172a;
  }

  .related-card span {
    color: #64748b;
    font-size: 14px;
    line-height: 1.6;
  }

  .cta-section {
    padding: 70px 0;
    background: #0f766e;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .cta-inner h2 {
    max-width: 750px;
    margin: 0 0 14px;
    color: #ffffff;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.2;
  }

  .cta-inner p {
    max-width: 720px;
    margin: 0;
    color: #ccfbf1;
    line-height: 1.8;
  }

  .cta-inner .section-label {
    color: #99f6e4;
  }

  .btn-light {
    flex-shrink: 0;
    background: #ffffff;
    color: #0f766e;
  }

  @media (max-width: 1000px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 700px) {
    .hero {
      padding: 65px 0;
    }

    .section {
      padding: 65px 0;
    }

    .card-grid,
    .application-grid,
    .benefit-grid,
    .process-grid,
    .two-column,
    .related-grid {
      grid-template-columns: 1fr;
    }

    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero-description {
      font-size: 16px;
    }
  }
</style>
