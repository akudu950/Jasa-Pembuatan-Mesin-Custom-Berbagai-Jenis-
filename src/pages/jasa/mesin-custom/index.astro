---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Jasa Pembuatan Mesin Custom untuk Kebutuhan Industri"
  description="Jasa pembuatan mesin custom untuk kebutuhan industri, produksi, manufaktur, makanan dan minuman, pertanian, packaging, conveyor, dan berbagai kebutuhan otomatisasi."
>

  <section class="hero">
    <div class="container">

      <span class="eyebrow">
        JASA PEMBUATAN MESIN CUSTOM
      </span>

      <h1>
        Jasa Pembuatan Mesin Custom untuk Kebutuhan Industri
      </h1>

      <p>
        Solusi pembuatan mesin custom yang dirancang berdasarkan kebutuhan
        proses produksi, karakteristik produk, kapasitas kerja, layout,
        dan target operasional industri.
      </p>

      <div class="hero-actions">

        <a
          href={`${base}kontak/`}
          class="btn btn-primary"
        >
          Konsultasikan Kebutuhan
        </a>

        <a
          href={`${base}mesin/`}
          class="btn btn-secondary"
        >
          Lihat Kategori Mesin
        </a>

      </div>

    </div>
  </section>


  <section class="section">
    <div class="container">

      <div class="two-column">

        <div>
          <span class="eyebrow">
            MESIN SESUAI KEBUTUHAN
          </span>

          <h2>
            Mengapa Memilih Mesin Custom?
          </h2>

          <p>
            Tidak semua kebutuhan produksi dapat dipenuhi oleh mesin standar.
            Setiap industri memiliki proses, kapasitas, ukuran produk,
            karakteristik material, dan kondisi area kerja yang berbeda.
          </p>

          <p>
            Mesin custom memungkinkan sistem kerja dirancang lebih spesifik
            berdasarkan kebutuhan tersebut sehingga konfigurasi mesin dapat
            disesuaikan dengan proses produksi yang sebenarnya.
          </p>

          <p>
            Perancangan dapat mencakup sistem mekanik, komponen penggerak,
            sistem elektrik, kontrol, dimensi mesin, hingga integrasi dengan
            peralatan produksi lainnya.
          </p>
        </div>


        <div class="feature-box">

          <div class="feature">
            <strong>Spesifikasi Sesuai Kebutuhan</strong>
            <span>
              Mesin dirancang berdasarkan kebutuhan proses dan karakteristik
              pekerjaan.
            </span>
          </div>

          <div class="feature">
            <strong>Konfigurasi Fleksibel</strong>
            <span>
              Dimensi dan sistem kerja dapat disesuaikan dengan kondisi
              area produksi.
            </span>
          </div>

          <div class="feature">
            <strong>Dapat Diintegrasikan</strong>
            <span>
              Mesin dapat dirancang untuk terhubung dengan conveyor,
              sensor, kontrol, maupun mesin lainnya.
            </span>
          </div>

          <div class="feature">
            <strong>Berorientasi pada Proses</strong>
            <span>
              Perancangan mempertimbangkan alur kerja dan kebutuhan
              operasional produksi.
            </span>
          </div>

        </div>

      </div>

    </div>
  </section>


  <section class="section section-light">
    <div class="container">

      <div class="section-heading">

        <span class="eyebrow">
          JENIS KEBUTUHAN
        </span>

        <h2>
          Solusi Mesin Custom untuk Berbagai Industri
        </h2>

        <p>
          Pembuatan mesin dapat dikembangkan untuk berbagai kebutuhan
          produksi dan proses industri.
        </p>

      </div>


      <div class="service-grid">

        <a
          href={`${base}mesin/makanan-minuman/`}
          class="service-card"
        >
          <span class="number">01</span>

          <h3>
            Mesin Makanan & Minuman
          </h3>

          <p>
            Mesin untuk proses pengolahan, mixing, filling, packaging,
            conveyor, dan kebutuhan produksi makanan serta minuman.
          </p>

          <span class="link">
            Lihat kategori →
          </span>
        </a>


        <a
          href={`${base}mesin/manufaktur-logam/`}
          class="service-card"
        >
          <span class="number">02</span>

          <h3>
            Mesin Manufaktur & Logam
          </h3>

          <p>
            Solusi mesin untuk kebutuhan manufaktur, fabrikasi,
            pengolahan material, dan proses industri.
          </p>

          <span class="link">
            Lihat kategori →
          </span>
        </a>


        <a
          href={`${base}mesin/pertanian-agro/`}
          class="service-card"
        >
          <span class="number">03</span>

          <h3>
            Mesin Pertanian & Agro
          </h3>

          <p>
            Mesin untuk pengolahan hasil pertanian, sortasi, pengeringan,
            pencacahan, pemindahan, dan agroindustri.
          </p>

          <span class="link">
            Lihat kategori →
          </span>
        </a>


        <a
          href={`${base}mesin/pengolahan-limbah/`}
          class="service-card"
        >
          <span class="number">04</span>

          <h3>
            Mesin Pengolahan Limbah
          </h3>

          <p>
            Sistem mesin untuk membantu proses pencacahan, pemilahan,
            pemadatan, pengeringan, dan pengolahan limbah.
          </p>

          <span class="link">
            Lihat kategori →
          </span>
        </a>


        <a
          href={`${base}mesin/packaging/`}
          class="service-card"
        >
          <span class="number">05</span>

          <h3>
            Mesin Packaging
          </h3>

          <p>
            Mesin pengemasan custom untuk kebutuhan filling, sealing,
            labeling, packaging, dan integrasi lini produksi.
          </p>

          <span class="link">
            Lihat kategori →
          </span>
        </a>


        <a
          href={`${base}mesin/conveyor/`}
          class="service-card"
        >
          <span class="number">06</span>

          <h3>
            Conveyor Custom
          </h3>

          <p>
            Pembuatan conveyor untuk pemindahan produk dan material
            sesuai kebutuhan layout dan kapasitas produksi.
          </p>

          <span class="link">
            Lihat kategori →
          </span>
        </a>

      </div>

    </div>
  </section>


  <section class="section">
    <div class="container">

      <div class="section-heading">

        <span class="eyebrow">
          CAKUPAN PEKERJAAN
        </span>

        <h2>
          Apa Saja yang Dapat Disesuaikan?
        </h2>

        <p>
          Konsep mesin dapat dikembangkan berdasarkan kebutuhan teknis
          dan proses kerja yang ingin dicapai.
        </p>

      </div>


      <div class="custom-grid">

        <article class="custom-card">
          <h3>Dimensi Mesin</h3>
          <p>
            Ukuran dan konfigurasi mesin dapat disesuaikan dengan area
            pemasangan serta kebutuhan operasional.
          </p>
        </article>


        <article class="custom-card">
          <h3>Kapasitas Produksi</h3>
          <p>
            Sistem kerja dirancang dengan mempertimbangkan target kapasitas
            dan kecepatan proses produksi.
          </p>
        </article>


        <article class="custom-card">
          <h3>Sistem Mekanik</h3>
          <p>
            Komponen mekanik dipilih berdasarkan beban kerja, material,
            gerakan, dan kebutuhan proses.
          </p>
        </article>


        <article class="custom-card">
          <h3>Sistem Kontrol</h3>
          <p>
            Sistem kontrol dapat disesuaikan dengan tingkat otomatisasi
            dan kebutuhan pengoperasian mesin.
          </p>
        </article>


        <article class="custom-card">
          <h3>Conveyor & Transfer</h3>
          <p>
            Sistem pemindahan produk atau material dapat menjadi bagian
            dari mesin custom maupun lini produksi.
          </p>
        </article>


        <article class="custom-card">
          <h3>Integrasi Mesin</h3>
          <p>
            Mesin dapat dirancang agar dapat bekerja bersama peralatan
            lain dalam satu alur proses.
          </p>
        </article>

      </div>

    </div>
  </section>


  <section class="section section-light">
    <div class="container">

      <div class="section-heading">

        <span class="eyebrow">
          PROSES PEMBUATAN
        </span>

        <h2>
          Tahapan Pembuatan Mesin Custom
        </h2>

        <p>
          Setiap proyek dimulai dengan memahami kebutuhan sebelum masuk
          ke tahap perancangan dan pembuatan mesin.
        </p>

      </div>


      <div class="process-grid">

        <div class="process-card">
          <span>01</span>

          <h3>
            Konsultasi
          </h3>

          <p>
            Membahas kebutuhan, proses kerja, produk, kapasitas,
            dan kondisi area.
          </p>
        </div>


        <div class="process-card">
          <span>02</span>

          <h3>
            Analisis
          </h3>

          <p>
            Menentukan kebutuhan teknis dan konsep sistem yang sesuai.
          </p>
        </div>


        <div class="process-card">
          <span>03</span>

          <h3>
            Perancangan
          </h3>

          <p>
            Menentukan desain, dimensi, komponen, dan sistem kerja mesin.
          </p>
        </div>


        <div class="process-card">
          <span>04</span>

          <h3>
            Fabrikasi
          </h3>

          <p>
            Pembuatan rangka dan komponen berdasarkan rancangan.
          </p>
        </div>


        <div class="process-card">
          <span>05</span>

          <h3>
            Assembly & Testing
          </h3>

          <p>
            Perakitan dan pengujian fungsi mesin sebelum digunakan.
          </p>
        </div>

      </div>

    </div>
  </section>


  <section class="section">
    <div class="container">

      <div class="two-column">

        <div>

          <span class="eyebrow">
            KEBUTUHAN PROYEK
          </span>

          <h2>
            Informasi yang Sebaiknya Disiapkan
          </h2>

          <p>
            Semakin jelas informasi awal yang diberikan, semakin mudah
            menentukan konsep dan spesifikasi mesin yang dibutuhkan.
          </p>

        </div>


        <div class="info-list">

          <div>
            <span>01</span>
            <p>
              Jenis produk atau material yang akan diproses.
            </p>
          </div>

          <div>
            <span>02</span>
            <p>
              Kapasitas atau target produksi yang diinginkan.
            </p>
          </div>

          <div>
            <span>03</span>
            <p>
              Ukuran produk dan karakteristik material.
            </p>
          </div>

          <div>
            <span>04</span>
            <p>
              Alur proses produksi yang saat ini digunakan.
            </p>
          </div>

          <div>
            <span>05</span>
            <p>
              Ukuran area dan kondisi lokasi pemasangan mesin.
            </p>
          </div>

        </div>

      </div>

    </div>
  </section>


  <section class="section section-light">
    <div class="container">

      <div class="section-heading">

        <span class="eyebrow">
          LAYANAN TERKAIT
        </span>

        <h2>
          Jelajahi Layanan Mesin Lainnya
        </h2>

      </div>


      <div class="related-grid">

        <a href={`${base}jasa/fabrikasi-mesin/`}>
          <strong>
            Jasa Fabrikasi Mesin
          </strong>

          <span>
            Pembuatan komponen dan konstruksi mesin sesuai kebutuhan.
          </span>
        </a>


        <a href={`${base}jasa/otomatisasi-industri/`}>
          <strong>
            Otomatisasi Industri
          </strong>

          <span>
            Solusi otomatisasi untuk membantu meningkatkan efisiensi proses.
          </span>
        </a>


        <a href={`${base}jasa/mesin-produksi-custom/`}>
          <strong>
            Mesin Produksi Custom
          </strong>

          <span>
            Mesin yang dirancang untuk kebutuhan proses produksi tertentu.
          </span>
        </a>


        <a href={`${base}jasa/pembuatan-conveyor/`}>
          <strong>
            Pembuatan Conveyor
          </strong>

          <span>
            Conveyor custom untuk pemindahan material dan produk.
          </span>
        </a>


        <a href={`${base}jasa/mesin-packaging/`}>
          <strong>
            Mesin Packaging
          </strong>

          <span>
            Solusi mesin untuk kebutuhan pengemasan dan packaging.
          </span>
        </a>


        <a href={`${base}portfolio/`}>
          <strong>
            Portfolio
          </strong>

          <span>
            Lihat contoh konsep dan proyek mesin custom.
          </span>
        </a>

      </div>

    </div>
  </section>


  <section class="cta-section">
    <div class="container">

      <span class="eyebrow">
        KONSULTASI MESIN
      </span>

      <h2>
        Punya Kebutuhan Mesin Custom?
      </h2>

      <p>
        Sampaikan kebutuhan proses, produk, kapasitas, ukuran area,
        dan target kerja mesin untuk mendapatkan pembahasan konsep
        yang lebih sesuai.
      </p>

      <a
        href={`${base}kontak/`}
        class="btn btn-light"
      >
        Konsultasikan Kebutuhan
      </a>

    </div>
  </section>

</BaseLayout>


<style>
  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }

  .hero {
    padding: 100px 0;
    background:
      linear-gradient(
        135deg,
        #f0fdfa 0%,
        #ffffff 55%,
        #f8fafc 100%
      );
  }

  .eyebrow {
    display: inline-block;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  .hero h1 {
    max-width: 900px;
    margin: 15px 0 20px;
    color: #0f172a;
    font-size: clamp(36px, 5vw, 58px);
    line-height: 1.08;
  }

  .hero p {
    max-width: 780px;
    color: #475569;
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 22px;
    border-radius: 9px;
    text-decoration: none;
    font-weight: 700;
    transition: 0.2s ease;
  }

  .btn-primary {
    background: #0f766e;
    color: #ffffff;
  }

  .btn-primary:hover {
    background: #115e59;
  }

  .btn-secondary {
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
  }

  .btn-secondary:hover {
    border-color: #0f766e;
    color: #0f766e;
  }

  .section {
    padding: 90px 0;
  }

  .section-light {
    background: #f8fafc;
  }

  .section-heading {
    max-width: 800px;
    margin-bottom: 45px;
  }

  .section-heading h2 {
    margin: 10px 0 16px;
    color: #0f172a;
    font-size: clamp(30px, 4vw, 42px);
    line-height: 1.2;
  }

  .section-heading p {
    color: #64748b;
    line-height: 1.8;
  }

  .two-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: start;
  }

  .two-column h2 {
    margin: 10px 0 18px;
    color: #0f172a;
    font-size: clamp(30px, 4vw, 42px);
    line-height: 1.2;
  }

  .two-column > div > p {
    color: #64748b;
    line-height: 1.8;
  }

  .feature-box {
    display: grid;
    gap: 16px;
  }

  .feature {
    padding: 22px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #ffffff;
  }

  .feature strong {
    display: block;
    margin-bottom: 8px;
    color: #0f172a;
  }

  .feature span {
    color: #64748b;
    line-height: 1.7;
    font-size: 14px;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .service-card {
    display: block;
    padding: 30px;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: #ffffff;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    border-color: #99f6e4;
    box-shadow: 0 15px 35px rgba(15, 23, 42, 0.08);
  }

  .number {
    display: block;
    margin-bottom: 18px;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
  }

  .service-card h3 {
    margin: 0 0 12px;
    color: #0f172a;
    font-size: 20px;
  }

  .service-card p {
    margin: 0 0 20px;
    color: #64748b;
    line-height: 1.7;
    font-size: 14px;
  }

  .link {
    color: #0f766e;
    font-size: 14px;
    font-weight: 800;
  }

  .custom-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .custom-card {
    padding: 28px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
  }

  .custom-card h3 {
    margin: 0 0 10px;
    color: #0f172a;
  }

  .custom-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.7;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
  }

  .process-card {
    padding: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
  }

  .process-card span {
    display: inline-flex;
    margin-bottom: 18px;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
  }

  .process-card h3 {
    margin: 0 0 10px;
    color: #0f172a;
  }

  .process-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.6;
    font-size: 14px;
  }

  .info-list {
    display: grid;
    gap: 14px;
  }

  .info-list div {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 18px 20px;
    border-radius: 10px;
    background: #f8fafc;
  }

  .info-list span {
    flex: 0 0 auto;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
  }

  .info-list p {
    margin: 0;
    color: #475569;
    line-height: 1.6;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .related-grid a {
    display: block;
    padding: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
    text-decoration: none;
  }

  .related-grid a:hover {
    border-color: #0f766e;
  }

  .related-grid strong {
    display: block;
    margin-bottom: 8px;
    color: #0f172a;
  }

  .related-grid span {
    color: #64748b;
    line-height: 1.6;
    font-size: 14px;
  }

  .cta-section {
    padding: 90px 0;
    background: #0f766e;
    text-align: center;
  }

  .cta-section .eyebrow {
    color: #ccfbf1;
  }

  .cta-section h2 {
    margin: 12px 0 16px;
    color: #ffffff;
    font-size: clamp(30px, 4vw, 44px);
  }

  .cta-section p {
    max-width: 720px;
    margin: 0 auto 30px;
    color: #d1fae5;
    line-height: 1.8;
  }

  .btn-light {
    background: #ffffff;
    color: #0f766e;
  }

  .btn-light:hover {
    background: #f0fdfa;
  }

  @media (max-width: 900px) {
    .service-grid,
    .custom-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .two-column {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 70px 0;
    }

    .section {
      padding: 65px 0;
    }

    .service-grid,
    .custom-grid,
    .process-grid,
    .related-grid {
      grid-template-columns: 1fr;
    }

    .hero-actions {
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }
  }
</style>
