---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Jasa Fabrikasi Mesin Custom untuk Kebutuhan Industri"
  description="Jasa fabrikasi mesin custom untuk pembuatan rangka, komponen, konstruksi, dan kebutuhan mesin industri sesuai spesifikasi dan kebutuhan produksi."
>

  <section class="hero">
    <div class="container">

      <span class="eyebrow">
        JASA FABRIKASI MESIN
      </span>

      <h1>
        Jasa Fabrikasi Mesin Custom untuk Kebutuhan Industri
      </h1>

      <p>
        Layanan fabrikasi untuk pembuatan rangka, komponen, konstruksi,
        dan bagian mesin berdasarkan desain serta kebutuhan teknis
        proyek industri.
      </p>

      <div class="hero-actions">

        <a
          href={`${base}kontak/`}
          class="btn btn-primary"
        >
          Konsultasikan Proyek
        </a>

        <a
          href={`${base}jasa/mesin-custom/`}
          class="btn btn-secondary"
        >
          Jasa Mesin Custom
        </a>

      </div>

    </div>
  </section>


  <section class="section">
    <div class="container">

      <div class="two-column">

        <div>

          <span class="eyebrow">
            FABRIKASI SESUAI SPESIFIKASI
          </span>

          <h2>
            Fabrikasi Mesin untuk Berbagai Kebutuhan
          </h2>

          <p>
            Fabrikasi merupakan bagian penting dalam proses pembuatan
            mesin custom. Setiap komponen perlu dibuat berdasarkan ukuran,
            bentuk, material, dan fungsi yang telah ditentukan.
          </p>

          <p>
            Proses fabrikasi dapat mencakup pembuatan rangka mesin,
            dudukan komponen, hopper, cover, frame conveyor, struktur
            pendukung, hingga berbagai komponen custom lainnya.
          </p>

          <p>
            Pekerjaan dapat dikembangkan berdasarkan gambar teknik,
            spesifikasi yang tersedia, maupun kebutuhan proses yang
            dibahas sejak tahap awal perancangan.
          </p>

        </div>


        <div class="feature-box">

          <div class="feature">
            <strong>Rangka Mesin</strong>

            <span>
              Pembuatan rangka dan struktur utama sesuai dimensi
              serta kebutuhan beban mesin.
            </span>
          </div>


          <div class="feature">
            <strong>Komponen Custom</strong>

            <span>
              Pembuatan komponen tertentu berdasarkan fungsi dan
              spesifikasi teknis yang dibutuhkan.
            </span>
          </div>


          <div class="feature">
            <strong>Struktur Conveyor</strong>

            <span>
              Fabrikasi frame dan struktur pendukung untuk berbagai
              kebutuhan sistem conveyor.
            </span>
          </div>


          <div class="feature">
            <strong>Assembly</strong>

            <span>
              Komponen hasil fabrikasi dapat dilanjutkan ke proses
              perakitan sesuai konsep mesin.
            </span>
          </div>

        </div>

      </div>

    </div>
  </section>


  <section class="section section-light">
    <div class="container">

      <div class="section-heading">

        <span class="eyebrow">
          LINGKUP FABRIKASI
        </span>

        <h2>
          Komponen dan Konstruksi yang Dapat Dibuat
        </h2>

        <p>
          Lingkup pekerjaan dapat disesuaikan dengan kebutuhan mesin,
          sistem produksi, dan spesifikasi proyek.
        </p>

      </div>


      <div class="service-grid">

        <article class="service-card">

          <div class="icon">⚙️</div>

          <h3>
            Rangka Mesin
          </h3>

          <p>
            Struktur utama mesin yang dirancang untuk menopang berbagai
            komponen mekanik dan sistem kerja.
          </p>

        </article>


        <article class="service-card">

          <div class="icon">🔩</div>

          <h3>
            Dudukan Komponen
          </h3>

          <p>
            Pembuatan dudukan untuk motor, gearbox, bearing, panel,
            sensor, dan komponen lainnya.
          </p>

        </article>


        <article class="service-card">

          <div class="icon">📦</div>

          <h3>
            Hopper
          </h3>

          <p>
            Fabrikasi hopper untuk penampungan dan pengumpanan material
            sesuai kebutuhan proses.
          </p>

        </article>


        <article class="service-card">

          <div class="icon">🔧</div>

          <h3>
            Cover & Guard
          </h3>

          <p>
            Pembuatan cover atau pelindung komponen untuk kebutuhan
            konstruksi dan sistem mesin.
          </p>

        </article>


        <article class="service-card">

          <div class="icon">📐</div>

          <h3>
            Struktur Conveyor
          </h3>

          <p>
            Fabrikasi frame conveyor berdasarkan panjang, lebar,
            ketinggian, dan konfigurasi jalur.
          </p>

        </article>


        <article class="service-card">

          <div class="icon">🏭</div>

          <h3>
            Konstruksi Custom
          </h3>

          <p>
            Pembuatan konstruksi dan komponen khusus berdasarkan
            kebutuhan proyek industri.
          </p>

        </article>

      </div>

    </div>
  </section>


  <section class="section">
    <div class="container">

      <div class="section-heading">

        <span class="eyebrow">
          MATERIAL & SPESIFIKASI
        </span>

        <h2>
          Fabrikasi Berdasarkan Kebutuhan Proyek
        </h2>

        <p>
          Pemilihan material dan konstruksi perlu disesuaikan dengan
          fungsi komponen, beban kerja, lingkungan operasional,
          serta kebutuhan mesin.
        </p>

      </div>


      <div class="material-grid">

        <div class="material-card">

          <h3>
            Material Konstruksi
          </h3>

          <p>
            Pemilihan material dapat mempertimbangkan kekuatan,
            ketahanan, berat, lingkungan kerja, dan kebutuhan penggunaan.
          </p>

        </div>


        <div class="material-card">

          <h3>
            Ukuran & Dimensi
          </h3>

          <p>
            Dimensi komponen dibuat berdasarkan desain dan kondisi
            pemasangan agar dapat terintegrasi dengan sistem mesin.
          </p>

        </div>


        <div class="material-card">

          <h3>
            Finishing
          </h3>

          <p>
            Finishing dapat disesuaikan dengan kebutuhan tampilan,
            perlindungan permukaan, maupun kondisi lingkungan kerja.
          </p>

        </div>


        <div class="material-card">

          <h3>
            Kebutuhan Beban
          </h3>

          <p>
            Struktur dan komponen mempertimbangkan beban kerja serta
            fungsi yang akan dijalankan dalam sistem mesin.
          </p>

        </div>

      </div>

    </div>
  </section>


  <section class="section section-light">
    <div class="container">

      <div class="section-heading">

        <span class="eyebrow">
          PROSES FABRIKASI
        </span>

        <h2>
          Tahapan Pengerjaan Fabrikasi Mesin
        </h2>

        <p>
          Proses fabrikasi dilakukan secara bertahap mulai dari
          memahami kebutuhan hingga pemeriksaan hasil pekerjaan.
        </p>

      </div>


      <div class="process-grid">

        <div class="process-card">
          <span>01</span>

          <h3>
            Analisis
          </h3>

          <p>
            Memahami gambar, ukuran, fungsi, material, dan kebutuhan proyek.
          </p>
        </div>


        <div class="process-card">
          <span>02</span>

          <h3>
            Persiapan
          </h3>

          <p>
            Menyiapkan material dan kebutuhan pengerjaan sesuai spesifikasi.
          </p>
        </div>


        <div class="process-card">
          <span>03</span>

          <h3>
            Fabrikasi
          </h3>

          <p>
            Pemotongan, pembentukan, pengelasan, dan pengerjaan komponen.
          </p>
        </div>


        <div class="process-card">
          <span>04</span>

          <h3>
            Assembly
          </h3>

          <p>
            Perakitan komponen sesuai desain atau konfigurasi mesin.
          </p>
        </div>


        <div class="process-card">
          <span>05</span>

          <h3>
            Pemeriksaan
          </h3>

          <p>
            Pemeriksaan ukuran, konstruksi, dan fungsi sebelum digunakan.
          </p>
        </div>

      </div>

    </div>
  </section>


  <section class="section">
    <div class="container">

      <div class="two-column">

        <div>

          <span class="eyebrow">
            KEBUTUHAN DATA
          </span>

          <h2>
            Informasi yang Membantu Proses Fabrikasi
          </h2>

          <p>
            Informasi awal yang lengkap membantu menentukan metode
            pengerjaan dan spesifikasi komponen yang sesuai.
          </p>

        </div>


        <div class="info-list">

          <div>
            <span>01</span>

            <p>
              Gambar teknik atau sketsa komponen jika tersedia.
            </p>
          </div>


          <div>
            <span>02</span>

            <p>
              Ukuran dan dimensi komponen yang dibutuhkan.
            </p>
          </div>


          <div>
            <span>03</span>

            <p>
              Jenis material dan kebutuhan konstruksi.
            </p>
          </div>


          <div>
            <span>04</span>

            <p>
              Fungsi komponen dalam sistem mesin.
            </p>
          </div>


          <div>
            <span>05</span>

            <p>
              Jumlah unit dan kebutuhan produksi.
            </p>
          </div>

        </div>

      </div>

    </div>
  </section>


  <section class="section section-light">
    <div class="container">

      <div class="section-heading">

        <span class="eyebrow">
          LAYANAN TERKAIT
        </span>

        <h2>
          Layanan Mesin Custom Lainnya
        </h2>

      </div>


      <div class="related-grid">

        <a href={`${base}jasa/mesin-custom/`}>
          <strong>
            Jasa Pembuatan Mesin Custom
          </strong>

          <span>
            Pembuatan mesin berdasarkan kebutuhan proses dan spesifikasi.
          </span>
        </a>


        <a href={`${base}jasa/otomatisasi-industri/`}>
          <strong>
            Otomatisasi Industri
          </strong>

          <span>
            Solusi otomatisasi untuk meningkatkan efisiensi proses produksi.
          </span>
        </a>


        <a href={`${base}jasa/mesin-produksi-custom/`}>
          <strong>
            Mesin Produksi Custom
          </strong>

          <span>
            Mesin yang dirancang untuk kebutuhan proses produksi tertentu.
          </span>
        </a>


        <a href={`${base}jasa/pembuatan-conveyor/`}>
          <strong>
            Pembuatan Conveyor
          </strong>

          <span>
            Conveyor custom untuk pemindahan produk dan material.
          </span>
        </a>


        <a href={`${base}jasa/mesin-packaging/`}>
          <strong>
            Mesin Packaging
          </strong>

          <span>
            Mesin untuk kebutuhan pengemasan produk dan integrasi packaging.
          </span>
        </a>


        <a href={`${base}portfolio/`}>
          <strong>
            Portfolio
          </strong>

          <span>
            Lihat contoh proyek dan konsep mesin custom.
          </span>
        </a>

      </div>

    </div>
  </section>


  <section class="cta-section">
    <div class="container">

      <span class="eyebrow">
        KONSULTASI FABRIKASI
      </span>

      <h2>
        Memiliki Kebutuhan Fabrikasi Mesin?
      </h2>

      <p>
        Sampaikan gambar, ukuran, material, jumlah, atau kebutuhan
        komponen yang ingin dibuat untuk pembahasan lebih lanjut.
      </p>

      <a
        href={`${base}kontak/`}
        class="btn btn-light"
      >
        Konsultasikan Proyek
      </a>

    </div>
  </section>

</BaseLayout>


<style>
  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }

  .hero {
    padding: 100px 0;
    background:
      linear-gradient(
        135deg,
        #f0fdfa 0%,
        #ffffff 55%,
        #f8fafc 100%
      );
  }

  .eyebrow {
    display: inline-block;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  .hero h1 {
    max-width: 900px;
    margin: 15px 0 20px;
    color: #0f172a;
    font-size: clamp(36px, 5vw, 58px);
    line-height: 1.08;
  }

  .hero p {
    max-width: 780px;
    color: #475569;
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 22px;
    border-radius: 9px;
    text-decoration: none;
    font-weight: 700;
    transition: 0.2s ease;
  }

  .btn-primary {
    background: #0f766e;
    color: #ffffff;
  }

  .btn-primary:hover {
    background: #115e59;
  }

  .btn-secondary {
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
  }

  .btn-secondary:hover {
    border-color: #0f766e;
    color: #0f766e;
  }

  .section {
    padding: 90px 0;
  }

  .section-light {
    background: #f8fafc;
  }

  .section-heading {
    max-width: 800px;
    margin-bottom: 45px;
  }

  .section-heading h2 {
    margin: 10px 0 16px;
    color: #0f172a;
    font-size: clamp(30px, 4vw, 42px);
    line-height: 1.2;
  }

  .section-heading p {
    color: #64748b;
    line-height: 1.8;
  }

  .two-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: start;
  }

  .two-column h2 {
    margin: 10px 0 18px;
    color: #0f172a;
    font-size: clamp(30px, 4vw, 42px);
    line-height: 1.2;
  }

  .two-column > div > p {
    color: #64748b;
    line-height: 1.8;
  }

  .feature-box {
    display: grid;
    gap: 16px;
  }

  .feature {
    padding: 22px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    background: #ffffff;
  }

  .feature strong {
    display: block;
    margin-bottom: 8px;
    color: #0f172a;
  }

  .feature span {
    color: #64748b;
    line-height: 1.7;
    font-size: 14px;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .service-card {
    padding: 30px;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: #ffffff;
  }

  .icon {
    margin-bottom: 18px;
    font-size: 30px;
  }

  .service-card h3 {
    margin: 0 0 12px;
    color: #0f172a;
    font-size: 20px;
  }

  .service-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.7;
    font-size: 14px;
  }

  .material-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .material-card {
    padding: 28px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
  }

  .material-card h3 {
    margin: 0 0 10px;
    color: #0f172a;
  }

  .material-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.7;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
  }

  .process-card {
    padding: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
  }

  .process-card span {
    display: inline-flex;
    margin-bottom: 18px;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
  }

  .process-card h3 {
    margin: 0 0 10px;
    color: #0f172a;
  }

  .process-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.6;
    font-size: 14px;
  }

  .info-list {
    display: grid;
    gap: 14px;
  }

  .info-list div {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 18px 20px;
    border-radius: 10px;
    background: #f8fafc;
  }

  .info-list span {
    flex: 0 0 auto;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
  }

  .info-list p {
    margin: 0;
    color: #475569;
    line-height: 1.6;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .related-grid a {
    display: block;
    padding: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
    text-decoration: none;
  }

  .related-grid a:hover {
    border-color: #0f766e;
  }

  .related-grid strong {
    display: block;
    margin-bottom: 8px;
    color: #0f172a;
  }

  .related-grid span {
    color: #64748b;
    line-height: 1.6;
    font-size: 14px;
  }

  .cta-section {
    padding: 90px 0;
    background: #0f766e;
    text-align: center;
  }

  .cta-section .eyebrow {
    color: #ccfbf1;
  }

  .cta-section h2 {
    margin: 12px 0 16px;
    color: #ffffff;
    font-size: clamp(30px, 4vw, 44px);
  }

  .cta-section p {
    max-width: 720px;
    margin: 0 auto 30px;
    color: #d1fae5;
    line-height: 1.8;
  }

  .btn-light {
    background: #ffffff;
    color: #0f766e;
  }

  .btn-light:hover {
    background: #f0fdfa;
  }

  @media (max-width: 900px) {
    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .two-column {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 70px 0;
    }

    .section {
      padding: 65px 0;
    }

    .service-grid,
    .material-grid,
    .process-grid,
    .related-grid {
      grid-template-columns: 1fr;
    }

    .hero-actions {
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }
  }
</style>
