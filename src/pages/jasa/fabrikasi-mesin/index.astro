---
import BaseLayout from "../../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Jasa Fabrikasi Mesin Custom untuk Industri"
  description="Jasa fabrikasi mesin custom untuk pembuatan rangka, komponen, sistem mekanik, conveyor, mesin produksi, dan kebutuhan fabrikasi industri lainnya."
>

  <section class="hero">
    <div class="container">

      <span class="eyebrow">
        JASA FABRIKASI MESIN
      </span>

      <h1>
        Jasa Fabrikasi Mesin Custom untuk Kebutuhan Industri
      </h1>

      <p>
        Pembuatan dan fabrikasi komponen mesin berdasarkan
        kebutuhan fungsi, ukuran, material, konstruksi,
        dan kondisi operasional.
      </p>

      <div class="hero-actions">

        <a
          href="https://wa.me/6281234567890?text=Halo%2C%20saya%20ingin%20konsultasi%20tentang%20jasa%20fabrikasi%20mesin."
          class="btn-primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          Konsultasi WhatsApp
        </a>

        <a
          href="/jasa/"
          class="btn-secondary"
        >
          Lihat Semua Jasa
        </a>

      </div>

    </div>
  </section>


  <section class="content-section">
    <div class="container">

      <div class="intro">

        <span class="eyebrow">
          FABRIKASI INDUSTRI
        </span>

        <h2>
          Fabrikasi Mesin Sesuai Spesifikasi
        </h2>

        <p>
          Fabrikasi merupakan salah satu bagian penting dalam
          proses pembuatan mesin custom. Proses ini mencakup
          pembuatan berbagai komponen, rangka, dudukan, struktur,
          dan bagian mekanik yang diperlukan untuk membangun
          sebuah mesin.
        </p>

        <p>
          Spesifikasi fabrikasi dapat disesuaikan dengan desain
          mesin, ukuran komponen, jenis material, beban kerja,
          serta kebutuhan proses produksi. Dengan perencanaan
          yang tepat, setiap bagian mesin dapat dibuat agar
          mendukung fungsi yang telah dirancang.
        </p>

      </div>


      <div class="feature-grid">

        <article class="feature-card">

          <div class="number">
            01
          </div>

          <h3>
            Rangka Mesin
          </h3>

          <p>
            Pembuatan rangka mesin berdasarkan ukuran,
            bentuk, beban, dan kebutuhan penempatan
            komponen.
          </p>

        </article>


        <article class="feature-card">

          <div class="number">
            02
          </div>

          <h3>
            Komponen Mekanik
          </h3>

          <p>
            Fabrikasi berbagai komponen mekanik yang
            diperlukan untuk mendukung sistem kerja mesin.
          </p>

        </article>


        <article class="feature-card">

          <div class="number">
            03
          </div>

          <h3>
            Struktur Conveyor
          </h3>

          <p>
            Pembuatan frame, dudukan, support,
            dan struktur conveyor sesuai kebutuhan.
          </p>

        </article>


        <article class="feature-card">

          <div class="number">
            04
          </div>

          <h3>
            Hopper & Chute
          </h3>

          <p>
            Pembuatan hopper, chute, corong,
            dan komponen penyalur material.
          </p>

        </article>


        <article class="feature-card">

          <div class="number">
            05
          </div>

          <h3>
            Tangki & Wadah
          </h3>

          <p>
            Fabrikasi tangki, wadah, bak proses,
            dan komponen penampung sesuai kebutuhan.
          </p>

        </article>


        <article class="feature-card">

          <div class="number">
            06
          </div>

          <h3>
            Konstruksi Khusus
          </h3>

          <p>
            Pembuatan konstruksi dan komponen khusus
            berdasarkan desain atau kebutuhan proyek.
          </p>

        </article>

      </div>

    </div>
  </section>


  <section class="material-section">
    <div class="container material-grid">

      <div>

        <span class="eyebrow">
          MATERIAL
        </span>

        <h2>
          Pemilihan Material Berdasarkan Kebutuhan
        </h2>

        <p>
          Material yang digunakan dalam fabrikasi dapat
          disesuaikan dengan fungsi komponen, lingkungan kerja,
          beban, kebutuhan kebersihan, serta karakteristik
          material yang diproses.
        </p>

      </div>


      <div class="material-list">

        <div>
          <strong>Stainless Steel</strong>
          <span>
            Untuk kebutuhan tertentu yang memerlukan
            permukaan dan karakteristik material khusus.
          </span>
        </div>

        <div>
          <strong>Baja Karbon</strong>
          <span>
            Digunakan pada berbagai konstruksi dan
            komponen mesin sesuai kebutuhan.
          </span>
        </div>

        <div>
          <strong>Besi</strong>
          <span>
            Dapat digunakan untuk berbagai rangka,
            dudukan, dan konstruksi mesin.
          </span>
        </div>

        <div>
          <strong>Material Khusus</strong>
          <span>
            Material lain dapat dipertimbangkan sesuai
            spesifikasi dan kebutuhan proyek.
          </span>
        </div>

      </div>

    </div>
  </section>


  <section class="process-section">
    <div class="container">

      <div class="section-heading">

        <span class="eyebrow">
          PROSES FABRIKASI
        </span>

        <h2>
          Tahapan Pengerjaan
        </h2>

      </div>


      <div class="process-grid">

        <div class="process-item">

          <span>01</span>

          <h3>
            Analisis Kebutuhan
          </h3>

          <p>
            Memahami fungsi, ukuran, beban,
            material, dan kondisi penggunaan.
          </p>

        </div>


        <div class="process-item">

          <span>02</span>

          <h3>
            Persiapan Material
          </h3>

          <p>
            Menentukan material dan kebutuhan
            komponen berdasarkan spesifikasi.
          </p>

        </div>


        <div class="process-item">

          <span>03</span>

          <h3>
            Proses Fabrikasi
          </h3>

          <p>
            Pemotongan, pembentukan, pengelasan,
            pengerjaan komponen, dan perakitan.
          </p>

        </div>


        <div class="process-item">

          <span>04</span>

          <h3>
            Pemeriksaan
          </h3>

          <p>
            Pemeriksaan hasil fabrikasi dan
            penyesuaian terhadap kebutuhan desain.
          </p>

        </div>

      </div>

    </div>
  </section>


  <section class="cta-section">
    <div class="container">

      <div class="cta-box">

        <div>

          <span class="eyebrow">
            FABRIKASI MESIN CUSTOM
          </span>

          <h2>
            Butuh Komponen atau Konstruksi Mesin?
          </h2>

          <p>
            Konsultasikan kebutuhan fabrikasi berdasarkan
            ukuran, material, fungsi, dan spesifikasi
            komponen yang diperlukan.
          </p>

        </div>

        <a
          href="https://wa.me/6281234567890?text=Halo%2C%20saya%20ingin%20konsultasi%20tentang%20fabrikasi%20mesin."
          class="cta-button"
          target="_blank"
          rel="noopener noreferrer"
        >
          Konsultasi WhatsApp
        </a>

      </div>

    </div>
  </section>

</BaseLayout>


<style>

  .hero {
    padding: 105px 0 85px;
    background:
      linear-gradient(
        135deg,
        #f0fdfa 0%,
        #ffffff 65%
      );
  }

  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 14px;
    color: #0f766e;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  h1 {
    max-width: 850px;
    margin: 0 0 22px;
    color: #0f172a;
    font-size: clamp(38px, 6vw, 62px);
    line-height: 1.08;
  }

  .hero p {
    max-width: 760px;
    margin: 0;
    color: #475569;
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 22px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
  }

  .btn-primary {
    background: #0f766e;
    color: #ffffff;
  }

  .btn-primary:hover {
    background: #115e59;
  }

  .btn-secondary {
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #334155;
  }

  .btn-secondary:hover {
    border-color: #0f766e;
    color: #0f766e;
  }

  .content-section {
    padding: 90px 0;
  }

  .intro {
    max-width: 800px;
    margin-bottom: 50px;
  }

  .intro h2,
  .material-grid h2 {
    margin: 0 0 18px;
    color: #0f172a;
    font-size: 36px;
    line-height: 1.25;
  }

  .intro p,
  .material-grid > div > p {
    margin: 0 0 18px;
    color: #475569;
    line-height: 1.85;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .feature-card {
    padding: 28px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
  }

  .number {
    margin-bottom: 18px;
    color: #0f766e;
    font-size: 26px;
    font-weight: 800;
  }

  .feature-card h3 {
    margin: 0 0 10px;
    color: #0f172a;
    font-size: 19px;
  }

  .feature-card p {
    margin: 0;
    color: #64748b;
    font-size: 14px;
    line-height: 1.7;
  }

  .material-section {
    padding: 90px 0;
    background: #f8fafc;
  }

  .material-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: start;
  }

  .material-list {
    display: grid;
    gap: 14px;
  }

  .material-list > div {
    padding: 22px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
  }

  .material-list strong {
    display: block;
    margin-bottom: 6px;
    color: #0f172a;
  }

  .material-list span {
    display: block;
    color: #64748b;
    font-size: 14px;
    line-height: 1.7;
  }

  .process-section {
    padding: 90px 0;
  }

  .section-heading {
    margin-bottom: 45px;
  }

  .section-heading h2 {
    margin: 0;
    color: #0f172a;
    font-size: 36px;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .process-item {
    padding: 28px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }

  .process-item span {
    display: block;
    margin-bottom: 18px;
    color: #0f766e;
    font-size: 26px;
    font-weight: 800;
  }

  .process-item h3 {
    margin: 0 0 10px;
    color: #0f172a;
    font-size: 18px;
  }

  .process-item p {
    margin: 0;
    color: #64748b;
    font-size: 14px;
    line-height: 1.7;
  }

  .cta-section {
    padding: 0 0 90px;
  }

  .cta-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
    padding: 45px;
    border-radius: 18px;
    background: #0f766e;
  }

  .cta-box .eyebrow {
    color: #ccfbf1;
  }

  .cta-box h2 {
    max-width: 650px;
    margin: 0 0 12px;
    color: #ffffff;
    font-size: 34px;
    line-height: 1.2;
  }

  .cta-box p {
    max-width: 650px;
    margin: 0;
    color: #d1fae5;
    line-height: 1.7;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 14px 22px;
    border-radius: 8px;
    background: #ffffff;
    color: #0f766e;
    text-decoration: none;
    font-weight: 800;
  }

  .cta-button:hover {
    background: #f0fdfa;
  }

  @media (max-width: 900px) {

    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .material-grid {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cta-box {
      flex-direction: column;
      align-items: flex-start;
    }

  }

  @media (max-width: 600px) {

    .hero {
      padding: 80px 0 65px;
    }

    .content-section,
    .material-section,
    .process-section {
      padding: 65px 0;
    }

    .feature-grid,
    .process-grid {
      grid-template-columns: 1fr;
    }

    .intro h2,
    .material-grid h2,
    .section-heading h2 {
      font-size: 30px;
    }

    .cta-section {
      padding-bottom: 65px;
    }

    .cta-box {
      padding: 30px 24px;
    }

    .cta-box h2 {
      font-size: 28px;
    }

  }

</style>
