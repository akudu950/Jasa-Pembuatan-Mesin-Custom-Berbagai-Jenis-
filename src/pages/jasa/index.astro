---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { services } from "../../data/site";
---

<BaseLayout
  title="Jasa Pembuatan Mesin Custom untuk Kebutuhan Industri"
  description="Jasa pembuatan mesin custom, fabrikasi mesin, otomatisasi industri, mesin produksi custom, conveyor, dan mesin packaging untuk berbagai kebutuhan industri."
>

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-inner">

      <span class="eyebrow">
        JASA PEMBUATAN MESIN
      </span>

      <h1>
        Jasa Pembuatan Mesin Custom untuk Kebutuhan Industri
      </h1>

      <p>
        Solusi pembuatan mesin custom yang dirancang berdasarkan
        kebutuhan proses produksi, kapasitas, material, layout,
        dan sistem kerja di lapangan.
      </p>

      <div class="hero-actions">
        <a href="/kontak/" class="btn btn-primary">
          Konsultasikan Kebutuhan
        </a>

        <a href="/mesin/" class="btn btn-secondary">
          Lihat Katalog Mesin
        </a>
      </div>

    </div>
  </section>


  <!-- INTRO -->
  <section class="section">
    <div class="container intro-grid">

      <div>
        <span class="section-label">
          SOLUSI MESIN CUSTOM
        </span>

        <h2>
          Mesin Dirancang Berdasarkan Kebutuhan Produksi
        </h2>

        <p>
          Setiap proses produksi memiliki karakteristik yang berbeda.
          Karena itu, kebutuhan mesin tidak selalu dapat dipenuhi
          menggunakan mesin standar yang tersedia di pasaran.
        </p>

        <p>
          Pembuatan mesin custom memungkinkan desain dan sistem kerja
          disesuaikan dengan produk, kapasitas produksi, material,
          ukuran area, serta tahapan proses yang ingin dioptimalkan.
        </p>

        <p>
          Pendekatan tersebut dapat diterapkan untuk berbagai bidang,
          mulai dari industri makanan dan minuman, manufaktur,
          packaging, pertanian, pengolahan material, hingga
          otomatisasi proses produksi.
        </p>
      </div>

      <div class="intro-card">
        <div class="intro-icon">⚙</div>

        <h3>
          Dari Konsep hingga Mesin Siap Digunakan
        </h3>

        <p>
          Proses dapat mencakup konsultasi kebutuhan, perancangan,
          fabrikasi, perakitan, pengujian, hingga penyesuaian
          mesin berdasarkan kebutuhan aplikasi.
        </p>
      </div>

    </div>
  </section>


  <!-- SERVICES -->
  <section class="section section-soft">
    <div class="container">

      <div class="section-heading">
        <span class="section-label">
          LAYANAN
        </span>

        <h2>
          Layanan Pembuatan Mesin Custom
        </h2>

        <p>
          Pilih jenis layanan yang sesuai dengan kebutuhan
          produksi dan sistem industri Anda.
        </p>
      </div>

      <div class="service-grid">

        {services.map((service) => (
          <article class="service-card">

            <div class="service-number">
              {String(services.indexOf(service) + 1).padStart(2, "0")}
            </div>

            <h3>
              {service.title}
            </h3>

            <p>
              Solusi {service.title.toLowerCase()} yang dapat
              disesuaikan dengan kebutuhan proses dan aplikasi.
            </p>

            <a href={`/jasa/${service.slug}/`}>
              Lihat Detail →
            </a>

          </article>
        ))}

      </div>

    </div>
  </section>


  <!-- PROCESS -->
  <section class="section">
    <div class="container">

      <div class="section-heading">
        <span class="section-label">
          PROSES KERJA
        </span>

        <h2>
          Tahapan Pembuatan Mesin
        </h2>

        <p>
          Setiap proyek dapat dimulai dari pembahasan kebutuhan
          hingga mesin siap digunakan.
        </p>
      </div>

      <div class="process-grid">

        <div class="process-card">
          <span>01</span>

          <h3>Konsultasi</h3>

          <p>
            Membahas kebutuhan mesin, produk, kapasitas,
            material, dan proses produksi.
          </p>
        </div>

        <div class="process-card">
          <span>02</span>

          <h3>Perancangan</h3>

          <p>
            Menentukan konsep, dimensi, sistem kerja,
            komponen, dan kebutuhan teknis.
          </p>
        </div>

        <div class="process-card">
          <span>03</span>

          <h3>Fabrikasi</h3>

          <p>
            Proses pembuatan rangka, komponen mekanik,
            sistem penggerak, dan bagian mesin lainnya.
          </p>
        </div>

        <div class="process-card">
          <span>04</span>

          <h3>Assembly & Testing</h3>

          <p>
            Perakitan dan pengujian dilakukan untuk memastikan
            mesin bekerja sesuai rancangan.
          </p>
        </div>

      </div>

    </div>
  </section>


  <!-- BENEFITS -->
  <section class="section section-soft">
    <div class="container">

      <div class="section-heading">
        <span class="section-label">
          KEUNGGULAN
        </span>

        <h2>
          Mengapa Memilih Mesin Custom?
        </h2>
      </div>

      <div class="benefit-grid">

        <div class="benefit-card">
          <h3>Sesuai Proses</h3>

          <p>
            Sistem mesin dapat dirancang mengikuti tahapan
            produksi yang sudah berjalan.
          </p>
        </div>

        <div class="benefit-card">
          <h3>Sesuai Kapasitas</h3>

          <p>
            Kapasitas mesin dapat disesuaikan dengan target
            produksi yang dibutuhkan.
          </p>
        </div>

        <div class="benefit-card">
          <h3>Sesuai Layout</h3>

          <p>
            Dimensi dan konfigurasi mesin dapat mempertimbangkan
            kondisi area produksi.
          </p>
        </div>

        <div class="benefit-card">
          <h3>Dapat Diintegrasikan</h3>

          <p>
            Mesin dapat dikembangkan bersama conveyor,
            packaging, filling, sensor, dan sistem otomatisasi.
          </p>
        </div>

      </div>

    </div>
  </section>


  <!-- CTA -->
  <section class="cta">
    <div class="container cta-inner">

      <div>
        <span class="section-label">
          KONSULTASI
        </span>

        <h2>
          Punya Kebutuhan Mesin Khusus?
        </h2>

        <p>
          Sampaikan kebutuhan proses produksi, kapasitas,
          material, ukuran area, dan fungsi mesin yang diinginkan.
        </p>
      </div>

      <a
        href="https://wa.me/6281234567890?text=Halo%2C%20saya%20ingin%20konsultasi%20tentang%20pembuatan%20mesin%20custom."
        class="btn btn-primary"
        target="_blank"
        rel="noopener noreferrer"
      >
        Konsultasi via WhatsApp
      </a>

    </div>
  </section>

</BaseLayout>


<style>
  .hero {
    padding: 100px 0;
    background: linear-gradient(
      135deg,
      #f8fafc,
      #ecfeff
    );
  }

  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }

  .hero-inner {
    max-width: 900px;
  }

  .eyebrow,
  .section-label {
    display: inline-block;
    margin-bottom: 14px;
    color: #0f766e;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  h1 {
    margin: 0 0 22px;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1.08;
    letter-spacing: -1.5px;
    color: #0f172a;
  }

  .hero p {
    max-width: 780px;
    margin: 0;
    color: #475569;
    font-size: 19px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 22px;
    border-radius: 9px;
    text-decoration: none;
    font-weight: 700;
  }

  .btn-primary {
    background: #0f766e;
    color: #ffffff;
  }

  .btn-primary:hover {
    background: #115e59;
  }

  .btn-secondary {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
  }

  .section {
    padding: 85px 0;
  }

  .section-soft {
    background: #f8fafc;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: 60px;
    align-items: start;
  }

  h2 {
    margin: 0 0 20px;
    color: #0f172a;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.15;
  }

  .intro-grid p {
    color: #475569;
    line-height: 1.8;
  }

  .intro-card {
    padding: 35px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    box-shadow: 0 15px 40px rgba(15, 23, 42, 0.06);
  }

  .intro-icon {
    margin-bottom: 20px;
    font-size: 46px;
  }

  .intro-card h3 {
    margin: 0 0 12px;
    font-size: 22px;
  }

  .intro-card p {
    margin: 0;
    color: #64748b;
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 45px;
  }

  .section-heading p {
    margin: 0;
    color: #64748b;
    font-size: 17px;
    line-height: 1.8;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .service-card {
    padding: 30px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 15px;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
  }

  .service-number {
    margin-bottom: 18px;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
  }

  .service-card h3 {
    margin: 0 0 12px;
    font-size: 20px;
  }

  .service-card p {
    margin: 0 0 20px;
    color: #64748b;
    line-height: 1.7;
  }

  .service-card a {
    color: #0f766e;
    text-decoration: none;
    font-weight: 700;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .process-card {
    padding: 28px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }

  .process-card span {
    display: inline-block;
    margin-bottom: 18px;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
  }

  .process-card h3 {
    margin: 0 0 10px;
  }

  .process-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.7;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .benefit-card {
    padding: 26px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }

  .benefit-card h3 {
    margin: 0 0 10px;
    font-size: 18px;
  }

  .benefit-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.7;
  }

  .cta {
    padding: 75px 0;
    background: #0f172a;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .cta h2 {
    margin-bottom: 15px;
    color: #ffffff;
  }

  .cta p {
    max-width: 700px;
    margin: 0;
    color: #cbd5e1;
    line-height: 1.8;
  }

  .cta .section-label {
    color: #5eead4;
  }

  @media (max-width: 950px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }

    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .process-grid,
    .benefit-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 650px) {
    .hero {
      padding: 70px 0;
    }

    .section {
      padding: 65px 0;
    }

    .service-grid,
    .process-grid,
    .benefit-grid {
      grid-template-columns: 1fr;
    }

    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
