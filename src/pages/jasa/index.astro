---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { services } from "../../data/site";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Jasa Pembuatan Mesin Custom untuk Kebutuhan Industri"
  description="Jasa pembuatan mesin custom, fabrikasi mesin, mesin produksi custom, otomatisasi industri, conveyor, dan mesin packaging sesuai kebutuhan industri."
>

  <!-- HERO -->
  <section class="hero">
    <div class="container">

      <span class="eyebrow">
        JASA PEMBUATAN MESIN
      </span>

      <h1>
        Jasa Pembuatan Mesin Custom untuk Kebutuhan Industri
      </h1>

      <p class="hero-description">
        Solusi pembuatan mesin custom yang dirancang berdasarkan
        kebutuhan proses produksi, kapasitas, fungsi, material,
        dimensi, dan kondisi operasional.
      </p>

      <div class="hero-actions">

        <a
          href={`${base}kontak/`}
          class="button button-primary"
        >
          Konsultasikan Kebutuhan
        </a>

        <a
          href={`${base}portfolio/`}
          class="button button-secondary"
        >
          Lihat Portfolio
        </a>

      </div>

    </div>
  </section>


  <!-- INTRO -->
  <section class="section">

    <div class="container intro-grid">

      <div>

        <span class="section-label">
          MESIN CUSTOM INDUSTRI
        </span>

        <h2>
          Mesin Dirancang Berdasarkan Kebutuhan Proses
        </h2>

      </div>

      <div>

        <p>
          Setiap proses produksi memiliki kebutuhan yang berbeda.
          Mesin standar terkadang belum dapat menyesuaikan ukuran
          produk, kapasitas produksi, metode kerja, maupun kondisi
          ruang yang tersedia.
        </p>

        <p>
          Jasa pembuatan mesin custom menjadi solusi untuk kebutuhan
          tersebut dengan merancang mesin berdasarkan fungsi dan
          proses kerja yang ingin dicapai.
        </p>

        <p>
          Konsep mesin dapat disesuaikan mulai dari konstruksi,
          mekanisme kerja, sistem penggerak, kapasitas, hingga
          kebutuhan otomatisasi.
        </p>

      </div>

    </div>

  </section>


  <!-- SERVICES -->
  <section class="section section-light">

    <div class="container">

      <div class="section-heading">

        <div>

          <span class="section-label">
            LAYANAN UTAMA
          </span>

          <h2>
            Solusi Mesin untuk Berbagai Kebutuhan
          </h2>

        </div>

      </div>


      <div class="service-grid">

        {services.map((service) => (

          <article class="service-card">

            <div class="service-number">
              ⚙
            </div>

            <h3>
              {service.title}
            </h3>

            <p>
              Solusi pembuatan mesin yang disesuaikan dengan
              kebutuhan fungsi dan proses produksi.
            </p>

            <a href={`${base}jasa/${service.slug}/`}>
              Pelajari Layanan →
            </a>

          </article>

        ))}

      </div>

    </div>

  </section>


  <!-- JENIS KEBUTUHAN -->
  <section class="section">

    <div class="container">

      <div class="section-heading">

        <div>

          <span class="section-label">
            KEBUTUHAN INDUSTRI
          </span>

          <h2>
            Berbagai Jenis Mesin Custom
          </h2>

        </div>

      </div>


      <div class="needs-grid">

        <div class="need-card">

          <h3>
            Mesin Produksi Custom
          </h3>

          <p>
            Mesin untuk membantu proses produksi dengan kapasitas
            dan metode kerja yang disesuaikan.
          </p>

          <a href={`${base}jasa/mesin-produksi-custom/`}>
            Lihat Detail →
          </a>

        </div>


        <div class="need-card">

          <h3>
            Mesin Makanan & Minuman
          </h3>

          <p>
            Solusi mesin untuk proses pengolahan, produksi,
            filling, dan kebutuhan industri makanan serta minuman.
          </p>

          <a href={`${base}mesin/makanan-minuman/`}>
            Lihat Kategori →
          </a>

        </div>


        <div class="need-card">

          <h3>
            Mesin Packaging
          </h3>

          <p>
            Mesin pengemasan custom untuk mendukung proses
            packaging berbagai jenis produk.
          </p>

          <a href={`${base}jasa/mesin-packaging/`}>
            Lihat Detail →
          </a>

        </div>


        <div class="need-card">

          <h3>
            Conveyor Custom
          </h3>

          <p>
            Conveyor yang dapat dirancang berdasarkan layout,
            kapasitas, material, dan kebutuhan pemindahan produk.
          </p>

          <a href={`${base}jasa/pembuatan-conveyor/`}>
            Lihat Detail →
          </a>

        </div>


        <div class="need-card">

          <h3>
            Mesin Pertanian & Agro
          </h3>

          <p>
            Mesin untuk membantu pengolahan hasil pertanian dan
            berbagai kebutuhan agroindustri.
          </p>

          <a href={`${base}mesin/pertanian-agro/`}>
            Lihat Kategori →
          </a>

        </div>


        <div class="need-card">

          <h3>
            Mesin Pengolahan Limbah
          </h3>

          <p>
            Solusi mesin untuk kebutuhan pengolahan dan
            pemrosesan berbagai jenis limbah.
          </p>

          <a href={`${base}mesin/pengolahan-limbah/`}>
            Lihat Kategori →
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- PROCESS -->
  <section class="section section-dark">

    <div class="container">

      <div class="section-heading">

        <div>

          <span class="section-label">
            PROSES PEMBUATAN
          </span>

          <h2>
            Tahapan Pembuatan Mesin Custom
          </h2>

        </div>

      </div>


      <div class="process-grid">

        <div class="process-card">

          <span>01</span>

          <h3>
            Konsultasi
          </h3>

          <p>
            Memahami kebutuhan fungsi mesin, kapasitas, produk,
            proses kerja, dan kondisi penggunaan.
          </p>

        </div>


        <div class="process-card">

          <span>02</span>

          <h3>
            Konsep & Perancangan
          </h3>

          <p>
            Menentukan konsep mesin, mekanisme kerja, dimensi,
            komponen, dan sistem pendukung.
          </p>

        </div>


        <div class="process-card">

          <span>03</span>

          <h3>
            Fabrikasi & Assembly
          </h3>

          <p>
            Pembuatan komponen, rangka, sistem mekanik, serta
            proses perakitan mesin.
          </p>

        </div>


        <div class="process-card">

          <span>04</span>

          <h3>
            Testing
          </h3>

          <p>
            Pengujian fungsi mesin untuk memastikan sistem dapat
            bekerja sesuai konsep yang dirancang.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- BENEFITS -->
  <section class="section">

    <div class="container">

      <div class="section-heading">

        <div>

          <span class="section-label">
            KEUNGGULAN
          </span>

          <h2>
            Keuntungan Menggunakan Mesin Custom
          </h2>

        </div>

      </div>


      <div class="benefit-grid">

        <div class="benefit-card">

          <h3>
            Sesuai Kebutuhan
          </h3>

          <p>
            Mesin dirancang berdasarkan fungsi dan kebutuhan
            proses yang ingin dicapai.
          </p>

        </div>


        <div class="benefit-card">

          <h3>
            Fleksibel
          </h3>

          <p>
            Dimensi, kapasitas, material, dan mekanisme dapat
            disesuaikan dengan kondisi penggunaan.
          </p>

        </div>


        <div class="benefit-card">

          <h3>
            Mendukung Efisiensi
          </h3>

          <p>
            Mesin dapat membantu mengurangi pekerjaan manual
            dan meningkatkan konsistensi proses.
          </p>

        </div>


        <div class="benefit-card">

          <h3>
            Dapat Dikembangkan
          </h3>

          <p>
            Konsep mesin dapat dikembangkan untuk kebutuhan
            otomatisasi dan peningkatan kapasitas.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- CTA -->
  <section class="cta">

    <div class="container cta-inner">

      <div>

        <span class="section-label">
          KONSULTASI
        </span>

        <h2>
          Membutuhkan Mesin dengan Spesifikasi Khusus?
        </h2>

        <p>
          Sampaikan kebutuhan proses, kapasitas produksi,
          jenis produk, atau fungsi mesin yang dibutuhkan.
        </p>

      </div>

      <a
        href={`${base}kontak/`}
        class="button button-primary"
      >
        Konsultasikan Sekarang
      </a>

    </div>

  </section>

</BaseLayout>


<style>
  .hero {
    padding: 100px 0;
    background:
      linear-gradient(
        135deg,
        #f8fafc 0%,
        #ecfeff 100%
      );
  }

  .eyebrow,
  .section-label {
    display: inline-block;
    margin-bottom: 14px;
    color: #0f766e;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 900px;
    margin: 0;
    color: #0f172a;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1.08;
    letter-spacing: -2px;
  }

  .hero-description {
    max-width: 780px;
    margin: 25px 0 0;
    color: #475569;
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 22px;
    border-radius: 9px;
    text-decoration: none;
    font-weight: 700;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: #0f766e;
    color: #ffffff;
  }

  .button-secondary {
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
  }

  .section {
    padding: 90px 0;
  }

  .section-light {
    background: #f8fafc;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 70px;
  }

  .intro-grid h2,
  .section-heading h2 {
    margin: 0;
    color: #0f172a;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.15;
    letter-spacing: -1px;
  }

  .intro-grid p {
    margin-top: 0;
    margin-bottom: 20px;
    color: #475569;
    font-size: 17px;
    line-height: 1.85;
  }

  .section-heading {
    margin-bottom: 40px;
  }

  .service-grid,
  .needs-grid,
  .benefit-grid,
  .process-grid {
    display: grid;
    gap: 24px;
  }

  .service-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .needs-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .benefit-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .process-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .service-card,
  .need-card,
  .benefit-card {
    padding: 30px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
  }

  .service-card {
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 35px rgba(15, 23, 42, 0.08);
  }

  .service-number {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    border-radius: 12px;
    background: #ccfbf1;
    font-size: 23px;
  }

  .service-card h3,
  .need-card h3,
  .benefit-card h3 {
    margin: 0 0 12px;
    color: #0f172a;
    font-size: 19px;
    line-height: 1.4;
  }

  .service-card p,
  .need-card p,
  .benefit-card p {
    color: #64748b;
    line-height: 1.75;
  }

  .service-card a,
  .need-card a {
    color: #0f766e;
    font-weight: 700;
    text-decoration: none;
  }

  .section-dark {
    background: #0f172a;
  }

  .section-dark .section-heading h2 {
    color: #ffffff;
  }

  .process-card {
    padding: 28px;
    border: 1px solid #334155;
    border-radius: 14px;
    background: #172033;
  }

  .process-card > span {
    display: block;
    margin-bottom: 18px;
    color: #2dd4bf;
    font-size: 13px;
    font-weight: 800;
  }

  .process-card h3 {
    margin: 0 0 12px;
    color: #ffffff;
    font-size: 19px;
  }

  .process-card p {
    margin: 0;
    color: #cbd5e1;
    line-height: 1.75;
  }

  .cta {
    padding: 80px 0;
    background: #ecfeff;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
  }

  .cta h2 {
    max-width: 750px;
    margin: 0;
    color: #0f172a;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.15;
  }

  .cta p {
    max-width: 700px;
    margin: 18px 0 0;
    color: #475569;
    line-height: 1.8;
  }

  @media (max-width: 1000px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .service-grid,
    .needs-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .benefit-grid,
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cta-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 650px) {
    .hero {
      padding: 70px 0;
    }

    .section {
      padding: 65px 0;
    }

    .service-grid,
    .needs-grid,
    .benefit-grid,
    .process-grid {
      grid-template-columns: 1fr;
    }

    .hero-actions {
      flex-direction: column;
    }

    .button {
      width: 100%;
    }
  }
</style>
