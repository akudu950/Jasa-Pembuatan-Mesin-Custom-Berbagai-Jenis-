---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Jasa Pembuatan Mesin Packaging Custom untuk Industri"
  description="Jasa pembuatan mesin packaging custom untuk kebutuhan industri, filling, sealing, counting, labeling, pengemasan produk, dan integrasi lini produksi."
>

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">

      <div class="hero-content">

        <span class="eyebrow">
          MESIN PACKAGING CUSTOM
        </span>

        <h1>
          Jasa Pembuatan Mesin Packaging Custom untuk Kebutuhan Industri
        </h1>

        <p class="hero-description">
          Perancangan dan pembuatan mesin packaging sesuai jenis produk,
          ukuran kemasan, kapasitas produksi, metode pengemasan,
          serta kebutuhan integrasi dengan proses produksi lainnya.
        </p>

        <div class="hero-actions">

          <a
            href={`https://wa.me/6281234567890?text=${encodeURIComponent(
              "Halo, saya ingin konsultasi tentang pembuatan mesin packaging custom."
            )}`}
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            Konsultasi Mesin
          </a>

          <a
            href={`${base}mesin/packaging/`}
            class="btn btn-secondary"
          >
            Lihat Mesin Packaging
          </a>

        </div>

      </div>


      <div class="hero-card">

        <div class="hero-icon">
          ▣
        </div>

        <h2>
          Sistem Packaging Sesuai Produk
        </h2>

        <p>
          Mesin packaging dapat dikembangkan berdasarkan bentuk produk,
          jenis kemasan, kapasitas, metode pengisian, proses sealing,
          hingga kebutuhan otomatisasi.
        </p>

      </div>

    </div>
  </section>


  <!-- INTRO -->
  <section class="section">

    <div class="container narrow">

      <span class="section-label">
        SOLUSI PENGEMASAN
      </span>

      <h2>
        Apa Itu Mesin Packaging Custom?
      </h2>

      <p>
        Mesin packaging custom merupakan mesin pengemasan yang
        dirancang berdasarkan kebutuhan produk dan proses produksi
        tertentu. Desain mesin dapat disesuaikan dengan jenis produk,
        ukuran kemasan, metode pengisian, dan kapasitas produksi.
      </p>

      <p>
        Kebutuhan setiap industri dapat berbeda. Produk berbentuk
        cair, bubuk, butiran, padat, maupun produk dengan bentuk
        tertentu dapat membutuhkan metode pengemasan yang berbeda.
      </p>

      <p>
        Karena itu, mesin packaging dapat dirancang sebagai mesin
        tunggal maupun sebagai bagian dari lini produksi yang
        terintegrasi dengan filling, conveyor, sealing, labeling,
        counting, dan sistem otomatisasi lainnya.
      </p>

    </div>

  </section>


  <!-- TYPES -->
  <section class="section section-light">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          JENIS MESIN
        </span>

        <h2>
          Jenis Mesin Packaging yang Dapat Dikembangkan
        </h2>

        <p>
          Sistem pengemasan dapat disesuaikan dengan karakteristik
          produk, jenis kemasan, dan kebutuhan proses produksi.
        </p>

      </div>


      <div class="card-grid">

        <article class="info-card">

          <div class="card-number">
            01
          </div>

          <h3>
            Mesin Filling
          </h3>

          <p>
            Sistem pengisian produk ke dalam kemasan dengan
            kapasitas dan metode kerja yang disesuaikan.
          </p>

        </article>


        <article class="info-card">

          <div class="card-number">
            02
          </div>

          <h3>
            Mesin Sealing
          </h3>

          <p>
            Mesin untuk membantu proses penutupan atau penyegelan
            kemasan sesuai jenis material kemasan.
          </p>

        </article>


        <article class="info-card">

          <div class="card-number">
            03
          </div>

          <h3>
            Mesin Counting
          </h3>

          <p>
            Sistem penghitung produk untuk membantu proses
            pengemasan berdasarkan jumlah tertentu.
          </p>

        </article>


        <article class="info-card">

          <div class="card-number">
            04
          </div>

          <h3>
            Mesin Labeling
          </h3>

          <p>
            Sistem untuk membantu proses pemasangan label
            pada kemasan secara lebih teratur.
          </p>

        </article>


        <article class="info-card">

          <div class="card-number">
            05
          </div>

          <h3>
            Conveyor Packaging
          </h3>

          <p>
            Conveyor untuk membantu memindahkan produk
            antarproses dalam sistem pengemasan.
          </p>

        </article>


        <article class="info-card">

          <div class="card-number">
            06
          </div>

          <h3>
            Packaging Line Custom
          </h3>

          <p>
            Integrasi beberapa proses packaging menjadi
            satu alur kerja sesuai kebutuhan produksi.
          </p>

        </article>

      </div>

    </div>

  </section>


  <!-- APPLICATIONS -->
  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          PENERAPAN
        </span>

        <h2>
          Mesin Packaging untuk Berbagai Jenis Produk
        </h2>

        <p>
          Sistem pengemasan dapat dirancang untuk berbagai
          karakter produk dan kebutuhan industri.
        </p>

      </div>


      <div class="application-grid">

        <div class="application-item">

          <strong>
            Produk Cair
          </strong>

          <span>
            Sistem filling dan packaging untuk berbagai produk
            cair sesuai karakteristik material.
          </span>

        </div>


        <div class="application-item">

          <strong>
            Produk Bubuk
          </strong>

          <span>
            Sistem pengisian dan pengemasan untuk material
            berbentuk bubuk atau serbuk.
          </span>

        </div>


        <div class="application-item">

          <strong>
            Produk Butiran
          </strong>

          <span>
            Sistem counting atau filling untuk produk
            berbentuk butiran dan material sejenis.
          </span>

        </div>


        <div class="application-item">

          <strong>
            Produk Padat
          </strong>

          <span>
            Pengemasan produk padat dengan sistem conveyor
            dan mekanisme packaging yang sesuai.
          </span>

        </div>


        <div class="application-item">

          <strong>
            Makanan & Minuman
          </strong>

          <span>
            Solusi packaging untuk produk makanan,
            minuman, bahan olahan, dan produk konsumsi.
          </span>

        </div>


        <div class="application-item">

          <strong>
            Produk Industri
          </strong>

          <span>
            Sistem pengemasan untuk berbagai produk industri
            dan kebutuhan produksi khusus.
          </span>

        </div>

      </div>

    </div>

  </section>


  <!-- DESIGN FACTORS -->
  <section class="section section-dark">

    <div class="container">

      <div class="section-heading dark">

        <span class="section-label">
          PERANCANGAN
        </span>

        <h2>
          Faktor yang Dipertimbangkan dalam Pembuatan Mesin Packaging
        </h2>

        <p>
          Sistem packaging perlu disesuaikan dengan produk,
          kemasan, kapasitas, dan kebutuhan proses produksi.
        </p>

      </div>


      <div class="benefit-grid">

        <div class="benefit-item">

          <span>01</span>

          <div>

            <h3>
              Jenis Produk
            </h3>

            <p>
              Bentuk, ukuran, berat, tekstur, dan karakter produk
              menjadi pertimbangan dalam menentukan mekanisme mesin.
            </p>

          </div>

        </div>


        <div class="benefit-item">

          <span>02</span>

          <div>

            <h3>
              Jenis Kemasan
            </h3>

            <p>
              Bentuk dan material kemasan memengaruhi metode
              filling, sealing, handling, dan proses packaging.
            </p>

          </div>

        </div>


        <div class="benefit-item">

          <span>03</span>

          <div>

            <h3>
              Kapasitas Produksi
            </h3>

            <p>
              Target produksi menjadi dasar dalam menentukan
              kapasitas dan kecepatan sistem pengemasan.
            </p>

          </div>

        </div>


        <div class="benefit-item">

          <span>04</span>

          <div>

            <h3>
              Tingkat Otomatisasi
            </h3>

            <p>
              Sistem dapat dirancang manual, semi otomatis,
              maupun dikembangkan menjadi bagian dari lini otomatis.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- PROCESS -->
  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          TAHAPAN PEMBUATAN
        </span>

        <h2>
          Proses Pembuatan Mesin Packaging Custom
        </h2>

      </div>


      <div class="process-grid">

        <div class="process-card">

          <span>01</span>

          <h3>
            Konsultasi
          </h3>

          <p>
            Membahas produk, kemasan, kapasitas produksi,
            metode pengemasan, dan kebutuhan sistem.
          </p>

        </div>


        <div class="process-card">

          <span>02</span>

          <h3>
            Perancangan
          </h3>

          <p>
            Menentukan konsep mesin, mekanisme filling,
            sealing, conveyor, dan sistem pendukung.
          </p>

        </div>


        <div class="process-card">

          <span>03</span>

          <h3>
            Fabrikasi & Assembly
          </h3>

          <p>
            Pembuatan komponen mesin kemudian dilanjutkan
            dengan proses perakitan dan penyusunan sistem.
          </p>

        </div>


        <div class="process-card">

          <span>04</span>

          <h3>
            Testing
          </h3>

          <p>
            Pengujian dilakukan menggunakan kondisi proses
            yang disesuaikan dengan kebutuhan produksi.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- BENEFITS -->
  <section class="section section-light">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          MANFAAT
        </span>

        <h2>
          Keuntungan Menggunakan Mesin Packaging Custom
        </h2>

      </div>


      <div class="benefit-light-grid">

        <div class="benefit-light">

          <h3>
            Sesuai Produk
          </h3>

          <p>
            Mekanisme mesin dapat disesuaikan dengan bentuk
            dan karakteristik produk yang dikemas.
          </p>

        </div>


        <div class="benefit-light">

          <h3>
            Sesuai Kemasan
          </h3>

          <p>
            Sistem dapat dirancang mengikuti ukuran,
            bentuk, dan jenis material kemasan.
          </p>

        </div>


        <div class="benefit-light">

          <h3>
            Mendukung Kapasitas Produksi
          </h3>

          <p>
            Kapasitas dan kecepatan kerja dapat disesuaikan
            dengan target proses produksi.
          </p>

        </div>


        <div class="benefit-light">

          <h3>
            Dapat Diintegrasikan
          </h3>

          <p>
            Mesin dapat dihubungkan dengan conveyor,
            filling, labeling, dan sistem otomatisasi lainnya.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- RELATED -->
  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          LAYANAN TERKAIT
        </span>

        <h2>
          Layanan Pendukung Mesin Packaging
        </h2>

      </div>


      <div class="related-grid">

        <a
          href={`${base}jasa/mesin-custom/`}
          class="related-card"
        >

          <strong>
            Jasa Pembuatan Mesin Custom
          </strong>

          <span>
            Pembuatan mesin khusus berdasarkan kebutuhan industri.
          </span>

        </a>


        <a
          href={`${base}jasa/mesin-produksi-custom/`}
          class="related-card"
        >

          <strong>
            Mesin Produksi Custom
          </strong>

          <span>
            Mesin produksi yang dirancang sesuai proses kerja.
          </span>

        </a>


        <a
          href={`${base}jasa/pembuatan-conveyor/`}
          class="related-card"
        >

          <strong>
            Pembuatan Conveyor
          </strong>

          <span>
            Conveyor untuk mendukung pemindahan produk dalam proses packaging.
          </span>

        </a>


        <a
          href={`${base}jasa/otomatisasi-industri/`}
          class="related-card"
        >

          <strong>
            Otomatisasi Industri
          </strong>

          <span>
            Integrasi mesin packaging dengan sistem otomatisasi produksi.
          </span>

        </a>

      </div>

    </div>

  </section>


  <!-- CTA -->
  <section class="cta-section">

    <div class="container cta-inner">

      <div>

        <span class="section-label">
          KONSULTASI MESIN PACKAGING
        </span>

        <h2>
          Membutuhkan Mesin Packaging Sesuai Produk Anda?
        </h2>

        <p>
          Sampaikan jenis produk, ukuran kemasan, kapasitas produksi,
          serta proses packaging yang dibutuhkan untuk mendapatkan
          konsep mesin yang lebih sesuai.
        </p>

      </div>


      <a
        href={`https://wa.me/6281234567890?text=${encodeURIComponent(
          "Halo, saya ingin konsultasi tentang pembuatan mesin packaging custom."
        )}`}
        class="btn btn-light"
        target="_blank"
        rel="noopener noreferrer"
      >
        Konsultasi Sekarang
      </a>

    </div>

  </section>

</BaseLayout>


<style>
  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }

  .narrow {
    max-width: 850px;
  }

  .hero {
    padding: 90px 0;
    background:
      linear-gradient(
        135deg,
        #f0fdfa 0%,
        #ffffff 55%,
        #f8fafc 100%
      );
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    align-items: center;
    gap: 70px;
  }

  .eyebrow,
  .section-label {
    display: inline-block;
    margin-bottom: 14px;
    color: #0f766e;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  h1 {
    max-width: 800px;
    margin: 0;
    color: #0f172a;
    font-size: clamp(38px, 5vw, 64px);
    line-height: 1.08;
    letter-spacing: -1.5px;
  }

  .hero-description {
    max-width: 720px;
    margin: 24px 0 0;
    color: #475569;
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 9px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 800;
    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background: #0f766e;
    color: #ffffff;
  }

  .btn-primary:hover {
    background: #115e59;
  }

  .btn-secondary {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
  }

  .hero-card {
    padding: 34px;
    background: #ffffff;
    border: 1px solid #dbeafe;
    border-radius: 18px;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
  }

  .hero-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    margin-bottom: 24px;
    border-radius: 16px;
    background: #ccfbf1;
    color: #0f766e;
    font-size: 30px;
    font-weight: 800;
  }

  .hero-card h2 {
    margin: 0 0 14px;
    color: #0f172a;
    font-size: 24px;
    line-height: 1.3;
  }

  .hero-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.8;
  }

  .section {
    padding: 85px 0;
  }

  .section-light {
    background: #f8fafc;
  }

  .section-dark {
    background: #0f172a;
    color: #cbd5e1;
  }

  .section-heading {
    max-width: 780px;
    margin-bottom: 42px;
  }

  .section-heading h2,
  .narrow h2 {
    margin: 0 0 18px;
    color: #0f172a;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.2;
  }

  .section-heading p,
  .narrow p {
    color: #64748b;
    line-height: 1.8;
  }

  .section-dark .section-heading h2 {
    color: #ffffff;
  }

  .section-dark .section-heading p {
    color: #cbd5e1;
  }

  .section-dark .section-label {
    color: #5eead4;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .info-card {
    padding: 30px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }

  .card-number {
    margin-bottom: 20px;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .info-card h3 {
    margin: 0 0 12px;
    color: #0f172a;
    font-size: 20px;
  }

  .info-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.75;
  }

  .application-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .application-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
  }

  .application-item strong {
    color: #0f172a;
  }

  .application-item span {
    color: #64748b;
    line-height: 1.7;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .benefit-item {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 18px;
    padding: 26px 0;
    border-top: 1px solid #334155;
  }

  .benefit-item > span {
    color: #5eead4;
    font-size: 13px;
    font-weight: 800;
  }

  .benefit-item h3 {
    margin: 0 0 10px;
    color: #ffffff;
    font-size: 19px;
  }

  .benefit-item p {
    margin: 0;
    color: #cbd5e1;
    line-height: 1.75;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .process-card {
    padding: 28px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }

  .process-card > span {
    color: #0f766e;
    font-weight: 800;
    font-size: 13px;
  }

  .process-card h3 {
    margin: 18px 0 10px;
    color: #0f172a;
    font-size: 19px;
  }

  .process-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.7;
  }

  .benefit-light-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .benefit-light {
    padding: 28px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }

  .benefit-light h3 {
    margin: 0 0 10px;
    color: #0f172a;
    font-size: 19px;
  }

  .benefit-light p {
    margin: 0;
    color: #64748b;
    line-height: 1.75;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .related-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(15, 23, 42, 0.08);
  }

  .related-card strong {
    color: #0f172a;
  }

  .related-card span {
    color: #64748b;
    font-size: 14px;
    line-height: 1.6;
  }

  .cta-section {
    padding: 70px 0;
    background: #0f766e;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .cta-inner h2 {
    max-width: 750px;
    margin: 0 0 14px;
    color: #ffffff;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.2;
  }

  .cta-inner p {
    max-width: 720px;
    margin: 0;
    color: #ccfbf1;
    line-height: 1.8;
  }

  .cta-inner .section-label {
    color: #99f6e4;
  }

  .btn-light {
    flex-shrink: 0;
    background: #ffffff;
    color: #0f766e;
  }

  @media (max-width: 1000px) {

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .process-grid,
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }

  }

  @media (max-width: 700px) {

    .hero {
      padding: 65px 0;
    }

    .section {
      padding: 65px 0;
    }

    .card-grid,
    .application-grid,
    .benefit-grid,
    .benefit-light-grid,
    .process-grid,
    .related-grid {
      grid-template-columns: 1fr;
    }

    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero-description {
      font-size: 16px;
    }

  }
</style>
