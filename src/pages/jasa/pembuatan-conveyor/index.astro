---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Jasa Pembuatan Conveyor Custom untuk Kebutuhan Industri"
  description="Jasa pembuatan conveyor custom untuk kebutuhan industri, produksi, manufaktur, makanan dan minuman, packaging, pergudangan, dan pemindahan material."
>

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">

      <div class="hero-content">

        <span class="eyebrow">
          CONVEYOR CUSTOM
        </span>

        <h1>
          Jasa Pembuatan Conveyor Custom untuk Kebutuhan Industri
        </h1>

        <p class="hero-description">
          Perancangan dan pembuatan conveyor sesuai kebutuhan
          pemindahan produk dan material, mulai dari dimensi,
          kapasitas, jalur conveyor, hingga kebutuhan integrasi
          dengan mesin produksi.
        </p>

        <div class="hero-actions">

          <a
            href={`https://wa.me/6281234567890?text=${encodeURIComponent(
              "Halo, saya ingin konsultasi tentang pembuatan conveyor custom."
            )}`}
            class="btn btn-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            Konsultasi Conveyor
          </a>

          <a
            href={`${base}mesin/conveyor/`}
            class="btn btn-secondary"
          >
            Lihat Conveyor
          </a>

        </div>

      </div>


      <div class="hero-card">

        <div class="hero-icon">
          ⇢
        </div>

        <h2>
          Conveyor Sesuai Alur Produksi
        </h2>

        <p>
          Conveyor dapat dibuat berdasarkan arah perpindahan,
          panjang jalur, jenis material, kapasitas, elevasi,
          dan kebutuhan integrasi dengan mesin lainnya.
        </p>

      </div>

    </div>
  </section>


  <!-- INTRO -->
  <section class="section">

    <div class="container narrow">

      <span class="section-label">
        SOLUSI PEMINDAHAN MATERIAL
      </span>

      <h2>
        Apa Itu Conveyor Custom?
      </h2>

      <p>
        Conveyor custom merupakan sistem pemindahan material atau
        produk yang dirancang berdasarkan kebutuhan tertentu.
        Ukuran, panjang, lebar belt, kapasitas, kecepatan,
        serta konfigurasi jalurnya dapat disesuaikan.
      </p>

      <p>
        Dalam proses produksi, conveyor sering digunakan untuk
        menghubungkan satu tahapan kerja dengan tahapan lainnya.
        Penggunaan conveyor dapat membantu mengurangi pemindahan
        material secara manual dan membuat alur produksi menjadi
        lebih teratur.
      </p>

      <p>
        Conveyor juga dapat dikembangkan sebagai bagian dari
        sistem otomatisasi industri dan diintegrasikan dengan
        mesin produksi, filling, packaging, sortasi, maupun
        proses lainnya.
      </p>

    </div>

  </section>


  <!-- TYPES -->
  <section class="section section-light">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          JENIS CONVEYOR
        </span>

        <h2>
          Jenis Conveyor yang Dapat Dikembangkan
        </h2>

        <p>
          Jenis conveyor dipilih berdasarkan karakter material,
          kapasitas, jalur perpindahan, dan kondisi proses produksi.
        </p>

      </div>


      <div class="card-grid">

        <article class="info-card">

          <div class="card-number">
            01
          </div>

          <h3>
            Belt Conveyor
          </h3>

          <p>
            Conveyor menggunakan belt sebagai media pemindahan
            berbagai jenis produk dan material.
          </p>

        </article>


        <article class="info-card">

          <div class="card-number">
            02
          </div>

          <h3>
            Roller Conveyor
          </h3>

          <p>
            Conveyor menggunakan roller untuk membantu memindahkan
            produk dengan bentuk dan karakteristik tertentu.
          </p>

        </article>


        <article class="info-card">

          <div class="card-number">
            03
          </div>

          <h3>
            Conveyor Produksi
          </h3>

          <p>
            Sistem conveyor untuk mendukung perpindahan produk
            antarproses dalam jalur produksi.
          </p>

        </article>


        <article class="info-card">

          <div class="card-number">
            04
          </div>

          <h3>
            Conveyor Packaging
          </h3>

          <p>
            Conveyor yang digunakan untuk membantu proses filling,
            sealing, packaging, counting, dan pengemasan.
          </p>

        </article>


        <article class="info-card">

          <div class="card-number">
            05
          </div>

          <h3>
            Conveyor Transfer
          </h3>

          <p>
            Sistem pemindahan produk atau material dari satu titik
            ke titik lainnya dalam proses produksi.
          </p>

        </article>


        <article class="info-card">

          <div class="card-number">
            06
          </div>

          <h3>
            Conveyor Custom
          </h3>

          <p>
            Conveyor dengan bentuk dan konfigurasi khusus untuk
            kebutuhan ruang, proses, atau material tertentu.
          </p>

        </article>

      </div>

    </div>

  </section>


  <!-- APPLICATIONS -->
  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          PENERAPAN
        </span>

        <h2>
          Conveyor untuk Berbagai Kebutuhan Industri
        </h2>

        <p>
          Conveyor dapat digunakan untuk berbagai proses
          pemindahan produk dan material di lingkungan industri.
        </p>

      </div>


      <div class="application-grid">

        <div class="application-item">

          <strong>
            Industri Makanan & Minuman
          </strong>

          <span>
            Pemindahan bahan, produk, kemasan, dan hasil produksi
            antarproses.
          </span>

        </div>


        <div class="application-item">

          <strong>
            Industri Manufaktur
          </strong>

          <span>
            Pemindahan komponen, material, produk setengah jadi,
            dan produk jadi.
          </span>

        </div>


        <div class="application-item">

          <strong>
            Packaging
          </strong>

          <span>
            Menghubungkan proses filling, sealing, labeling,
            counting, dan pengemasan.
          </span>

        </div>


        <div class="application-item">

          <strong>
            Gudang & Material Handling
          </strong>

          <span>
            Membantu pemindahan barang dan material pada jalur
            kerja tertentu.
          </span>

        </div>


        <div class="application-item">

          <strong>
            Pertanian & Agro
          </strong>

          <span>
            Pemindahan hasil panen, bahan baku, produk olahan,
            dan material pertanian.
          </span>

        </div>


        <div class="application-item">

          <strong>
            Pengolahan Limbah
          </strong>

          <span>
            Pemindahan material pada proses pemilahan,
            pencacahan, dan pengolahan limbah.
          </span>

        </div>

      </div>

    </div>

  </section>


  <!-- DESIGN FACTORS -->
  <section class="section section-dark">

    <div class="container">

      <div class="section-heading dark">

        <span class="section-label">
          PERANCANGAN
        </span>

        <h2>
          Faktor yang Dipertimbangkan dalam Pembuatan Conveyor
        </h2>

        <p>
          Conveyor perlu dirancang berdasarkan kondisi material
          dan kebutuhan jalur perpindahan agar dapat bekerja
          sesuai fungsi yang diharapkan.
        </p>

      </div>


      <div class="benefit-grid">

        <div class="benefit-item">

          <span>01</span>

          <div>

            <h3>
              Jenis Material
            </h3>

            <p>
              Karakteristik produk atau material memengaruhi
              pemilihan belt, roller, dan mekanisme conveyor.
            </p>

          </div>

        </div>


        <div class="benefit-item">

          <span>02</span>

          <div>

            <h3>
              Kapasitas
            </h3>

            <p>
              Kapasitas perpindahan menjadi pertimbangan dalam
              menentukan ukuran dan sistem penggerak conveyor.
            </p>

          </div>

        </div>


        <div class="benefit-item">

          <span>03</span>

          <div>

            <h3>
              Panjang & Dimensi
            </h3>

            <p>
              Panjang, lebar, tinggi, dan konfigurasi conveyor
              disesuaikan dengan area dan jalur produksi.
            </p>

          </div>

        </div>


        <div class="benefit-item">

          <span>04</span>

          <div>

            <h3>
              Kecepatan
            </h3>

            <p>
              Kecepatan perpindahan disesuaikan dengan kebutuhan
              proses dan karakteristik produk.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- PROCESS -->
  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          TAHAPAN PEMBUATAN
        </span>

        <h2>
          Proses Pembuatan Conveyor Custom
        </h2>

      </div>


      <div class="process-grid">

        <div class="process-card">

          <span>01</span>

          <h3>
            Konsultasi
          </h3>

          <p>
            Membahas kebutuhan jalur, material, kapasitas,
            dimensi, dan posisi conveyor.
          </p>

        </div>


        <div class="process-card">

          <span>02</span>

          <h3>
            Perancangan
          </h3>

          <p>
            Menentukan desain rangka, media conveyor,
            sistem penggerak, dan konfigurasi jalur.
          </p>

        </div>


        <div class="process-card">

          <span>03</span>

          <h3>
            Fabrikasi
          </h3>

          <p>
            Pembuatan rangka dan komponen conveyor berdasarkan
            rancangan yang telah ditentukan.
          </p>

        </div>


        <div class="process-card">

          <span>04</span>

          <h3>
            Assembly & Testing
          </h3>

          <p>
            Perakitan dan pengujian untuk memastikan conveyor
            dapat berjalan sesuai kebutuhan.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- BENEFITS -->
  <section class="section section-light">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          MANFAAT
        </span>

        <h2>
          Keuntungan Menggunakan Conveyor Custom
        </h2>

      </div>


      <div class="benefit-light-grid">

        <div class="benefit-light">

          <h3>
            Sesuai Ruang Produksi
          </h3>

          <p>
            Dimensi dan konfigurasi conveyor dapat disesuaikan
            dengan area pemasangan yang tersedia.
          </p>

        </div>


        <div class="benefit-light">

          <h3>
            Mendukung Alur Produksi
          </h3>

          <p>
            Conveyor dapat dirancang untuk menghubungkan
            beberapa tahapan proses produksi.
          </p>

        </div>


        <div class="benefit-light">

          <h3>
            Mengurangi Pemindahan Manual
          </h3>

          <p>
            Pemindahan produk atau material dapat dilakukan
            melalui jalur conveyor yang telah dirancang.
          </p>

        </div>


        <div class="benefit-light">

          <h3>
            Dapat Diintegrasikan
          </h3>

          <p>
            Conveyor dapat dikembangkan sebagai bagian dari
            sistem otomatisasi dan mesin produksi.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- RELATED -->
  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          LAYANAN TERKAIT
        </span>

        <h2>
          Layanan yang Berkaitan dengan Conveyor
        </h2>

      </div>


      <div class="related-grid">

        <a
          href={`${base}jasa/mesin-custom/`}
          class="related-card"
        >

          <strong>
            Jasa Pembuatan Mesin Custom
          </strong>

          <span>
            Pembuatan mesin khusus sesuai kebutuhan industri.
          </span>

        </a>


        <a
          href={`${base}jasa/mesin-produksi-custom/`}
          class="related-card"
        >

          <strong>
            Mesin Produksi Custom
          </strong>

          <span>
            Mesin produksi yang dirancang berdasarkan proses kerja.
          </span>

        </a>


        <a
          href={`${base}jasa/otomatisasi-industri/`}
          class="related-card"
        >

          <strong>
            Otomatisasi Industri
          </strong>

          <span>
            Integrasi conveyor dengan sistem otomatisasi produksi.
          </span>

        </a>


        <a
          href={`${base}jasa/mesin-packaging/`}
          class="related-card"
        >

          <strong>
            Mesin Packaging
          </strong>

          <span>
            Solusi pengemasan yang dapat diintegrasikan dengan conveyor.
          </span>

        </a>

      </div>

    </div>

  </section>


  <!-- CTA -->
  <section class="cta-section">

    <div class="container cta-inner">

      <div>

        <span class="section-label">
          KONSULTASI CONVEYOR
        </span>

        <h2>
          Membutuhkan Conveyor Sesuai Kebutuhan Produksi?
        </h2>

        <p>
          Sampaikan jenis material, kapasitas, ukuran,
          panjang jalur, dan kebutuhan proses untuk
          mendapatkan konsep conveyor yang sesuai.
        </p>

      </div>


      <a
        href={`https://wa.me/6281234567890?text=${encodeURIComponent(
          "Halo, saya ingin konsultasi tentang pembuatan conveyor custom."
        )}`}
        class="btn btn-light"
        target="_blank"
        rel="noopener noreferrer"
      >
        Konsultasi Sekarang
      </a>

    </div>

  </section>

</BaseLayout>


<style>
  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }

  .narrow {
    max-width: 850px;
  }

  .hero {
    padding: 90px 0;
    background:
      linear-gradient(
        135deg,
        #f0fdfa 0%,
        #ffffff 55%,
        #f8fafc 100%
      );
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    align-items: center;
    gap: 70px;
  }

  .eyebrow,
  .section-label {
    display: inline-block;
    margin-bottom: 14px;
    color: #0f766e;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  h1 {
    max-width: 800px;
    margin: 0;
    color: #0f172a;
    font-size: clamp(38px, 5vw, 64px);
    line-height: 1.08;
    letter-spacing: -1.5px;
  }

  .hero-description {
    max-width: 720px;
    margin: 24px 0 0;
    color: #475569;
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 9px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 800;
    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background: #0f766e;
    color: #ffffff;
  }

  .btn-primary:hover {
    background: #115e59;
  }

  .btn-secondary {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
  }

  .hero-card {
    padding: 34px;
    background: #ffffff;
    border: 1px solid #dbeafe;
    border-radius: 18px;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
  }

  .hero-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    margin-bottom: 24px;
    border-radius: 16px;
    background: #ccfbf1;
    color: #0f766e;
    font-size: 32px;
    font-weight: 800;
  }

  .hero-card h2 {
    margin: 0 0 14px;
    color: #0f172a;
    font-size: 24px;
    line-height: 1.3;
  }

  .hero-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.8;
  }

  .section {
    padding: 85px 0;
  }

  .section-light {
    background: #f8fafc;
  }

  .section-dark {
    background: #0f172a;
    color: #cbd5e1;
  }

  .section-heading {
    max-width: 780px;
    margin-bottom: 42px;
  }

  .section-heading h2,
  .narrow h2 {
    margin: 0 0 18px;
    color: #0f172a;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.2;
  }

  .section-heading p,
  .narrow p {
    color: #64748b;
    line-height: 1.8;
  }

  .section-dark .section-heading h2 {
    color: #ffffff;
  }

  .section-dark .section-heading p {
    color: #cbd5e1;
  }

  .section-dark .section-label {
    color: #5eead4;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .info-card {
    padding: 30px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }

  .card-number {
    margin-bottom: 20px;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .info-card h3 {
    margin: 0 0 12px;
    color: #0f172a;
    font-size: 20px;
  }

  .info-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.75;
  }

  .application-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .application-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
  }

  .application-item strong {
    color: #0f172a;
  }

  .application-item span {
    color: #64748b;
    line-height: 1.7;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .benefit-item {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 18px;
    padding: 26px 0;
    border-top: 1px solid #334155;
  }

  .benefit-item > span {
    color: #5eead4;
    font-size: 13px;
    font-weight: 800;
  }

  .benefit-item h3 {
    margin: 0 0 10px;
    color: #ffffff;
    font-size: 19px;
  }

  .benefit-item p {
    margin: 0;
    color: #cbd5e1;
    line-height: 1.75;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .process-card {
    padding: 28px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }

  .process-card > span {
    color: #0f766e;
    font-weight: 800;
    font-size: 13px;
  }

  .process-card h3 {
    margin: 18px 0 10px;
    color: #0f172a;
    font-size: 19px;
  }

  .process-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.7;
  }

  .benefit-light-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .benefit-light {
    padding: 28px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }

  .benefit-light h3 {
    margin: 0 0 10px;
    color: #0f172a;
    font-size: 19px;
  }

  .benefit-light p {
    margin: 0;
    color: #64748b;
    line-height: 1.75;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .related-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(15, 23, 42, 0.08);
  }

  .related-card strong {
    color: #0f172a;
  }

  .related-card span {
    color: #64748b;
    font-size: 14px;
    line-height: 1.6;
  }

  .cta-section {
    padding: 70px 0;
    background: #0f766e;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .cta-inner h2 {
    max-width: 750px;
    margin: 0 0 14px;
    color: #ffffff;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.2;
  }

  .cta-inner p {
    max-width: 720px;
    margin: 0;
    color: #ccfbf1;
    line-height: 1.8;
  }

  .cta-inner .section-label {
    color: #99f6e4;
  }

  .btn-light {
    flex-shrink: 0;
    background: #ffffff;
    color: #0f766e;
  }

  @media (max-width: 1000px) {

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .process-grid,
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }

  }

  @media (max-width: 700px) {

    .hero {
      padding: 65px 0;
    }

    .section {
      padding: 65px 0;
    }

    .card-grid,
    .application-grid,
    .benefit-grid,
    .benefit-light-grid,
    .process-grid,
    .related-grid {
      grid-template-columns: 1fr;
    }

    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero-description {
      font-size: 16px;
    }

  }
</style>
