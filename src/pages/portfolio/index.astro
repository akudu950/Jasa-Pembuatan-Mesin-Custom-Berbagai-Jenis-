---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Portfolio Pembuatan Mesin Custom"
  description="Portfolio pembuatan mesin custom untuk berbagai kebutuhan industri, produksi, manufaktur, makanan dan minuman, pertanian, packaging, conveyor, dan otomatisasi."
>

  <section class="hero">
    <div class="container">

      <span class="eyebrow">
        PORTFOLIO MESIN CUSTOM
      </span>

      <h1>
        Portfolio Pembuatan Mesin Custom
      </h1>

      <p>
        Dokumentasi dan contoh proyek pembuatan mesin custom
        untuk berbagai kebutuhan industri dan proses produksi.
      </p>

      <div class="hero-actions">
        <a href="/kontak/" class="btn-primary">
          Konsultasi Proyek
        </a>

        <a href="/mesin/" class="btn-secondary">
          Lihat Katalog Mesin
        </a>
      </div>

    </div>
  </section>


  <section class="portfolio-section">
    <div class="container">

      <div class="section-heading">
        <span class="eyebrow">
          PROYEK MESIN
        </span>

        <h2>
          Contoh Pembuatan Mesin Custom
        </h2>

        <p>
          Setiap mesin dapat dirancang berdasarkan kebutuhan proses,
          kapasitas produksi, jenis material, ukuran produk, dan
          sistem kerja yang diperlukan.
        </p>
      </div>


      <div class="portfolio-grid">

        <article class="portfolio-card">

          <div class="portfolio-image">
            MESIN PRODUKSI
          </div>

          <div class="portfolio-content">

            <span class="category">
              Mesin Produksi
            </span>

            <h3>
              Mesin Produksi Custom
            </h3>

            <p>
              Mesin produksi yang dirancang untuk membantu meningkatkan
              efisiensi proses dan menyesuaikan kebutuhan lini produksi.
            </p>

          </div>

        </article>


        <article class="portfolio-card">

          <div class="portfolio-image">
            MESIN MAKANAN
          </div>

          <div class="portfolio-content">

            <span class="category">
              Makanan & Minuman
            </span>

            <h3>
              Mesin Pengolahan Makanan
            </h3>

            <p>
              Solusi mesin custom untuk proses pengolahan,
              pencampuran, pengisian, pemindahan, hingga pengemasan
              produk makanan dan minuman.
            </p>

          </div>

        </article>


        <article class="portfolio-card">

          <div class="portfolio-image">
            CONVEYOR
          </div>

          <div class="portfolio-content">

            <span class="category">
              Material Handling
            </span>

            <h3>
              Conveyor Custom
            </h3>

            <p>
              Conveyor dirancang sesuai kebutuhan pemindahan material
              atau produk pada area produksi dan proses industri.
            </p>

          </div>

        </article>


        <article class="portfolio-card">

          <div class="portfolio-image">
            MESIN PACKAGING
          </div>

          <div class="portfolio-content">

            <span class="category">
              Packaging
            </span>

            <h3>
              Mesin Packaging Custom
            </h3>

            <p>
              Mesin packaging untuk membantu proses pengisian,
              sealing, packing, labeling, dan kebutuhan pengemasan
              lainnya.
            </p>

          </div>

        </article>


        <article class="portfolio-card">

          <div class="portfolio-image">
            MESIN PERTANIAN
          </div>

          <div class="portfolio-content">

            <span class="category">
              Pertanian & Agro
            </span>

            <h3>
              Mesin Pengolahan Hasil Pertanian
            </h3>

            <p>
              Mesin custom untuk membantu proses pengolahan,
              sortasi, pencucian, pengeringan, hingga pengemasan
              hasil pertanian.
            </p>

          </div>

        </article>


        <article class="portfolio-card">

          <div class="portfolio-image">
            MESIN KHUSUS
          </div>

          <div class="portfolio-content">

            <span class="category">
              Special Purpose Machine
            </span>

            <h3>
              Mesin Khusus Sesuai Kebutuhan
            </h3>

            <p>
              Mesin khusus yang dirancang berdasarkan kebutuhan
              proses kerja, target kapasitas, ukuran produk,
              dan kondisi operasional.
            </p>

          </div>

        </article>

      </div>

    </div>
  </section>


  <section class="process-section">
    <div class="container">

      <div class="section-heading">

        <span class="eyebrow">
          PROSES PENGERJAAN
        </span>

        <h2>
          Dari Kebutuhan Menjadi Mesin Siap Digunakan
        </h2>

        <p>
          Pembuatan mesin custom dimulai dari memahami kebutuhan
          hingga menghasilkan mesin yang sesuai dengan fungsi
          dan proses kerja yang direncanakan.
        </p>

      </div>


      <div class="process-grid">

        <div class="process-item">
          <span>01</span>
          <h3>Konsultasi</h3>
          <p>
            Membahas kebutuhan mesin, proses produksi,
            kapasitas, dan fungsi yang diperlukan.
          </p>
        </div>

        <div class="process-item">
          <span>02</span>
          <h3>Perancangan</h3>
          <p>
            Menentukan konsep, ukuran, komponen,
            sistem kerja, dan spesifikasi mesin.
          </p>
        </div>

        <div class="process-item">
          <span>03</span>
          <h3>Fabrikasi</h3>
          <p>
            Proses pembuatan rangka, komponen,
            sistem mekanik, dan bagian mesin lainnya.
          </p>
        </div>

        <div class="process-item">
          <span>04</span>
          <h3>Finishing & Testing</h3>
          <p>
            Pemeriksaan dan pengujian dilakukan sebelum
            mesin digunakan sesuai kebutuhan.
          </p>
        </div>

      </div>

    </div>
  </section>


  <section class="cta-section">
    <div class="container">

      <div class="cta-box">

        <div>
          <span class="eyebrow">
            PUNYA KEBUTUHAN MESIN?
          </span>

          <h2>
            Konsultasikan Mesin Custom yang Anda Butuhkan
          </h2>

          <p>
            Sampaikan kebutuhan proses, kapasitas, ukuran,
            atau fungsi mesin yang ingin dibuat.
          </p>
        </div>

        <a
          href="https://wa.me/6281234567890?text=Halo%2C%20saya%20ingin%20konsultasi%20tentang%20pembuatan%20mesin%20custom."
          class="btn-primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          Konsultasi via WhatsApp
        </a>

      </div>

    </div>
  </section>

</BaseLayout>


<style>

  .hero {
    padding: 110px 0 90px;
    background:
      linear-gradient(
        135deg,
        #f0fdfa 0%,
        #ffffff 60%
      );
  }

  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 14px;
    color: #0f766e;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  h1 {
    max-width: 800px;
    margin: 0 0 22px;
    color: #0f172a;
    font-size: clamp(38px, 6vw, 64px);
    line-height: 1.08;
  }

  .hero p {
    max-width: 720px;
    margin: 0;
    color: #475569;
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 22px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
  }

  .btn-primary {
    background: #0f766e;
    color: #ffffff;
  }

  .btn-primary:hover {
    background: #115e59;
  }

  .btn-secondary {
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #334155;
  }

  .btn-secondary:hover {
    border-color: #0f766e;
    color: #0f766e;
  }

  .portfolio-section {
    padding: 90px 0;
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 45px;
  }

  .section-heading h2 {
    margin: 0 0 15px;
    color: #0f172a;
    font-size: 36px;
    line-height: 1.2;
  }

  .section-heading p {
    margin: 0;
    color: #64748b;
    line-height: 1.8;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .portfolio-card {
    overflow: hidden;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .portfolio-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 15px 35px rgba(15, 23, 42, 0.08);
  }

  .portfolio-image {
    min-height: 190px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 25px;
    background:
      linear-gradient(
        135deg,
        #e2e8f0,
        #f8fafc
      );
    color: #475569;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .portfolio-content {
    padding: 26px;
  }

  .category {
    color: #0f766e;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  .portfolio-content h3 {
    margin: 10px 0;
    color: #0f172a;
    font-size: 20px;
  }

  .portfolio-content p {
    margin: 0;
    color: #64748b;
    line-height: 1.7;
    font-size: 14px;
  }

  .process-section {
    padding: 90px 0;
    background: #f8fafc;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .process-item {
    padding: 28px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }

  .process-item span {
    display: block;
    margin-bottom: 18px;
    color: #0f766e;
    font-size: 28px;
    font-weight: 800;
  }

  .process-item h3 {
    margin: 0 0 10px;
    color: #0f172a;
    font-size: 18px;
  }

  .process-item p {
    margin: 0;
    color: #64748b;
    line-height: 1.7;
    font-size: 14px;
  }

  .cta-section {
    padding: 90px 0 0;
  }

  .cta-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
    padding: 45px;
    border-radius: 18px;
    background: #0f172a;
  }

  .cta-box h2 {
    max-width: 650px;
    margin: 0 0 12px;
    color: #ffffff;
    font-size: 34px;
    line-height: 1.2;
  }

  .cta-box p {
    max-width: 650px;
    margin: 0;
    color: #cbd5e1;
    line-height: 1.7;
  }

  .cta-box .eyebrow {
    color: #5eead4;
  }

  .cta-box .btn-primary {
    flex-shrink: 0;
    background: #14b8a6;
  }

  .cta-box .btn-primary:hover {
    background: #0d9488;
  }

  @media (max-width: 900px) {

    .portfolio-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cta-box {
      flex-direction: column;
      align-items: flex-start;
    }

  }

  @media (max-width: 600px) {

    .hero {
      padding: 80px 0 65px;
    }

    .portfolio-section,
    .process-section {
      padding: 65px 0;
    }

    .portfolio-grid,
    .process-grid {
      grid-template-columns: 1fr;
    }

    .section-heading h2 {
      font-size: 30px;
    }

    .cta-section {
      padding-top: 65px;
    }

    .cta-box {
      padding: 30px 24px;
    }

    .cta-box h2 {
      font-size: 28px;
    }

  }

</style>
