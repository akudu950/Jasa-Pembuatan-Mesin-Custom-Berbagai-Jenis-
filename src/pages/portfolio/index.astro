---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Portfolio Pembuatan Mesin Custom"
  description="Portfolio pembuatan mesin custom untuk berbagai kebutuhan industri, produksi, manufaktur, makanan dan minuman, packaging, conveyor, pertanian, dan otomatisasi."
>

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-inner">

      <span class="eyebrow">
        PORTFOLIO
      </span>

      <h1>
        Portfolio Pembuatan Mesin Custom
      </h1>

      <p>
        Contoh pengembangan mesin custom dan sistem produksi
        berdasarkan kebutuhan proses, fungsi, kapasitas,
        dan karakteristik industri.
      </p>

      <div class="hero-actions">

        <a
          href={`${base}jasa/mesin-custom/`}
          class="btn btn-primary"
        >
          Konsultasi Mesin Custom
        </a>

        <a
          href={`${base}kontak/`}
          class="btn btn-secondary"
        >
          Hubungi Kami
        </a>

      </div>

    </div>
  </section>


  <!-- INTRO -->
  <section class="section">

    <div class="container narrow">

      <span class="section-label">
        PENGEMBANGAN MESIN
      </span>

      <h2>
        Mesin Custom Dirancang Berdasarkan Kebutuhan
      </h2>

      <p>
        Setiap kebutuhan produksi dapat memiliki karakteristik
        yang berbeda. Karena itu, pembuatan mesin custom perlu
        mempertimbangkan proses kerja, kapasitas, material,
        ukuran produk, ruang pemasangan, dan tingkat otomatisasi.
      </p>

      <p>
        Portfolio berikut merupakan contoh jenis proyek dan
        pengembangan mesin yang dapat menjadi gambaran solusi
        untuk berbagai kebutuhan industri.
      </p>

    </div>

  </section>


  <!-- PORTFOLIO GRID -->
  <section class="section section-light">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          CONTOH PROYEK
        </span>

        <h2>
          Contoh Pembuatan Mesin Custom
        </h2>

        <p>
          Setiap proyek dapat dikembangkan dengan spesifikasi
          yang berbeda sesuai kebutuhan proses produksi.
        </p>

      </div>


      <div class="portfolio-grid">

        <!-- ITEM 01 -->
        <article class="portfolio-card">

          <div class="portfolio-visual">
            <span class="visual-icon">
              ⚙
            </span>

            <span class="visual-label">
              MESIN PRODUKSI
            </span>
          </div>

          <div class="portfolio-content">

            <span class="portfolio-category">
              Produksi
            </span>

            <h3>
              Mesin Produksi Custom
            </h3>

            <p>
              Sistem mesin yang dikembangkan berdasarkan
              alur produksi dan kebutuhan kapasitas tertentu.
            </p>

            <ul>
              <li>Konsep sesuai proses kerja</li>
              <li>Dimensi dapat disesuaikan</li>
              <li>Dapat dikembangkan menjadi otomatis</li>
            </ul>

          </div>

        </article>


        <!-- ITEM 02 -->
        <article class="portfolio-card">

          <div class="portfolio-visual">
            <span class="visual-icon">
              ⇢
            </span>

            <span class="visual-label">
              CONVEYOR
            </span>
          </div>

          <div class="portfolio-content">

            <span class="portfolio-category">
              Material Handling
            </span>

            <h3>
              Conveyor Custom
            </h3>

            <p>
              Sistem conveyor untuk membantu pemindahan produk
              atau material antarproses produksi.
            </p>

            <ul>
              <li>Dimensi sesuai area</li>
              <li>Kapasitas disesuaikan</li>
              <li>Dapat terintegrasi dengan mesin</li>
            </ul>

          </div>

        </article>


        <!-- ITEM 03 -->
        <article class="portfolio-card">

          <div class="portfolio-visual">
            <span class="visual-icon">
              ▣
            </span>

            <span class="visual-label">
              PACKAGING
            </span>
          </div>

          <div class="portfolio-content">

            <span class="portfolio-category">
              Pengemasan
            </span>

            <h3>
              Mesin Packaging
            </h3>

            <p>
              Mesin pengemasan yang dapat dikembangkan untuk
              filling, sealing, counting, dan proses lainnya.
            </p>

            <ul>
              <li>Disesuaikan dengan produk</li>
              <li>Disesuaikan dengan kemasan</li>
              <li>Dapat diintegrasikan dengan conveyor</li>
            </ul>

          </div>

        </article>


        <!-- ITEM 04 -->
        <article class="portfolio-card">

          <div class="portfolio-visual">
            <span class="visual-icon">
              ◉
            </span>

            <span class="visual-label">
              MAKANAN & MINUMAN
            </span>
          </div>

          <div class="portfolio-content">

            <span class="portfolio-category">
              Food & Beverage
            </span>

            <h3>
              Mesin Makanan & Minuman
            </h3>

            <p>
              Pengembangan mesin untuk membantu proses
              pengolahan dan produksi makanan maupun minuman.
            </p>

            <ul>
              <li>Pengolahan bahan</li>
              <li>Mixing dan filling</li>
              <li>Conveyor dan packaging</li>
            </ul>

          </div>

        </article>


        <!-- ITEM 05 -->
        <article class="portfolio-card">

          <div class="portfolio-visual">
            <span class="visual-icon">
              ◫
            </span>

            <span class="visual-label">
              PERTANIAN
            </span>
          </div>

          <div class="portfolio-content">

            <span class="portfolio-category">
              Agro
            </span>

            <h3>
              Mesin Pertanian & Agro
            </h3>

            <p>
              Mesin untuk membantu proses pengolahan hasil
              pertanian, sortasi, pengeringan, dan pemindahan.
            </p>

            <ul>
              <li>Pengolahan hasil panen</li>
              <li>Sortasi dan pemilahan</li>
              <li>Conveyor dan packaging</li>
            </ul>

          </div>

        </article>


        <!-- ITEM 06 -->
        <article class="portfolio-card">

          <div class="portfolio-visual">
            <span class="visual-icon">
              ♻
            </span>

            <span class="visual-label">
              PENGOLAHAN LIMBAH
            </span>
          </div>

          <div class="portfolio-content">

            <span class="portfolio-category">
              Limbah
            </span>

            <h3>
              Mesin Pengolahan Limbah
            </h3>

            <p>
              Sistem mesin untuk membantu proses pencacahan,
              pemilahan, pemindahan, dan pengolahan material.
            </p>

            <ul>
              <li>Pencacahan material</li>
              <li>Pemilahan</li>
              <li>Material handling</li>
            </ul>

          </div>

        </article>

      </div>

    </div>

  </section>


  <!-- PROCESS -->
  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          PROSES PROYEK
        </span>

        <h2>
          Tahapan Pengembangan Mesin
        </h2>

      </div>


      <div class="process-grid">

        <div class="process-card">

          <span>
            01
          </span>

          <h3>
            Konsultasi
          </h3>

          <p>
            Memahami kebutuhan proses, fungsi mesin,
            kapasitas, dan kondisi lokasi.
          </p>

        </div>


        <div class="process-card">

          <span>
            02
          </span>

          <h3>
            Perancangan
          </h3>

          <p>
            Mengembangkan konsep dan desain mesin
            berdasarkan kebutuhan proyek.
          </p>

        </div>


        <div class="process-card">

          <span>
            03
          </span>

          <h3>
            Fabrikasi
          </h3>

          <p>
            Membuat rangka, komponen, dan bagian mesin
            berdasarkan rancangan yang telah ditentukan.
          </p>

        </div>


        <div class="process-card">

          <span>
            04
          </span>

          <h3>
            Testing
          </h3>

          <p>
            Melakukan pengujian fungsi dan proses kerja
            sebelum mesin digunakan.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- WHY CUSTOM -->
  <section class="section section-dark">

    <div class="container">

      <div class="section-heading dark">

        <span class="section-label">
          MESIN CUSTOM
        </span>

        <h2>
          Mengapa Mesin Custom Dibutuhkan?
        </h2>

        <p>
          Mesin custom menjadi pilihan ketika mesin standar
          belum dapat memenuhi kebutuhan proses secara optimal.
        </p>

      </div>


      <div class="benefit-grid">

        <div class="benefit-item">

          <span>
            01
          </span>

          <div>

            <h3>
              Fungsi Khusus
            </h3>

            <p>
              Mesin dapat dirancang untuk menjalankan fungsi
              produksi tertentu yang tidak tersedia pada mesin standar.
            </p>

          </div>

        </div>


        <div class="benefit-item">

          <span>
            02
          </span>

          <div>

            <h3>
              Ukuran Menyesuaikan
            </h3>

            <p>
              Dimensi mesin dapat disesuaikan dengan ruang
              pemasangan dan kebutuhan jalur produksi.
            </p>

          </div>

        </div>


        <div class="benefit-item">

          <span>
            03
          </span>

          <div>

            <h3>
              Kapasitas Sesuai
            </h3>

            <p>
              Kapasitas kerja dapat dirancang berdasarkan
              kebutuhan proses produksi.
            </p>

          </div>

        </div>


        <div class="benefit-item">

          <span>
            04
          </span>

          <div>

            <h3>
              Dapat Diintegrasikan
            </h3>

            <p>
              Mesin custom dapat dikembangkan menjadi bagian
              dari sistem otomatisasi atau lini produksi.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- RELATED -->
  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          LIHAT LAYANAN
        </span>

        <h2>
          Jelajahi Layanan Mesin Custom
        </h2>

      </div>


      <div class="related-grid">

        <a
          href={`${base}jasa/mesin-custom/`}
          class="related-card"
        >
          <strong>
            Jasa Pembuatan Mesin Custom
          </strong>

          <span>
            Solusi mesin khusus untuk kebutuhan industri.
          </span>
        </a>


        <a
          href={`${base}jasa/fabrikasi-mesin/`}
          class="related-card"
        >
          <strong>
            Jasa Fabrikasi Mesin
          </strong>

          <span>
            Pembuatan rangka dan komponen mesin.
          </span>
        </a>


        <a
          href={`${base}jasa/otomatisasi-industri/`}
          class="related-card"
        >
          <strong>
            Otomatisasi Industri
          </strong>

          <span>
            Sistem otomatisasi untuk proses produksi.
          </span>
        </a>


        <a
          href={`${base}mesin/`}
          class="related-card"
        >
          <strong>
            Katalog Mesin
          </strong>

          <span>
            Jelajahi kategori mesin untuk berbagai industri.
          </span>
        </a>

      </div>

    </div>

  </section>


  <!-- CTA -->
  <section class="cta-section">

    <div class="container cta-inner">

      <div>

        <span class="section-label">
          KONSULTASI PROYEK
        </span>

        <h2>
          Punya Kebutuhan Mesin Custom?
        </h2>

        <p>
          Konsultasikan kebutuhan mesin, proses produksi,
          kapasitas, dan fungsi yang ingin dikembangkan.
        </p>

      </div>


      <a
        href={`https://wa.me/6281234567890?text=${encodeURIComponent(
          "Halo, saya ingin konsultasi tentang pembuatan mesin custom."
        )}`}
        class="btn btn-light"
        target="_blank"
        rel="noopener noreferrer"
      >
        Konsultasi Sekarang
      </a>

    </div>

  </section>

</BaseLayout>


<style>
  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }

  .narrow {
    max-width: 850px;
  }

  .hero {
    padding: 90px 0;
    background:
      linear-gradient(
        135deg,
        #f0fdfa 0%,
        #ffffff 55%,
        #f8fafc 100%
      );
  }

  .hero-inner {
    max-width: 900px;
  }

  .eyebrow,
  .section-label {
    display: inline-block;
    margin-bottom: 14px;
    color: #0f766e;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  h1 {
    max-width: 850px;
    margin: 0;
    color: #0f172a;
    font-size: clamp(38px, 5vw, 64px);
    line-height: 1.08;
    letter-spacing: -1.5px;
  }

  .hero p {
    max-width: 760px;
    margin: 24px 0 0;
    color: #475569;
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 9px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 800;
    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background: #0f766e;
    color: #ffffff;
  }

  .btn-primary:hover {
    background: #115e59;
  }

  .btn-secondary {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
  }

  .section {
    padding: 85px 0;
  }

  .section-light {
    background: #f8fafc;
  }

  .section-dark {
    background: #0f172a;
    color: #cbd5e1;
  }

  .section-heading {
    max-width: 780px;
    margin-bottom: 42px;
  }

  .section-heading h2,
  .narrow h2 {
    margin: 0 0 18px;
    color: #0f172a;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.2;
  }

  .section-heading p,
  .narrow p {
    color: #64748b;
    line-height: 1.8;
  }

  .section-dark .section-heading h2 {
    color: #ffffff;
  }

  .section-dark .section-heading p {
    color: #cbd5e1;
  }

  .section-dark .section-label {
    color: #5eead4;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .portfolio-card {
    overflow: hidden;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
  }

  .portfolio-visual {
    min-height: 210px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    background:
      linear-gradient(
        135deg,
        #ccfbf1,
        #e2e8f0
      );
  }

  .visual-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 78px;
    height: 78px;
    border-radius: 18px;
    background: #ffffff;
    color: #0f766e;
    font-size: 36px;
    font-weight: 800;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
  }

  .visual-label {
    color: #334155;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.4px;
  }

  .portfolio-content {
    padding: 28px;
  }

  .portfolio-category {
    color: #0f766e;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  .portfolio-content h3 {
    margin: 10px 0 12px;
    color: #0f172a;
    font-size: 22px;
  }

  .portfolio-content p {
    margin: 0;
    color: #64748b;
    line-height: 1.75;
  }

  .portfolio-content ul {
    display: grid;
    gap: 8px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .portfolio-content li {
    color: #475569;
    font-size: 14px;
  }

  .portfolio-content li::before {
    content: "✓";
    margin-right: 9px;
    color: #0f766e;
    font-weight: 800;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .process-card {
    padding: 28px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }

  .process-card > span {
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
  }

  .process-card h3 {
    margin: 18px 0 10px;
    color: #0f172a;
    font-size: 19px;
  }

  .process-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.7;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .benefit-item {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 18px;
    padding: 26px 0;
    border-top: 1px solid #334155;
  }

  .benefit-item > span {
    color: #5eead4;
    font-size: 13px;
    font-weight: 800;
  }

  .benefit-item h3 {
    margin: 0 0 10px;
    color: #ffffff;
    font-size: 19px;
  }

  .benefit-item p {
    margin: 0;
    color: #cbd5e1;
    line-height: 1.75;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .related-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(15, 23, 42, 0.08);
  }

  .related-card strong {
    color: #0f172a;
  }

  .related-card span {
    color: #64748b;
    font-size: 14px;
    line-height: 1.6;
  }

  .cta-section {
    padding: 70px 0;
    background: #0f766e;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .cta-inner h2 {
    max-width: 750px;
    margin: 0 0 14px;
    color: #ffffff;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.2;
  }

  .cta-inner p {
    max-width: 720px;
    margin: 0;
    color: #ccfbf1;
    line-height: 1.8;
  }

  .cta-inner .section-label {
    color: #99f6e4;
  }

  .btn-light {
    flex-shrink: 0;
    background: #ffffff;
    color: #0f766e;
  }

  @media (max-width: 1000px) {

    .portfolio-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .process-grid,
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }

  }

  @media (max-width: 700px) {

    .hero {
      padding: 65px 0;
    }

    .section {
      padding: 65px 0;
    }

    .portfolio-grid,
    .benefit-grid,
    .process-grid,
    .related-grid {
      grid-template-columns: 1fr;
    }

    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero p {
      font-size: 16px;
    }

  }
</style>
