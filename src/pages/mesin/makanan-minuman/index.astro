---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Mesin Makanan dan Minuman Custom untuk Industri"
  description="Jasa pembuatan mesin makanan dan minuman custom untuk kebutuhan produksi, pengolahan, filling, packaging, dan otomatisasi industri."
>

  <!-- HERO -->
  <section class="hero">
    <div class="container">

      <span class="eyebrow">
        MESIN MAKANAN & MINUMAN
      </span>

      <h1>
        Mesin Makanan dan Minuman Custom untuk Kebutuhan Produksi
      </h1>

      <p class="hero-description">
        Pembuatan mesin custom untuk membantu berbagai proses
        industri makanan dan minuman, mulai dari pengolahan,
        pencampuran, pengisian, pemindahan, hingga pengemasan
        produk.
      </p>

      <div class="hero-actions">

        <a
          href={`${base}kontak/`}
          class="button button-primary"
        >
          Konsultasikan Kebutuhan
        </a>

        <a
          href={`${base}jasa/mesin-custom/`}
          class="button button-secondary"
        >
          Lihat Jasa Mesin Custom
        </a>

      </div>

    </div>
  </section>


  <!-- INTRO -->
  <section class="section">

    <div class="container intro-grid">

      <div>

        <span class="section-label">
          SOLUSI INDUSTRI MAKANAN & MINUMAN
        </span>

        <h2>
          Mesin Disesuaikan dengan Proses Produksi
        </h2>

      </div>

      <div>

        <p>
          Industri makanan dan minuman memiliki kebutuhan proses
          produksi yang beragam. Setiap produk dapat membutuhkan
          metode pengolahan, kapasitas, ukuran, material, dan
          sistem kerja mesin yang berbeda.
        </p>

        <p>
          Mesin custom dapat menjadi solusi ketika mesin standar
          belum dapat memenuhi kebutuhan proses secara optimal.
          Rancangan mesin dapat disesuaikan dengan fungsi,
          kapasitas produksi, jenis produk, serta kondisi ruang
          produksi.
        </p>

        <p>
          Kebutuhan tersebut dapat mencakup mesin pengolahan,
          mesin mixing, mesin filling, conveyor, mesin packaging,
          hingga sistem otomatisasi proses produksi.
        </p>

      </div>

    </div>

  </section>


  <!-- JENIS MESIN -->
  <section class="section section-light">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          JENIS MESIN
        </span>

        <h2>
          Contoh Mesin untuk Industri Makanan dan Minuman
        </h2>

        <p>
          Berbagai jenis mesin dapat dikembangkan berdasarkan
          kebutuhan proses dan karakteristik produk yang akan
          diproses.
        </p>

      </div>


      <div class="machine-grid">

        <article class="machine-card">

          <div class="machine-icon">
            ⚙
          </div>

          <h3>
            Mesin Pengolahan
          </h3>

          <p>
            Mesin untuk membantu proses pengolahan bahan makanan
            dan minuman sesuai kebutuhan produksi.
          </p>

          <a href={`${base}jasa/mesin-custom/`}>
            Konsultasikan Mesin →
          </a>

        </article>


        <article class="machine-card">

          <div class="machine-icon">
            ⚙
          </div>

          <h3>
            Mesin Mixing
          </h3>

          <p>
            Sistem pencampuran bahan yang dapat dirancang
            berdasarkan karakteristik produk dan kapasitas
            produksi.
          </p>

          <a href={`${base}jasa/mesin-custom/`}>
            Konsultasikan Mesin →
          </a>

        </article>


        <article class="machine-card">

          <div class="machine-icon">
            ⚙
          </div>

          <h3>
            Mesin Filling
          </h3>

          <p>
            Mesin pengisian produk untuk membantu meningkatkan
            konsistensi dan efisiensi proses produksi.
          </p>

          <a href={`${base}jasa/mesin-custom/`}>
            Konsultasikan Mesin →
          </a>

        </article>


        <article class="machine-card">

          <div class="machine-icon">
            ⚙
          </div>

          <h3>
            Conveyor Industri
          </h3>

          <p>
            Sistem conveyor untuk pemindahan bahan maupun produk
            antarproses dalam lini produksi.
          </p>

          <a href={`${base}mesin/conveyor/`}>
            Lihat Conveyor →
          </a>

        </article>


        <article class="machine-card">

          <div class="machine-icon">
            ⚙
          </div>

          <h3>
            Mesin Packaging
          </h3>

          <p>
            Mesin pengemasan custom untuk membantu proses
            packaging berbagai jenis produk makanan dan minuman.
          </p>

          <a href={`${base}mesin/packaging/`}>
            Lihat Packaging →
          </a>

        </article>


        <article class="machine-card">

          <div class="machine-icon">
            ⚙
          </div>

          <h3>
            Mesin Produksi Custom
          </h3>

          <p>
            Sistem mesin produksi yang dirancang mengikuti
            alur kerja dan kebutuhan kapasitas produksi.
          </p>

          <a href={`${base}jasa/mesin-produksi-custom/`}>
            Lihat Jasa →
          </a>

        </article>

      </div>

    </div>

  </section>


  <!-- APLIKASI -->
  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          KEBUTUHAN PRODUKSI
        </span>

        <h2>
          Mesin Dapat Dikembangkan untuk Berbagai Proses
        </h2>

      </div>


      <div class="application-grid">

        <div class="application-card">

          <span>01</span>

          <h3>
            Persiapan Bahan
          </h3>

          <p>
            Membantu proses persiapan bahan sebelum masuk ke tahap
            pengolahan atau produksi berikutnya.
          </p>

        </div>


        <div class="application-card">

          <span>02</span>

          <h3>
            Pengolahan
          </h3>

          <p>
            Mesin dapat dirancang untuk mendukung proses
            pengolahan berdasarkan karakteristik bahan dan produk.
          </p>

        </div>


        <div class="application-card">

          <span>03</span>

          <h3>
            Filling
          </h3>

          <p>
            Sistem pengisian dapat disesuaikan dengan jenis
            produk, wadah, volume, dan kebutuhan produksi.
          </p>

        </div>


        <div class="application-card">

          <span>04</span>

          <h3>
            Pemindahan Produk
          </h3>

          <p>
            Conveyor dapat digunakan untuk membantu perpindahan
            bahan atau produk antarproses produksi.
          </p>

        </div>


        <div class="application-card">

          <span>05</span>

          <h3>
            Packaging
          </h3>

          <p>
            Mesin pengemasan dapat dikembangkan untuk mendukung
            kebutuhan packaging produk.
          </p>

        </div>


        <div class="application-card">

          <span>06</span>

          <h3>
            Otomatisasi
          </h3>

          <p>
            Sistem produksi dapat dikembangkan menuju proses yang
            lebih terkontrol dan otomatis.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- KEUNGGULAN -->
  <section class="section section-dark">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          KEUNGGULAN
        </span>

        <h2>
          Keuntungan Menggunakan Mesin Custom
        </h2>

      </div>


      <div class="benefit-grid">

        <div class="benefit">

          <span>01</span>

          <h3>
            Sesuai Produk
          </h3>

          <p>
            Konsep mesin dapat disesuaikan dengan karakteristik
            produk yang diproses.
          </p>

        </div>


        <div class="benefit">

          <span>02</span>

          <h3>
            Sesuai Kapasitas
          </h3>

          <p>
            Kapasitas kerja dapat dirancang mengikuti kebutuhan
            target produksi.
          </p>

        </div>


        <div class="benefit">

          <span>03</span>

          <h3>
            Fleksibel
          </h3>

          <p>
            Dimensi dan konfigurasi mesin dapat menyesuaikan
            kondisi ruang produksi.
          </p>

        </div>


        <div class="benefit">

          <span>04</span>

          <h3>
            Mendukung Efisiensi
          </h3>

          <p>
            Mesin dapat membantu mengurangi pekerjaan manual dan
            meningkatkan konsistensi proses.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- PROSES -->
  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          PROSES PEMBUATAN
        </span>

        <h2>
          Tahapan Pembuatan Mesin Makanan dan Minuman
        </h2>

      </div>


      <div class="process-grid">

        <div class="process-card">

          <span>01</span>

          <h3>
            Konsultasi
          </h3>

          <p>
            Membahas jenis produk, proses produksi, kapasitas,
            fungsi mesin, dan kebutuhan operasional.
          </p>

        </div>


        <div class="process-card">

          <span>02</span>

          <h3>
            Perancangan
          </h3>

          <p>
            Menentukan konsep, dimensi, mekanisme, material,
            komponen, dan sistem kerja mesin.
          </p>

        </div>


        <div class="process-card">

          <span>03</span>

          <h3>
            Fabrikasi
          </h3>

          <p>
            Pembuatan rangka dan komponen mesin berdasarkan
            rancangan yang telah ditentukan.
          </p>

        </div>


        <div class="process-card">

          <span>04</span>

          <h3>
            Assembly & Testing
          </h3>

          <p>
            Perakitan dan pengujian untuk memastikan fungsi mesin
            berjalan sesuai kebutuhan.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- INTERNAL LINK -->
  <section class="section section-light">

    <div class="container related">

      <div>

        <span class="section-label">
          EKSPLORASI
        </span>

        <h2>
          Lihat Solusi Mesin Lainnya
        </h2>

      </div>


      <div class="related-links">

        <a href={`${base}mesin/`}>
          Semua Kategori Mesin →
        </a>

        <a href={`${base}mesin/packaging/`}>
          Mesin Packaging →
        </a>

        <a href={`${base}mesin/conveyor/`}>
          Conveyor Custom →
        </a>

        <a href={`${base}jasa/otomatisasi-industri/`}>
          Otomatisasi Industri →
        </a>

        <a href={`${base}artikel/`}>
          Artikel Mesin & Industri →
        </a>

        <a href={`${base}portfolio/`}>
          Portfolio Mesin Custom →
        </a>

      </div>

    </div>

  </section>


  <!-- CTA -->
  <section class="cta">

    <div class="container cta-inner">

      <div>

        <span class="section-label">
          KONSULTASI MESIN
        </span>

        <h2>
          Membutuhkan Mesin Makanan atau Minuman Custom?
        </h2>

        <p>
          Sampaikan jenis produk, proses produksi, kapasitas,
          ukuran, atau fungsi mesin yang dibutuhkan untuk
          mendapatkan solusi yang lebih sesuai.
        </p>

      </div>


      <div class="cta-actions">

        <a
          href={`${base}kontak/`}
          class="button button-primary"
        >
          Konsultasikan Sekarang
        </a>

        <a
          href={`${base}portfolio/`}
          class="button button-secondary"
        >
          Lihat Portfolio
        </a>

      </div>

    </div>

  </section>

</BaseLayout>


<style>
  .hero {
    padding: 100px 0;
    background:
      linear-gradient(
        135deg,
        #f8fafc 0%,
        #ecfeff 100%
      );
  }

  .eyebrow,
  .section-label {
    display: inline-block;
    margin-bottom: 14px;
    color: #0f766e;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 900px;
    margin: 0;
    color: #0f172a;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1.08;
    letter-spacing: -2px;
  }

  .hero-description {
    max-width: 780px;
    margin: 25px 0 0;
    color: #475569;
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-actions,
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 22px;
    border-radius: 9px;
    text-decoration: none;
    font-weight: 700;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: #0f766e;
    color: #ffffff;
  }

  .button-primary:hover {
    box-shadow: 0 10px 25px rgba(15, 118, 110, 0.2);
  }

  .button-secondary {
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
  }

  .section {
    padding: 90px 0;
  }

  .section-light {
    background: #f8fafc;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 70px;
  }

  .intro-grid h2,
  .section-heading h2,
  .related h2,
  .cta h2 {
    margin: 0;
    color: #0f172a;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.15;
    letter-spacing: -1px;
  }

  .intro-grid p {
    margin-top: 0;
    margin-bottom: 20px;
    color: #475569;
    font-size: 17px;
    line-height: 1.85;
  }

  .section-heading {
    max-width: 850px;
    margin-bottom: 40px;
  }

  .section-heading p {
    margin: 18px 0 0;
    color: #64748b;
    line-height: 1.8;
    font-size: 17px;
  }

  .machine-grid,
  .application-grid,
  .benefit-grid,
  .process-grid {
    display: grid;
    gap: 24px;
  }

  .machine-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .application-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .benefit-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .process-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .machine-card,
  .application-card {
    padding: 30px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
  }

  .machine-card {
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .machine-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 35px rgba(15, 23, 42, 0.08);
  }

  .machine-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    border-radius: 13px;
    background: #ccfbf1;
    font-size: 25px;
  }

  .machine-card h3,
  .application-card h3 {
    margin: 0 0 12px;
    color: #0f172a;
    font-size: 19px;
    line-height: 1.4;
  }

  .machine-card p,
  .application-card p {
    color: #64748b;
    line-height: 1.75;
  }

  .machine-card a {
    color: #0f766e;
    font-weight: 700;
    text-decoration: none;
  }

  .application-card > span {
    display: block;
    margin-bottom: 18px;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
  }

  .section-dark {
    background: #0f172a;
  }

  .section-dark .section-heading h2 {
    color: #ffffff;
  }

  .benefit {
    padding: 28px;
    border: 1px solid #334155;
    border-radius: 14px;
    background: #172033;
  }

  .benefit > span {
    display: block;
    margin-bottom: 18px;
    color: #2dd4bf;
    font-size: 13px;
    font-weight: 800;
  }

  .benefit h3 {
    margin: 0 0 10px;
    color: #ffffff;
    font-size: 19px;
  }

  .benefit p {
    margin: 0;
    color: #cbd5e1;
    line-height: 1.75;
  }

  .process-card {
    padding: 28px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
  }

  .process-card > span {
    display: block;
    margin-bottom: 18px;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
  }

  .process-card h3 {
    margin: 0 0 12px;
    color: #0f172a;
    font-size: 19px;
  }

  .process-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.75;
  }

  .related {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 70px;
    align-items: start;
  }

  .related-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .related-links a {
    display: block;
    padding: 18px 20px;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: #ffffff;
    color: #0f766e;
    font-weight: 700;
    text-decoration: none;
  }

  .related-links a:hover {
    border-color: #99f6e4;
    background: #f0fdfa;
  }

  .cta {
    padding: 80px 0;
    background: #ecfeff;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
  }

  .cta h2 {
    max-width: 750px;
  }

  .cta p {
    max-width: 700px;
    margin: 18px 0 0;
    color: #475569;
    line-height: 1.8;
  }

  .cta-actions {
    flex-shrink: 0;
    margin-top: 0;
  }

  @media (max-width: 1000px) {
    .intro-grid,
    .related {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .machine-grid,
    .application-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .benefit-grid,
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cta-inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .cta-actions {
      margin-top: 0;
    }
  }

  @media (max-width: 650px) {
    .hero {
      padding: 70px 0;
    }

    .section {
      padding: 65px 0;
    }

    .machine-grid,
    .application-grid,
    .benefit-grid,
    .process-grid,
    .related-links {
      grid-template-columns: 1fr;
    }

    .hero-actions,
    .cta-actions {
      width: 100%;
      flex-direction: column;
    }

    .button {
      width: 100%;
    }
  }
</style>
