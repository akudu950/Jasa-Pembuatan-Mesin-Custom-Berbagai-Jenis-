---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Pembuatan Conveyor Custom untuk Kebutuhan Industri"
  description="Jasa pembuatan conveyor custom untuk kebutuhan pemindahan material dan produk pada berbagai proses produksi, manufaktur, makanan dan minuman, packaging, pertanian, dan industri lainnya."
>

  <section class="hero">
    <div class="container">

      <span class="eyebrow">
        CONVEYOR CUSTOM
      </span>

      <h1>
        Pembuatan Conveyor Custom untuk Kebutuhan Industri
      </h1>

      <p>
        Conveyor custom dirancang untuk membantu proses pemindahan produk,
        material, bahan baku, maupun hasil produksi sesuai layout,
        kapasitas, ukuran, dan alur kerja industri.
      </p>

      <div class="hero-actions">

        <a
          href={`${base}kontak/`}
          class="btn btn-primary"
        >
          Konsultasikan Kebutuhan
        </a>

        <a
          href={`${base}jasa/pembuatan-conveyor/`}
          class="btn btn-secondary"
        >
          Lihat Jasa Conveyor
        </a>

      </div>

    </div>
  </section>


  <section class="section">
    <div class="container">

      <div class="section-heading">

        <span class="eyebrow">
          SOLUSI PEMINDAHAN MATERIAL
        </span>

        <h2>
          Conveyor Disesuaikan dengan Kebutuhan Produksi
        </h2>

        <p>
          Sistem conveyor dapat dibuat dengan konfigurasi dan spesifikasi
          berbeda sesuai jenis material, kapasitas pemindahan, panjang jalur,
          ketinggian, serta kondisi area produksi.
        </p>

      </div>


      <div class="grid">

        <article class="card">
          <div class="icon">⚙️</div>

          <h3>Belt Conveyor</h3>

          <p>
            Conveyor menggunakan belt untuk memindahkan berbagai jenis
            produk atau material secara kontinu dalam proses produksi.
          </p>
        </article>


        <article class="card">
          <div class="icon">🔩</div>

          <h3>Roller Conveyor</h3>

          <p>
            Sistem roller conveyor untuk pemindahan barang, box, kemasan,
            pallet, dan material dengan karakteristik tertentu.
          </p>
        </article>


        <article class="card">
          <div class="icon">🏭</div>

          <h3>Conveyor Produksi</h3>

          <p>
            Conveyor yang dirancang untuk mendukung alur produksi dari
            satu proses kerja menuju proses berikutnya.
          </p>
        </article>


        <article class="card">
          <div class="icon">📦</div>

          <h3>Conveyor Packaging</h3>

          <p>
            Sistem conveyor untuk mendukung proses filling, sealing,
            labeling, inspeksi, dan pengemasan produk.
          </p>
        </article>


        <article class="card">
          <div class="icon">🔄</div>

          <h3>Conveyor Transfer</h3>

          <p>
            Conveyor untuk membantu perpindahan produk atau material
            antarposisi, mesin, maupun area kerja.
          </p>
        </article>


        <article class="card">
          <div class="icon">📐</div>

          <h3>Conveyor Custom</h3>

          <p>
            Sistem conveyor dengan ukuran, bentuk, jalur, dan konfigurasi
            yang dibuat sesuai kondisi serta kebutuhan pengguna.
          </p>
        </article>

      </div>

    </div>
  </section>


  <section class="section section-light">
    <div class="container">

      <div class="section-heading">

        <span class="eyebrow">
          APLIKASI INDUSTRI
        </span>

        <h2>
          Conveyor untuk Berbagai Kebutuhan Produksi
        </h2>

        <p>
          Conveyor dapat digunakan sebagai bagian dari sistem produksi
          maupun diintegrasikan dengan mesin lain untuk membentuk alur
          kerja yang lebih terstruktur.
        </p>

      </div>


      <div class="application-grid">

        <div class="application-card">
          <h3>Industri Makanan & Minuman</h3>

          <p>
            Pemindahan bahan, produk, kemasan, dan hasil produksi pada
            berbagai tahapan proses pengolahan.
          </p>
        </div>


        <div class="application-card">
          <h3>Industri Manufaktur</h3>

          <p>
            Membantu pemindahan komponen, material, produk setengah jadi,
            maupun produk jadi.
          </p>
        </div>


        <div class="application-card">
          <h3>Packaging</h3>

          <p>
            Mendukung proses pengemasan, labeling, inspeksi, hingga
            pemindahan produk menuju area penyimpanan.
          </p>
        </div>


        <div class="application-card">
          <h3>Pertanian & Agro</h3>

          <p>
            Pemindahan hasil panen, bahan pertanian, produk olahan,
            dan material agroindustri.
          </p>
        </div>


        <div class="application-card">
          <h3>Pengolahan Material</h3>

          <p>
            Membantu proses pemindahan material dari satu tahapan
            pengolahan menuju tahapan berikutnya.
          </p>
        </div>


        <div class="application-card">
          <h3>Gudang & Distribusi</h3>

          <p>
            Conveyor dapat digunakan untuk membantu perpindahan barang
            dan produk dalam area kerja atau gudang.
          </p>
        </div>

      </div>

    </div>
  </section>


  <section class="section">
    <div class="container">

      <div class="two-column">

        <div>

          <span class="eyebrow">
            PERANCANGAN CONVEYOR
          </span>

          <h2>
            Faktor Penting dalam Pembuatan Conveyor Custom
          </h2>

          <p>
            Perancangan conveyor harus mempertimbangkan karakteristik
            material dan kondisi area pemasangan agar sistem dapat bekerja
            sesuai kebutuhan.
          </p>

        </div>


        <div class="check-list">

          <div>
            <strong>Jenis Material</strong>

            <p>
              Material yang dipindahkan menjadi dasar dalam menentukan
              jenis conveyor dan komponen yang digunakan.
            </p>
          </div>


          <div>
            <strong>Kapasitas</strong>

            <p>
              Kapasitas pemindahan perlu disesuaikan dengan target
              produksi dan kecepatan proses.
            </p>
          </div>


          <div>
            <strong>Panjang & Lebar Conveyor</strong>

            <p>
              Dimensi conveyor disesuaikan dengan ukuran produk,
              jalur pemindahan, dan kondisi area produksi.
            </p>
          </div>


          <div>
            <strong>Ketinggian & Layout</strong>

            <p>
              Posisi conveyor dapat disesuaikan dengan layout mesin
              dan kebutuhan perpindahan material.
            </p>
          </div>


          <div>
            <strong>Sistem Penggerak</strong>

            <p>
              Motor dan sistem penggerak dipilih berdasarkan beban,
              kecepatan, dan kebutuhan operasional conveyor.
            </p>
          </div>

        </div>

      </div>

    </div>
  </section>


  <section class="section section-light">
    <div class="container">

      <div class="section-heading">

        <span class="eyebrow">
          PROSES PEMBUATAN
        </span>

        <h2>
          Tahapan Pembuatan Conveyor Custom
        </h2>

        <p>
          Pembuatan conveyor dilakukan melalui beberapa tahapan agar
          spesifikasi sistem sesuai dengan kebutuhan pemindahan material.
        </p>

      </div>


      <div class="process-grid">

        <div class="process-card">
          <span>01</span>

          <h3>Analisis Kebutuhan</h3>

          <p>
            Memahami material, kapasitas, jalur, dan kebutuhan proses.
          </p>
        </div>


        <div class="process-card">
          <span>02</span>

          <h3>Perancangan</h3>

          <p>
            Menentukan dimensi, konfigurasi, komponen, dan sistem penggerak.
          </p>
        </div>


        <div class="process-card">
          <span>03</span>

          <h3>Fabrikasi</h3>

          <p>
            Pembuatan rangka dan komponen conveyor sesuai desain.
          </p>
        </div>


        <div class="process-card">
          <span>04</span>

          <h3>Assembly</h3>

          <p>
            Perakitan rangka, belt atau roller, motor, dan komponen lainnya.
          </p>
        </div>


        <div class="process-card">
          <span>05</span>

          <h3>Testing</h3>

          <p>
            Pengujian sistem sebelum conveyor digunakan dalam proses produksi.
          </p>
        </div>

      </div>

    </div>
  </section>


  <section class="section">
    <div class="container">

      <div class="section-heading">

        <span class="eyebrow">
          TERKAIT
        </span>

        <h2>
          Kategori Mesin Lainnya
        </h2>

      </div>


      <div class="related-grid">

        <a href={`${base}mesin/makanan-minuman/`}>
          <strong>Mesin Makanan & Minuman</strong>

          <span>
            Mesin custom untuk kebutuhan pengolahan dan produksi makanan
            serta minuman.
          </span>
        </a>


        <a href={`${base}mesin/manufaktur-logam/`}>
          <strong>Manufaktur & Logam</strong>

          <span>
            Solusi mesin custom untuk kebutuhan manufaktur dan pengolahan
            material.
          </span>
        </a>


        <a href={`${base}mesin/pertanian-agro/`}>
          <strong>Pertanian & Agro</strong>

          <span>
            Mesin untuk pengolahan hasil pertanian dan kebutuhan agroindustri.
          </span>
        </a>


        <a href={`${base}mesin/pengolahan-limbah/`}>
          <strong>Pengolahan Limbah</strong>

          <span>
            Solusi mesin untuk berbagai proses pengolahan dan pemrosesan limbah.
          </span>
        </a>


        <a href={`${base}mesin/packaging/`}>
          <strong>Packaging</strong>

          <span>
            Mesin packaging custom untuk berbagai kebutuhan pengemasan produk.
          </span>
        </a>

      </div>

    </div>
  </section>


  <section class="cta-section">
    <div class="container">

      <h2>
        Membutuhkan Conveyor Custom?
      </h2>

      <p>
        Sampaikan jenis material, ukuran produk, kapasitas pemindahan,
        panjang jalur, serta kondisi area pemasangan untuk menentukan
        konsep conveyor yang sesuai.
      </p>

      <a
        href={`${base}kontak/`}
        class="btn btn-light"
      >
        Konsultasikan Kebutuhan Conveyor
      </a>

    </div>
  </section>

</BaseLayout>


<style>
  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }

  .hero {
    padding: 100px 0;
    background:
      linear-gradient(
        135deg,
        #f0fdfa 0%,
        #ffffff 55%,
        #f8fafc 100%
      );
  }

  .hero h1 {
    max-width: 850px;
    margin: 15px 0 20px;
    font-size: clamp(36px, 5vw, 58px);
    line-height: 1.08;
    color: #0f172a;
  }

  .hero p {
    max-width: 760px;
    color: #475569;
    font-size: 18px;
    line-height: 1.8;
  }

  .eyebrow {
    display: inline-block;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 22px;
    border-radius: 9px;
    text-decoration: none;
    font-weight: 700;
    transition: 0.2s ease;
  }

  .btn-primary {
    background: #0f766e;
    color: #ffffff;
  }

  .btn-primary:hover {
    background: #115e59;
  }

  .btn-secondary {
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
  }

  .btn-secondary:hover {
    border-color: #0f766e;
    color: #0f766e;
  }

  .section {
    padding: 90px 0;
  }

  .section-light {
    background: #f8fafc;
  }

  .section-heading {
    max-width: 780px;
    margin-bottom: 45px;
  }

  .section-heading h2 {
    margin: 10px 0 16px;
    font-size: clamp(30px, 4vw, 42px);
    line-height: 1.2;
    color: #0f172a;
  }

  .section-heading p {
    color: #64748b;
    line-height: 1.8;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .card {
    padding: 30px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
  }

  .icon {
    font-size: 30px;
    margin-bottom: 18px;
  }

  .card h3 {
    margin: 0 0 12px;
    color: #0f172a;
    font-size: 20px;
  }

  .card p {
    margin: 0;
    color: #64748b;
    line-height: 1.7;
  }

  .application-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .application-card {
    padding: 26px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
  }

  .application-card h3 {
    margin-top: 0;
    color: #0f172a;
  }

  .application-card p {
    margin-bottom: 0;
    color: #64748b;
    line-height: 1.7;
  }

  .two-column {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: start;
  }

  .two-column h2 {
    margin: 12px 0 18px;
    color: #0f172a;
    font-size: clamp(30px, 4vw, 42px);
    line-height: 1.2;
  }

  .two-column > div > p {
    color: #64748b;
    line-height: 1.8;
  }

  .check-list {
    display: grid;
    gap: 18px;
  }

  .check-list > div {
    padding: 22px;
    border-left: 4px solid #0f766e;
    background: #f8fafc;
    border-radius: 8px;
  }

  .check-list strong {
    display: block;
    margin-bottom: 7px;
    color: #0f172a;
  }

  .check-list p {
    margin: 0;
    color: #64748b;
    line-height: 1.7;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
  }

  .process-card {
    padding: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
  }

  .process-card span {
    display: inline-flex;
    margin-bottom: 18px;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
  }

  .process-card h3 {
    margin: 0 0 10px;
    color: #0f172a;
  }

  .process-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.6;
    font-size: 14px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .related-grid a {
    display: block;
    padding: 24px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    text-decoration: none;
    background: #ffffff;
  }

  .related-grid a:hover {
    border-color: #0f766e;
  }

  .related-grid strong {
    display: block;
    margin-bottom: 8px;
    color: #0f172a;
  }

  .related-grid span {
    color: #64748b;
    line-height: 1.6;
    font-size: 14px;
  }

  .cta-section {
    padding: 90px 0;
    background: #0f766e;
    text-align: center;
  }

  .cta-section h2 {
    margin: 0 0 16px;
    color: #ffffff;
    font-size: clamp(30px, 4vw, 44px);
  }

  .cta-section p {
    max-width: 720px;
    margin: 0 auto 30px;
    color: #d1fae5;
    line-height: 1.8;
  }

  .btn-light {
    background: #ffffff;
    color: #0f766e;
  }

  .btn-light:hover {
    background: #f0fdfa;
  }

  @media (max-width: 900px) {
    .grid,
    .application-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .two-column {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 70px 0;
    }

    .section {
      padding: 65px 0;
    }

    .grid,
    .application-grid,
    .process-grid,
    .related-grid {
      grid-template-columns: 1fr;
    }

    .hero-actions {
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }
  }
</style>
