---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Mesin Pengolahan Limbah Custom untuk Industri"
  description="Jasa pembuatan mesin pengolahan limbah custom untuk kebutuhan pemrosesan, pemisahan, pengurangan volume, pemindahan material, dan sistem pengolahan limbah industri."
>

  <!-- HERO -->
  <section class="hero">
    <div class="container">

      <span class="eyebrow">
        MESIN PENGOLAHAN LIMBAH
      </span>

      <h1>
        Mesin Pengolahan Limbah Custom untuk Kebutuhan Industri
      </h1>

      <p class="hero-description">
        Solusi pembuatan mesin custom untuk membantu proses
        pengolahan, pemindahan, pemisahan, pengurangan volume,
        dan penanganan berbagai jenis material limbah sesuai
        kebutuhan proses.
      </p>

      <div class="hero-actions">

        <a
          href={`${base}kontak/`}
          class="button button-primary"
        >
          Konsultasikan Kebutuhan
        </a>

        <a
          href={`${base}jasa/mesin-custom/`}
          class="button button-secondary"
        >
          Jasa Mesin Custom
        </a>

      </div>

    </div>
  </section>


  <!-- INTRO -->
  <section class="section">

    <div class="container intro-grid">

      <div>

        <span class="section-label">
          SOLUSI PENGOLAHAN LIMBAH
        </span>

        <h2>
          Mesin Disesuaikan dengan Karakteristik Material
        </h2>

      </div>

      <div>

        <p>
          Pengelolaan limbah pada setiap industri dapat memiliki
          kebutuhan yang berbeda. Jenis material, kadar air,
          ukuran, volume, karakteristik bahan, serta proses yang
          diperlukan dapat memengaruhi konsep mesin yang digunakan.
        </p>

        <p>
          Mesin custom dapat dikembangkan untuk membantu proses
          penanganan material sesuai kebutuhan operasional.
          Sistem mesin dapat dirancang berdasarkan fungsi,
          kapasitas, metode kerja, dan kondisi lokasi.
        </p>

        <p>
          Kebutuhan tersebut dapat mencakup sistem pemindahan,
          pencacahan, pemisahan, pengolahan, pengurangan volume,
          hingga sistem pendukung proses lainnya.
        </p>

      </div>

    </div>

  </section>


  <!-- JENIS SOLUSI -->
  <section class="section section-light">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          JENIS MESIN
        </span>

        <h2>
          Contoh Solusi Mesin Pengolahan Limbah
        </h2>

        <p>
          Jenis mesin dapat dikembangkan berdasarkan karakteristik
          material dan tahapan proses yang dibutuhkan.
        </p>

      </div>


      <div class="machine-grid">

        <article class="machine-card">

          <div class="machine-icon">
            ⚙
          </div>

          <h3>
            Mesin Pencacah
          </h3>

          <p>
            Mesin untuk membantu proses pengecilan ukuran material
            sebelum masuk ke tahap pengolahan berikutnya.
          </p>

          <a href={`${base}jasa/mesin-custom/`}>
            Konsultasikan Mesin →
          </a>

        </article>


        <article class="machine-card">

          <div class="machine-icon">
            ⚙
          </div>

          <h3>
            Mesin Pemilah
          </h3>

          <p>
            Sistem pemilahan dapat dirancang untuk membantu
            memisahkan material berdasarkan karakteristik tertentu.
          </p>

          <a href={`${base}jasa/mesin-custom/`}>
            Konsultasikan →
          </a>

        </article>


        <article class="machine-card">

          <div class="machine-icon">
            ⚙
          </div>

          <h3>
            Mesin Pengering
          </h3>

          <p>
            Sistem pengeringan dapat disesuaikan dengan jenis
            material, kapasitas, dan kebutuhan proses.
          </p>

          <a href={`${base}jasa/mesin-custom/`}>
            Konsultasikan →
          </a>

        </article>


        <article class="machine-card">

          <div class="machine-icon">
            ⚙
          </div>

          <h3>
            Conveyor Limbah
          </h3>

          <p>
            Conveyor dapat digunakan untuk membantu pemindahan
            material dari satu tahapan proses ke tahapan lainnya.
          </p>

          <a href={`${base}mesin/conveyor/`}>
            Lihat Conveyor →
          </a>

        </article>


        <article class="machine-card">

          <div class="machine-icon">
            ⚙
          </div>

          <h3>
            Mesin Pemadat Material
          </h3>

          <p>
            Sistem pemadatan dapat dikembangkan untuk membantu
            proses penanganan material tertentu.
          </p>

          <a href={`${base}jasa/mesin-custom/`}>
            Konsultasikan →
          </a>

        </article>


        <article class="machine-card">

          <div class="machine-icon">
            ⚙
          </div>

          <h3>
            Sistem Pengolahan Custom
          </h3>

          <p>
            Sistem khusus dapat dirancang berdasarkan tahapan
            proses dan karakteristik material yang ditangani.
          </p>

          <a href={`${base}jasa/mesin-custom/`}>
            Lihat Mesin Custom →
          </a>

        </article>

      </div>

    </div>

  </section>


  <!-- TAHAPAN PROSES -->
  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          TAHAPAN PROSES
        </span>

        <h2>
          Mesin Dapat Mendukung Berbagai Tahapan Pengolahan
        </h2>

      </div>


      <div class="application-grid">

        <div class="application-card">

          <span>01</span>

          <h3>
            Penampungan
          </h3>

          <p>
            Sistem pendukung dapat membantu proses penampungan
            atau pengumpulan material sebelum diproses.
          </p>

        </div>


        <div class="application-card">

          <span>02</span>

          <h3>
            Pemindahan
          </h3>

          <p>
            Conveyor atau sistem handling dapat digunakan untuk
            memindahkan material antarproses.
          </p>

        </div>


        <div class="application-card">

          <span>03</span>

          <h3>
            Pengecilan Ukuran
          </h3>

          <p>
            Proses pencacahan dapat membantu menyesuaikan ukuran
            material dengan kebutuhan tahap berikutnya.
          </p>

        </div>


        <div class="application-card">

          <span>04</span>

          <h3>
            Pemisahan
          </h3>

          <p>
            Sistem pemisahan dapat dikembangkan berdasarkan
            karakteristik material yang ingin diproses.
          </p>

        </div>


        <div class="application-card">

          <span>05</span>

          <h3>
            Pengeringan
          </h3>

          <p>
            Proses pengeringan dapat dirancang berdasarkan jenis
            material dan kapasitas pengolahan.
          </p>

        </div>


        <div class="application-card">

          <span>06</span>

          <h3>
            Pengolahan Lanjutan
          </h3>

          <p>
            Sistem dapat dikembangkan sesuai kebutuhan proses
            lanjutan setelah material diproses.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- FAKTOR -->
  <section class="section section-dark">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          PERANCANGAN MESIN
        </span>

        <h2>
          Faktor Penting dalam Perancangan Mesin Limbah
        </h2>

      </div>


      <div class="factor-grid">

        <div class="factor-card">

          <span>01</span>

          <h3>
            Karakteristik Material
          </h3>

          <p>
            Jenis dan karakter material menjadi pertimbangan utama
            dalam menentukan mekanisme mesin.
          </p>

        </div>


        <div class="factor-card">

          <span>02</span>

          <h3>
            Kapasitas
          </h3>

          <p>
            Kapasitas mesin perlu disesuaikan dengan jumlah
            material yang harus diproses.
          </p>

        </div>


        <div class="factor-card">

          <span>03</span>

          <h3>
            Ukuran Material
          </h3>

          <p>
            Ukuran material dapat memengaruhi rancangan bagian
            kerja dan sistem pemrosesan mesin.
          </p>

        </div>


        <div class="factor-card">

          <span>04</span>

          <h3>
            Kadar Air
          </h3>

          <p>
            Kondisi material termasuk kadar air dapat menjadi
            pertimbangan dalam menentukan sistem pengolahan.
          </p>

        </div>


        <div class="factor-card">

          <span>05</span>

          <h3>
            Layout Lokasi
          </h3>

          <p>
            Dimensi dan konfigurasi mesin dapat disesuaikan
            dengan kondisi area pemasangan.
          </p>

        </div>


        <div class="factor-card">

          <span>06</span>

          <h3>
            Sistem Otomatisasi
          </h3>

          <p>
            Sistem dapat dikembangkan untuk mendukung proses
            yang lebih terkontrol dan efisien.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- PROSES -->
  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          PROSES PEMBUATAN
        </span>

        <h2>
          Tahapan Pembuatan Mesin Pengolahan Limbah
        </h2>

      </div>


      <div class="process-grid">

        <div class="process-card">

          <span>01</span>

          <h3>
            Identifikasi Kebutuhan
          </h3>

          <p>
            Memahami jenis material, kapasitas, tahapan proses,
            dan fungsi mesin yang diperlukan.
          </p>

        </div>


        <div class="process-card">

          <span>02</span>

          <h3>
            Perancangan
          </h3>

          <p>
            Menentukan konsep, mekanisme, dimensi, material,
            dan sistem kerja mesin.
          </p>

        </div>


        <div class="process-card">

          <span>03</span>

          <h3>
            Fabrikasi
          </h3>

          <p>
            Pembuatan rangka dan komponen berdasarkan rancangan
            yang telah ditentukan.
          </p>

        </div>


        <div class="process-card">

          <span>04</span>

          <h3>
            Testing
          </h3>

          <p>
            Pengujian fungsi mesin sebelum digunakan pada proses
            operasional.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- RELATED -->
  <section class="section section-light">

    <div class="container related">

      <div>

        <span class="section-label">
          EKSPLORASI
        </span>

        <h2>
          Solusi Mesin Lainnya
        </h2>

      </div>


      <div class="related-links">

        <a href={`${base}mesin/`}>
          Semua Kategori Mesin →
        </a>

        <a href={`${base}mesin/conveyor/`}>
          Conveyor Custom →
        </a>

        <a href={`${base}mesin/packaging/`}>
          Mesin Packaging →
        </a>

        <a href={`${base}jasa/mesin-custom/`}>
          Jasa Mesin Custom →
        </a>

        <a href={`${base}jasa/fabrikasi-mesin/`}>
          Jasa Fabrikasi Mesin →
        </a>

        <a href={`${base}artikel/`}>
          Artikel Mesin & Industri →
        </a>

      </div>

    </div>

  </section>


  <!-- CTA -->
  <section class="cta">

    <div class="container cta-inner">

      <div>

        <span class="section-label">
          KONSULTASI MESIN
        </span>

        <h2>
          Membutuhkan Mesin Pengolahan Limbah Custom?
        </h2>

        <p>
          Sampaikan jenis material, kapasitas, tahapan proses,
          ukuran, atau fungsi mesin yang dibutuhkan untuk
          mendapatkan konsep solusi yang sesuai.
        </p>

      </div>


      <div class="cta-actions">

        <a
          href={`${base}kontak/`}
          class="button button-primary"
        >
          Konsultasikan Sekarang
        </a>

        <a
          href={`${base}portfolio/`}
          class="button button-secondary"
        >
          Lihat Portfolio
        </a>

      </div>

    </div>

  </section>

</BaseLayout>


<style>
  .hero {
    padding: 100px 0;
    background:
      linear-gradient(
        135deg,
        #f8fafc 0%,
        #ecfeff 100%
      );
  }

  .eyebrow,
  .section-label {
    display: inline-block;
    margin-bottom: 14px;
    color: #0f766e;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 900px;
    margin: 0;
    color: #0f172a;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1.08;
    letter-spacing: -2px;
  }

  .hero-description {
    max-width: 780px;
    margin: 25px 0 0;
    color: #475569;
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-actions,
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 22px;
    border-radius: 9px;
    text-decoration: none;
    font-weight: 700;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: #0f766e;
    color: #ffffff;
  }

  .button-primary:hover {
    box-shadow: 0 10px 25px rgba(15, 118, 110, 0.2);
  }

  .button-secondary {
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
  }

  .section {
    padding: 90px 0;
  }

  .section-light {
    background: #f8fafc;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 70px;
  }

  .intro-grid h2,
  .section-heading h2,
  .related h2,
  .cta h2 {
    margin: 0;
    color: #0f172a;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.15;
    letter-spacing: -1px;
  }

  .intro-grid p {
    margin-top: 0;
    margin-bottom: 20px;
    color: #475569;
    font-size: 17px;
    line-height: 1.85;
  }

  .section-heading {
    max-width: 900px;
    margin-bottom: 40px;
  }

  .section-heading p {
    margin: 18px 0 0;
    color: #64748b;
    line-height: 1.8;
    font-size: 17px;
  }

  .machine-grid,
  .application-grid,
  .factor-grid,
  .process-grid {
    display: grid;
    gap: 24px;
  }

  .machine-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .application-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .factor-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .process-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .machine-card,
  .application-card,
  .process-card {
    padding: 30px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
  }

  .machine-card {
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .machine-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 35px rgba(15, 23, 42, 0.08);
  }

  .machine-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    border-radius: 13px;
    background: #ccfbf1;
    font-size: 25px;
  }

  .machine-card h3,
  .application-card h3 {
    margin: 0 0 12px;
    color: #0f172a;
    font-size: 19px;
    line-height: 1.4;
  }

  .machine-card p,
  .application-card p {
    color: #64748b;
    line-height: 1.75;
  }

  .machine-card a {
    color: #0f766e;
    font-weight: 700;
    text-decoration: none;
  }

  .application-card > span,
  .factor-card > span,
  .process-card > span {
    display: block;
    margin-bottom: 18px;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
  }

  .section-dark {
    background: #0f172a;
  }

  .section-dark .section-heading h2 {
    color: #ffffff;
  }

  .factor-card {
    padding: 28px;
    border: 1px solid #334155;
    border-radius: 14px;
    background: #172033;
  }

  .factor-card > span {
    color: #2dd4bf;
  }

  .factor-card h3 {
    margin: 0 0 10px;
    color: #ffffff;
    font-size: 19px;
  }

  .factor-card p {
    margin: 0;
    color: #cbd5e1;
    line-height: 1.75;
  }

  .process-card > span {
    color: #0f766e;
  }

  .process-card h3 {
    margin: 0 0 12px;
    color: #0f172a;
    font-size: 19px;
  }

  .process-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.75;
  }

  .related {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 70px;
    align-items: start;
  }

  .related-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .related-links a {
    display: block;
    padding: 18px 20px;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: #ffffff;
    color: #0f766e;
    font-weight: 700;
    text-decoration: none;
  }

  .related-links a:hover {
    border-color: #99f6e4;
    background: #f0fdfa;
  }

  .cta {
    padding: 80px 0;
    background: #ecfeff;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 50px;
  }

  .cta h2 {
    max-width: 750px;
  }

  .cta p {
    max-width: 700px;
    margin: 18px 0 0;
    color: #475569;
    line-height: 1.8;
  }

  .cta-actions {
    flex-shrink: 0;
    margin-top: 0;
  }

  @media (max-width: 1000px) {
    .intro-grid,
    .related {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .machine-grid,
    .application-grid,
    .factor-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cta-inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .cta-actions {
      margin-top: 0;
    }
  }

  @media (max-width: 650px) {
    .hero {
      padding: 70px 0;
    }

    .section {
      padding: 65px 0;
    }

    .machine-grid,
    .application-grid,
    .factor-grid,
    .process-grid,
    .related-links {
      grid-template-columns: 1fr;
    }

    .hero-actions,
    .cta-actions {
      width: 100%;
      flex-direction: column;
    }

    .button {
      width: 100%;
    }
  }
</style>
