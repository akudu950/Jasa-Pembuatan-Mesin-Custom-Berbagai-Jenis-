---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Jasa Pembuatan Mesin Custom | Mesin Industri Sesuai Kebutuhan"
  description="Jasa pembuatan mesin custom untuk kebutuhan industri, produksi, manufaktur, makanan dan minuman, pertanian, packaging, conveyor, dan otomatisasi."
>

  <section class="hero">
    <div class="container hero-content">

      <div class="hero-text">

        <span class="eyebrow">
          JASA PEMBUATAN MESIN CUSTOM
        </span>

        <h1>
          Solusi Mesin Custom
          <span>Sesuai Kebutuhan Industri</span>
        </h1>

        <p>
          Jasa pembuatan mesin custom untuk membantu meningkatkan
          efisiensi, produktivitas, dan kebutuhan otomatisasi proses
          produksi Anda.
        </p>

        <div class="hero-buttons">
          <a
            href="https://wa.me/6281234567890?text=Halo%2C%20saya%20ingin%20konsultasi%20tentang%20pembuatan%20mesin%20custom."
            class="btn-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            Konsultasi Sekarang
          </a>

          <a href="#layanan" class="btn-secondary">
            Lihat Layanan
          </a>
        </div>

      </div>

      <div class="hero-visual">
        <div class="machine-box">
          <div class="machine-gear">⚙</div>

          <h2>Custom Machine</h2>

          <p>
            Dirancang berdasarkan kebutuhan proses,
            kapasitas, ukuran, dan fungsi mesin.
          </p>
        </div>
      </div>

    </div>
  </section>


  <section id="layanan" class="section">
    <div class="container">

      <div class="section-heading">
        <span class="eyebrow">LAYANAN</span>

        <h2>
          Jasa Pembuatan Mesin untuk Berbagai Kebutuhan
        </h2>

        <p>
          Mesin dapat dirancang dan dibuat sesuai kebutuhan
          proses produksi, kapasitas, material, ukuran, dan
          sistem kerja yang dibutuhkan.
        </p>
      </div>


      <div class="service-grid">

        <article class="service-card">
          <h3>Mesin Produksi Custom</h3>

          <p>
            Pembuatan mesin produksi dengan spesifikasi
            yang disesuaikan dengan kebutuhan proses kerja.
          </p>

          <a href="/jasa/mesin-produksi-custom/">
            Pelajari Selengkapnya →
          </a>
        </article>


        <article class="service-card">
          <h3>Mesin Makanan & Minuman</h3>

          <p>
            Solusi mesin untuk proses pengolahan,
            produksi, filling, packaging, dan kebutuhan
            industri makanan dan minuman.
          </p>

          <a href="/mesin/makanan-minuman/">
            Lihat Mesin →
          </a>
        </article>


        <article class="service-card">
          <h3>Mesin Packaging</h3>

          <p>
            Mesin packaging custom untuk membantu
            meningkatkan kecepatan dan konsistensi proses
            pengemasan.
          </p>

          <a href="/mesin/packaging/">
            Lihat Mesin →
          </a>
        </article>


        <article class="service-card">
          <h3>Conveyor</h3>

          <p>
            Perancangan dan pembuatan conveyor untuk
            kebutuhan pemindahan material dan produk.
          </p>

          <a href="/mesin/conveyor/">
            Lihat Conveyor →
          </a>
        </article>


        <article class="service-card">
          <h3>Mesin Pertanian</h3>

          <p>
            Mesin custom untuk membantu proses pertanian,
            pengolahan hasil panen, dan kebutuhan agroindustri.
          </p>

          <a href="/mesin/pertanian/">
            Lihat Mesin →
          </a>
        </article>


        <article class="service-card">
          <h3>Otomatisasi Industri</h3>

          <p>
            Solusi mesin dan sistem otomatisasi untuk
            meningkatkan efisiensi proses produksi.
          </p>

          <a href="/jasa/otomatisasi-industri/">
            Pelajari Selengkapnya →
          </a>
        </article>

      </div>

    </div>
  </section>


  <section class="section section-light">

    <div class="container">

      <div class="section-heading">
        <span class="eyebrow">KEUNGGULAN</span>

        <h2>
          Mengapa Memilih Mesin Custom?
        </h2>
      </div>


      <div class="benefit-grid">

        <div class="benefit">
          <strong>01</strong>

          <h3>Sesuai Kebutuhan</h3>

          <p>
            Spesifikasi mesin dapat disesuaikan dengan
            kebutuhan proses produksi.
          </p>
        </div>


        <div class="benefit">
          <strong>02</strong>

          <h3>Fleksibel</h3>

          <p>
            Desain dapat menyesuaikan ruang,
            kapasitas, material, dan sistem kerja.
          </p>
        </div>


        <div class="benefit">
          <strong>03</strong>

          <h3>Mendukung Efisiensi</h3>

          <p>
            Mesin dirancang untuk membantu meningkatkan
            efisiensi dan produktivitas.
          </p>
        </div>


        <div class="benefit">
          <strong>04</strong>

          <h3>Dapat Dikembangkan</h3>

          <p>
            Sistem mesin dapat dikembangkan mengikuti
            kebutuhan produksi di masa mendatang.
          </p>
        </div>

      </div>

    </div>

  </section>


  <section class="cta">

    <div class="container cta-content">

      <span class="eyebrow">
        BUTUH MESIN KHUSUS?
      </span>

      <h2>
        Diskusikan Kebutuhan Mesin Custom Anda
      </h2>

      <p>
        Jelaskan kebutuhan proses, kapasitas, ukuran,
        atau fungsi mesin yang diperlukan.
      </p>

      <a
        href="https://wa.me/6281234567890?text=Halo%2C%20saya%20ingin%20konsultasi%20mengenai%20pembuatan%20mesin%20custom."
        target="_blank"
        rel="noopener noreferrer"
        class="cta-button"
      >
        Konsultasi via WhatsApp
      </a>

    </div>

  </section>

</BaseLayout>


<style>

  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }


  .hero {
    padding: 100px 0;
    background:
      linear-gradient(
        135deg,
        #f8fafc,
        #e2e8f0
      );
  }


  .hero-content {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 70px;
  }


  .eyebrow {
    display: inline-block;
    margin-bottom: 15px;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }


  h1 {
    margin: 0;
    color: #0f172a;
    font-size: clamp(42px, 6vw, 70px);
    line-height: 1.05;
    letter-spacing: -2px;
  }


  h1 span {
    display: block;
    color: #0f766e;
  }


  .hero-text p {
    max-width: 650px;
    margin: 25px 0;
    color: #475569;
    font-size: 18px;
    line-height: 1.8;
  }


  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
  }


  .btn-primary,
  .btn-secondary,
  .cta-button {
    display: inline-block;
    padding: 14px 22px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
  }


  .btn-primary,
  .cta-button {
    background: #0f766e;
    color: white;
  }


  .btn-secondary {
    background: white;
    color: #0f172a;
    border: 1px solid #cbd5e1;
  }


  .hero-visual {
    display: flex;
    justify-content: center;
  }


  .machine-box {
    width: min(100%, 430px);
    min-height: 350px;
    padding: 45px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: white;
    border-radius: 24px;
    box-shadow: 0 25px 60px rgba(15, 23, 42, 0.12);
  }


  .machine-gear {
    font-size: 90px;
    margin-bottom: 20px;
  }


  .machine-box h2 {
    color: #0f172a;
    margin: 0;
  }


  .machine-box p {
    color: #64748b;
    line-height: 1.7;
  }


  .section {
    padding: 90px 0;
  }


  .section-light {
    background: #f8fafc;
  }


  .section-heading {
    max-width: 760px;
    margin-bottom: 50px;
  }


  .section-heading h2,
  .cta h2 {
    margin: 0 0 15px;
    color: #0f172a;
    font-size: clamp(30px, 4vw, 45px);
    line-height: 1.15;
  }


  .section-heading p {
    color: #64748b;
    line-height: 1.8;
  }


  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }


  .service-card {
    padding: 30px;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }


  .service-card h3 {
    margin-top: 0;
    color: #0f172a;
    font-size: 20px;
  }


  .service-card p {
    color: #64748b;
    line-height: 1.7;
  }


  .service-card a {
    color: #0f766e;
    font-weight: 700;
    text-decoration: none;
  }


  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
  }


  .benefit {
    padding: 25px;
    background: white;
    border-radius: 14px;
    border: 1px solid #e2e8f0;
  }


  .benefit strong {
    color: #0f766e;
    font-size: 28px;
  }


  .benefit h3 {
    color: #0f172a;
  }


  .benefit p {
    color: #64748b;
    line-height: 1.7;
  }


  .cta {
    padding: 100px 0;
    background: #0f172a;
  }


  .cta-content {
    text-align: center;
    max-width: 800px;
  }


  .cta h2 {
    color: white;
  }


  .cta p {
    color: #cbd5e1;
    line-height: 1.8;
    margin-bottom: 30px;
  }


  @media (max-width: 900px) {

    .hero-content {
      grid-template-columns: 1fr;
    }

    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .benefit-grid {
      grid-template-columns: repeat(2, 1fr);
    }

  }


  @media (max-width: 600px) {

    .hero {
      padding: 70px 0;
    }

    .service-grid,
    .benefit-grid {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: 42px;
    }

  }

</style>
