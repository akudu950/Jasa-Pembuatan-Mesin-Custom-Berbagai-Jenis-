---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../data/site";

const base = import.meta.env.BASE_URL;

const whatsappUrl =
  `https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(
    siteConfig.whatsappMessage
  )}`;
---

<BaseLayout
  title="Kontak Jasa Pembuatan Mesin Custom"
  description="Hubungi untuk konsultasi kebutuhan jasa pembuatan mesin custom, fabrikasi mesin, mesin produksi, conveyor, packaging, otomatisasi, dan kebutuhan mesin industri lainnya."
>

  <!-- HERO -->
  <section class="hero">

    <div class="container">

      <span class="eyebrow">
        KONSULTASI MESIN CUSTOM
      </span>

      <h1>
        Konsultasikan Kebutuhan Mesin Custom Anda
      </h1>

      <p>
        Sampaikan kebutuhan proses, kapasitas, fungsi, ukuran,
        atau jenis mesin yang ingin dikembangkan untuk kebutuhan
        produksi dan industri.
      </p>

    </div>

  </section>


  <!-- CONTACT -->
  <section class="section">

    <div class="container contact-grid">

      <!-- MAIN CONTACT -->

      <div class="contact-main">

        <span class="section-label">
          HUBUNGI
        </span>

        <h2>
          Mulai dari Konsultasi Kebutuhan
        </h2>

        <p>
          Setiap proyek mesin custom memiliki kebutuhan yang berbeda.
          Karena itu, proses dapat dimulai dengan pembahasan mengenai
          fungsi mesin, alur proses, kapasitas produksi, material,
          ruang pemasangan, dan kebutuhan lainnya.
        </p>


        <a
          href={whatsappUrl}
          class="whatsapp-card"
          target="_blank"
          rel="noopener noreferrer"
        >

          <div class="whatsapp-icon">
            WA
          </div>

          <div>

            <strong>
              Konsultasi melalui WhatsApp
            </strong>

            <span>
              Klik untuk mengirim kebutuhan mesin
            </span>

          </div>

          <b>
            →
          </b>

        </a>


        <div class="contact-information">

          <div class="information-item">

            <span>
              EMAIL
            </span>

            <strong>
              {siteConfig.email}
            </strong>

          </div>


          <div class="information-item">

            <span>
              WHATSAPP
            </span>

            <strong>
              +{siteConfig.whatsapp}
            </strong>

          </div>

        </div>

      </div>


      <!-- SIDEBAR -->

      <aside class="contact-sidebar">

        <div class="sidebar-card">

          <span class="section-label">
            INFORMASI PROYEK
          </span>

          <h2>
            Informasi yang Sebaiknya Disiapkan
          </h2>

          <p>
            Semakin lengkap informasi awal yang diberikan,
            semakin mudah kebutuhan mesin dipahami.
          </p>


          <ul>

            <li>
              Jenis mesin yang dibutuhkan
            </li>

            <li>
              Fungsi atau proses yang ingin dilakukan
            </li>

            <li>
              Kapasitas produksi
            </li>

            <li>
              Jenis material atau produk
            </li>

            <li>
              Ukuran produk atau benda kerja
            </li>

            <li>
              Perkiraan ukuran mesin
            </li>

            <li>
              Tingkat otomatisasi yang diinginkan
            </li>

            <li>
              Foto atau gambar referensi jika tersedia
            </li>

          </ul>

        </div>

      </aside>

    </div>

  </section>


  <!-- SERVICES -->
  <section class="section section-light">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          LAYANAN
        </span>

        <h2>
          Kebutuhan Mesin yang Dapat Dikonsultasikan
        </h2>

        <p>
          Jelajahi layanan yang tersedia sebelum menentukan
          jenis mesin yang sesuai dengan kebutuhan proses.
        </p>

      </div>


      <div class="service-grid">

        <a
          href={`${base}jasa/mesin-custom/`}
          class="service-card"
        >

          <span>
            01
          </span>

          <strong>
            Jasa Pembuatan Mesin Custom
          </strong>

          <small>
            Mesin dengan fungsi dan spesifikasi sesuai kebutuhan.
          </small>

        </a>


        <a
          href={`${base}jasa/fabrikasi-mesin/`}
          class="service-card"
        >

          <span>
            02
          </span>

          <strong>
            Jasa Fabrikasi Mesin
          </strong>

          <small>
            Fabrikasi rangka, komponen, dan konstruksi mesin.
          </small>

        </a>


        <a
          href={`${base}jasa/otomatisasi-industri/`}
          class="service-card"
        >

          <span>
            03
          </span>

          <strong>
            Otomatisasi Industri
          </strong>

          <small>
            Pengembangan sistem untuk membantu otomatisasi proses.
          </small>

        </a>


        <a
          href={`${base}jasa/mesin-produksi-custom/`}
          class="service-card"
        >

          <span>
            04
          </span>

          <strong>
            Mesin Produksi Custom
          </strong>

          <small>
            Mesin produksi yang disesuaikan dengan kebutuhan proses.
          </small>

        </a>


        <a
          href={`${base}jasa/pembuatan-conveyor/`}
          class="service-card"
        >

          <span>
            05
          </span>

          <strong>
            Pembuatan Conveyor
          </strong>

          <small>
            Conveyor custom untuk pemindahan material dan produk.
          </small>

        </a>


        <a
          href={`${base}jasa/mesin-packaging/`}
          class="service-card"
        >

          <span>
            06
          </span>

          <strong>
            Mesin Packaging
          </strong>

          <small>
            Solusi mesin untuk kebutuhan pengemasan produk.
          </small>

        </a>

      </div>

    </div>

  </section>


  <!-- PROCESS -->
  <section class="section">

    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          PROSES KONSULTASI
        </span>

        <h2>
          Dari Kebutuhan hingga Pengembangan Mesin
        </h2>

      </div>


      <div class="process-grid">

        <div class="process-card">

          <span>
            01
          </span>

          <h3>
            Sampaikan Kebutuhan
          </h3>

          <p>
            Jelaskan proses, fungsi, kapasitas, dan jenis mesin
            yang dibutuhkan.
          </p>

        </div>


        <div class="process-card">

          <span>
            02
          </span>

          <h3>
            Pembahasan Teknis
          </h3>

          <p>
            Kebutuhan dibahas untuk menentukan konsep dan
            spesifikasi mesin yang sesuai.
          </p>

        </div>


        <div class="process-card">

          <span>
            03
          </span>

          <h3>
            Perancangan
          </h3>

          <p>
            Konsep mesin dapat dikembangkan menjadi rancangan
            berdasarkan kebutuhan proyek.
          </p>

        </div>


        <div class="process-card">

          <span>
            04
          </span>

          <h3>
            Pengembangan Mesin
          </h3>

          <p>
            Setelah spesifikasi ditentukan, proses dapat dilanjutkan
            menuju fabrikasi, assembly, dan testing.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- FAQ -->
  <section class="section section-light">

    <div class="container faq-container">

      <div class="section-heading">

        <span class="section-label">
          FAQ
        </span>

        <h2>
          Pertanyaan Seputar Konsultasi Mesin Custom
        </h2>

      </div>


      <div class="faq-list">

        <details>
          <summary>
            Apakah bisa membuat mesin dengan spesifikasi khusus?
          </summary>

          <p>
            Bisa. Mesin custom pada dasarnya dikembangkan berdasarkan
            kebutuhan fungsi, kapasitas, dimensi, material, dan proses
            yang ingin dilakukan.
          </p>
        </details>


        <details>
          <summary>
            Apa yang perlu disiapkan sebelum konsultasi?
          </summary>

          <p>
            Informasi seperti fungsi mesin, kapasitas produksi,
            jenis produk atau material, ukuran, serta gambar referensi
            akan membantu proses pembahasan.
          </p>
        </details>


        <details>
          <summary>
            Apakah mesin dapat dibuat untuk proses otomatis?
          </summary>

          <p>
            Tingkat otomatisasi dapat dibahas sesuai kebutuhan proses.
            Sistem dapat dirancang berdasarkan fungsi dan target
            operasional yang diinginkan.
          </p>
        </details>


        <details>
          <summary>
            Apakah bisa membuat conveyor sesuai ukuran tertentu?
          </summary>

          <p>
            Conveyor dapat dirancang berdasarkan panjang, lebar,
            tinggi, arah perpindahan, jenis material, dan kebutuhan
            proses yang akan dilayani.
          </p>
        </details>

      </div>

    </div>

  </section>


  <!-- FINAL CTA -->
  <section class="cta">

    <div class="container cta-inner">

      <div>

        <span>
          SIAP MEMBAHAS KEBUTUHAN MESIN?
        </span>

        <h2>
          Mulai Konsultasi Mesin Custom
        </h2>

        <p>
          Sampaikan kebutuhan Anda melalui WhatsApp untuk memulai
          pembahasan mengenai mesin yang ingin dikembangkan.
        </p>

      </div>


      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-button"
      >
        Konsultasi WhatsApp →
      </a>

    </div>

  </section>

</BaseLayout>


<style>
  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }

  .hero {
    padding: 90px 0;
    background:
      linear-gradient(
        135deg,
        #f0fdfa,
        #ffffff 60%,
        #f8fafc
      );
    border-bottom: 1px solid #e2e8f0;
  }

  .eyebrow,
  .section-label {
    display: inline-block;
    margin-bottom: 14px;
    color: #0f766e;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  .hero h1 {
    max-width: 850px;
    margin: 0;
    color: #0f172a;
    font-size: clamp(38px, 5vw, 62px);
    line-height: 1.1;
    letter-spacing: -1.5px;
  }

  .hero p {
    max-width: 760px;
    margin: 24px 0 0;
    color: #475569;
    font-size: 18px;
    line-height: 1.8;
  }

  .section {
    padding: 85px 0;
  }

  .section-light {
    background: #f8fafc;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 0.8fr);
    gap: 65px;
    align-items: start;
  }

  .contact-main h2,
  .section-heading h2 {
    margin: 0 0 18px;
    color: #0f172a;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.2;
  }

  .contact-main > p {
    max-width: 720px;
    margin: 0 0 30px;
    color: #64748b;
    line-height: 1.8;
    font-size: 17px;
  }

  .whatsapp-card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 24px;
    border-radius: 15px;
    background: #0f766e;
    color: #ffffff;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .whatsapp-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 35px rgba(15, 118, 110, 0.22);
  }

  .whatsapp-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #ffffff;
    color: #0f766e;
    font-size: 12px;
    font-weight: 900;
  }

  .whatsapp-card div:nth-child(2) {
    display: flex;
    flex-direction: column;
    gap: 5px;
    flex: 1;
  }

  .whatsapp-card strong {
    font-size: 16px;
  }

  .whatsapp-card span {
    color: #ccfbf1;
    font-size: 13px;
  }

  .whatsapp-card b {
    font-size: 25px;
  }

  .contact-information {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-top: 25px;
  }

  .information-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
    border: 1px solid #e2e8f0;
    border-radius: 13px;
  }

  .information-item span {
    color: #94a3b8;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
  }

  .information-item strong {
    color: #0f172a;
    font-size: 14px;
    word-break: break-word;
  }

  .sidebar-card {
    padding: 30px;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: #ffffff;
  }

  .sidebar-card h2 {
    margin: 0 0 14px;
    color: #0f172a;
    font-size: 25px;
    line-height: 1.3;
  }

  .sidebar-card > p {
    margin: 0 0 20px;
    color: #64748b;
    line-height: 1.7;
  }

  .sidebar-card ul {
    margin: 0;
    padding-left: 20px;
  }

  .sidebar-card li {
    margin: 11px 0;
    color: #475569;
    line-height: 1.5;
  }

  .section-heading {
    max-width: 800px;
    margin-bottom: 42px;
  }

  .section-heading p {
    margin: 0;
    color: #64748b;
    line-height: 1.8;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 27px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .service-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
  }

  .service-card > span,
  .process-card > span {
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
  }

  .service-card strong {
    color: #0f172a;
    font-size: 18px;
    line-height: 1.4;
  }

  .service-card small {
    color: #64748b;
    line-height: 1.6;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .process-card {
    padding: 27px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }

  .process-card h3 {
    margin: 18px 0 10px;
    color: #0f172a;
    font-size: 19px;
  }

  .process-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.7;
  }

  .faq-container {
    max-width: 950px;
  }

  .faq-list {
    border-top: 1px solid #e2e8f0;
  }

  details {
    border-bottom: 1px solid #e2e8f0;
  }

  summary {
    padding: 23px 0;
    color: #0f172a;
    font-size: 17px;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: "+";
    float: right;
    color: #0f766e;
    font-size: 22px;
  }

  details[open] summary::after {
    content: "−";
  }

  details p {
    max-width: 800px;
    margin: -5px 0 23px;
    color: #64748b;
    line-height: 1.8;
  }

  .cta {
    padding: 70px 0;
    background: #0f766e;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .cta-inner > div {
    max-width: 760px;
  }

  .cta-inner > div > span {
    color: #99f6e4;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.4px;
  }

  .cta h2 {
    margin: 12px 0;
    color: #ffffff;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.2;
  }

  .cta p {
    margin: 0;
    color: #ccfbf1;
    line-height: 1.8;
  }

  .cta-button {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 22px;
    border-radius: 9px;
    background: #ffffff;
    color: #0f766e;
    text-decoration: none;
    font-weight: 800;
    font-size: 14px;
  }

  @media (max-width: 950px) {

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }

  }

  @media (max-width: 650px) {

    .hero {
      padding: 65px 0;
    }

    .section {
      padding: 65px 0;
    }

    .service-grid,
    .process-grid,
    .contact-information {
      grid-template-columns: 1fr;
    }

    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero p,
    .contact-main > p {
      font-size: 16px;
    }

  }
</style>
