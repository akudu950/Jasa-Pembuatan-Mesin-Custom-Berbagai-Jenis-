---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteConfig } from "../../data/site";

const whatsappUrl =
  `https://wa.me/${siteConfig.whatsapp}?text=${encodeURIComponent(
    "Halo, saya ingin konsultasi tentang pembuatan mesin custom."
  )}`;
---

<BaseLayout
  title="Kontak Jasa Pembuatan Mesin Custom"
  description="Hubungi jasa pembuatan mesin custom untuk konsultasi kebutuhan mesin produksi, fabrikasi, otomatisasi, packaging, conveyor, dan mesin khusus industri."
>

  <section class="hero">
    <div class="container">

      <span class="eyebrow">
        HUBUNGI KAMI
      </span>

      <h1>
        Konsultasikan Kebutuhan Mesin Custom Anda
      </h1>

      <p>
        Sampaikan kebutuhan mesin, proses produksi, kapasitas,
        ukuran, material, atau fungsi yang ingin dibuat.
        Konsultasi awal dapat membantu menentukan konsep mesin
        yang sesuai.
      </p>

    </div>
  </section>


  <section class="contact-section">
    <div class="container contact-grid">

      <div class="contact-content">

        <span class="eyebrow">
          KONSULTASI MESIN
        </span>

        <h2>
          Mulai dari Kebutuhan Anda
        </h2>

        <p>
          Setiap kebutuhan produksi memiliki karakteristik yang
          berbeda. Karena itu, informasi mengenai proses kerja,
          kapasitas, ukuran produk, dan target penggunaan sangat
          membantu dalam menentukan konsep mesin custom.
        </p>

        <p>
          Anda dapat menghubungi melalui WhatsApp untuk menjelaskan
          kebutuhan mesin yang ingin dibuat.
        </p>


        <div class="contact-items">

          <div class="contact-item">

            <div class="icon">
              WA
            </div>

            <div>
              <span>
                WhatsApp
              </span>

              <strong>
                Konsultasi Mesin Custom
              </strong>
            </div>

          </div>


          <div class="contact-item">

            <div class="icon">
              @
            </div>

            <div>
              <span>
                Email
              </span>

              <strong>
                {siteConfig.email}
              </strong>
            </div>

          </div>

        </div>

      </div>


      <div class="contact-card">

        <h2>
          Konsultasi via WhatsApp
        </h2>

        <p>
          Cara paling mudah untuk memulai konsultasi adalah
          mengirimkan informasi kebutuhan mesin melalui WhatsApp.
        </p>


        <div class="info-list">

          <div>
            <strong>01</strong>
            <span>
              Jelaskan jenis mesin yang dibutuhkan.
            </span>
          </div>

          <div>
            <strong>02</strong>
            <span>
              Jelaskan fungsi atau proses kerja mesin.
            </span>
          </div>

          <div>
            <strong>03</strong>
            <span>
              Sampaikan kapasitas produksi jika sudah tersedia.
            </span>
          </div>

          <div>
            <strong>04</strong>
            <span>
              Sertakan ukuran produk atau material jika diperlukan.
            </span>
          </div>

        </div>


        <a
          href={whatsappUrl}
          class="whatsapp-button"
          target="_blank"
          rel="noopener noreferrer"
        >
          Mulai Konsultasi WhatsApp
        </a>

      </div>

    </div>
  </section>


  <section class="needs-section">
    <div class="container">

      <div class="section-heading">

        <span class="eyebrow">
          INFORMASI YANG DAPAT DISIAPKAN
        </span>

        <h2>
          Apa yang Sebaiknya Disampaikan?
        </h2>

        <p>
          Semakin lengkap informasi awal yang diberikan,
          semakin mudah kebutuhan mesin dipahami.
        </p>

      </div>


      <div class="needs-grid">

        <article>
          <span>01</span>

          <h3>
            Jenis Produk
          </h3>

          <p>
            Jelaskan produk atau material yang akan diproses
            menggunakan mesin.
          </p>
        </article>


        <article>
          <span>02</span>

          <h3>
            Kapasitas Produksi
          </h3>

          <p>
            Informasikan target kapasitas per jam, hari,
            atau periode produksi jika sudah diketahui.
          </p>
        </article>


        <article>
          <span>03</span>

          <h3>
            Fungsi Mesin
          </h3>

          <p>
            Jelaskan pekerjaan yang ingin dilakukan mesin,
            seperti mengolah, memindahkan, mengisi,
            mencacah, mengemas, atau proses lainnya.
          </p>
        </article>


        <article>
          <span>04</span>

          <h3>
            Kondisi Lokasi
          </h3>

          <p>
            Informasi mengenai ruang, ukuran area,
            sumber listrik, dan kondisi instalasi dapat
            membantu proses perancangan.
          </p>
        </article>

      </div>

    </div>
  </section>


  <section class="cta-section">
    <div class="container">

      <div class="cta-box">

        <div>

          <span class="eyebrow">
            MESIN SESUAI KEBUTUHAN
          </span>

          <h2>
            Punya Ide Mesin yang Ingin Dibuat?
          </h2>

          <p>
            Konsultasikan kebutuhan Anda dan jelaskan proses
            yang ingin dibuat lebih efektif dengan mesin custom.
          </p>

        </div>

        <a
          href={whatsappUrl}
          class="cta-button"
          target="_blank"
          rel="noopener noreferrer"
        >
          Hubungi WhatsApp
        </a>

      </div>

    </div>
  </section>

</BaseLayout>


<style>

  .hero {
    padding: 105px 0 85px;
    background:
      linear-gradient(
        135deg,
        #f0fdfa 0%,
        #ffffff 65%
      );
  }

  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 14px;
    color: #0f766e;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  h1 {
    max-width: 850px;
    margin: 0 0 22px;
    color: #0f172a;
    font-size: clamp(38px, 6vw, 62px);
    line-height: 1.08;
  }

  .hero p {
    max-width: 760px;
    margin: 0;
    color: #475569;
    font-size: 18px;
    line-height: 1.8;
  }

  .contact-section {
    padding: 90px 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 70px;
    align-items: start;
  }

  .contact-content h2 {
    margin: 0 0 18px;
    color: #0f172a;
    font-size: 36px;
    line-height: 1.2;
  }

  .contact-content > p {
    margin: 0 0 18px;
    color: #64748b;
    line-height: 1.8;
  }

  .contact-items {
    display: grid;
    gap: 15px;
    margin-top: 35px;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
  }

  .icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 45px;
    flex-shrink: 0;
    border-radius: 10px;
    background: #ccfbf1;
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
  }

  .contact-item span {
    display: block;
    margin-bottom: 3px;
    color: #64748b;
    font-size: 12px;
  }

  .contact-item strong {
    color: #0f172a;
    font-size: 15px;
  }

  .contact-card {
    padding: 35px;
    background: #0f172a;
    border-radius: 18px;
  }

  .contact-card h2 {
    margin: 0 0 12px;
    color: #ffffff;
    font-size: 28px;
  }

  .contact-card > p {
    margin: 0;
    color: #cbd5e1;
    line-height: 1.7;
  }

  .info-list {
    display: grid;
    gap: 15px;
    margin: 30px 0;
  }

  .info-list > div {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .info-list strong {
    color: #5eead4;
    font-size: 14px;
  }

  .info-list span {
    color: #e2e8f0;
    font-size: 14px;
    line-height: 1.6;
  }

  .whatsapp-button {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 20px;
    border-radius: 8px;
    background: #16a34a;
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
  }

  .whatsapp-button:hover {
    background: #15803d;
  }

  .needs-section {
    padding: 90px 0;
    background: #f8fafc;
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 45px;
  }

  .section-heading h2 {
    margin: 0 0 14px;
    color: #0f172a;
    font-size: 36px;
    line-height: 1.2;
  }

  .section-heading p {
    margin: 0;
    color: #64748b;
    line-height: 1.8;
  }

  .needs-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .needs-grid article {
    padding: 28px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }

  .needs-grid article > span {
    display: block;
    margin-bottom: 18px;
    color: #0f766e;
    font-size: 26px;
    font-weight: 800;
  }

  .needs-grid h3 {
    margin: 0 0 10px;
    color: #0f172a;
    font-size: 18px;
  }

  .needs-grid p {
    margin: 0;
    color: #64748b;
    font-size: 14px;
    line-height: 1.7;
  }

  .cta-section {
    padding: 90px 0 0;
  }

  .cta-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
    padding: 45px;
    border-radius: 18px;
    background: #0f766e;
  }

  .cta-box .eyebrow {
    color: #ccfbf1;
  }

  .cta-box h2 {
    max-width: 650px;
    margin: 0 0 12px;
    color: #ffffff;
    font-size: 34px;
    line-height: 1.2;
  }

  .cta-box p {
    max-width: 650px;
    margin: 0;
    color: #d1fae5;
    line-height: 1.7;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 14px 22px;
    border-radius: 8px;
    background: #ffffff;
    color: #0f766e;
    text-decoration: none;
    font-weight: 800;
  }

  .cta-button:hover {
    background: #f0fdfa;
  }

  @media (max-width: 900px) {

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .needs-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cta-box {
      flex-direction: column;
      align-items: flex-start;
    }

  }

  @media (max-width: 600px) {

    .hero {
      padding: 80px 0 65px;
    }

    .contact-section,
    .needs-section {
      padding: 65px 0;
    }

    .needs-grid {
      grid-template-columns: 1fr;
    }

    .contact-content h2,
    .section-heading h2 {
      font-size: 30px;
    }

    .contact-card {
      padding: 28px 22px;
    }

    .cta-section {
      padding-top: 65px;
    }

    .cta-box {
      padding: 30px 24px;
    }

    .cta-box h2 {
      font-size: 28px;
    }

  }

</style>
