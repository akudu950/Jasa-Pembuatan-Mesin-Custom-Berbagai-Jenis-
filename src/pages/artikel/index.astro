---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Artikel Mesin Custom dan Industri"
  description="Artikel seputar jasa pembuatan mesin custom, fabrikasi mesin, mesin produksi, packaging, conveyor, otomatisasi industri, dan berbagai solusi mesin."
>

  <!-- HERO -->
  <section class="hero">
    <div class="container">

      <span class="eyebrow">
        ARTIKEL & INFORMASI
      </span>

      <h1>
        Informasi Seputar Mesin Custom dan Industri
      </h1>

      <p>
        Temukan informasi mengenai pembuatan mesin custom,
        proses fabrikasi, mesin produksi, packaging,
        conveyor, otomatisasi, dan berbagai kebutuhan industri.
      </p>

    </div>
  </section>


  <!-- FEATURED ARTICLE -->
  <section class="section">
    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          ARTIKEL UTAMA
        </span>

        <h2>
          Jasa Pembuatan Mesin Custom
        </h2>

        <p>
          Panduan mengenai konsep mesin custom, manfaat,
          jenis mesin, proses pembuatan, serta faktor yang
          perlu dipertimbangkan sebelum membuat mesin.
        </p>

      </div>

      <article class="featured-card">

        <div class="featured-content">

          <span class="article-category">
            MESIN CUSTOM
          </span>

          <h2>
            Jasa Pembuatan Mesin Custom: Solusi Mesin Sesuai Kebutuhan Industri
          </h2>

          <p>
            Pelajari bagaimana mesin custom dapat dirancang
            berdasarkan proses produksi, kapasitas, material,
            layout area, dan kebutuhan otomatisasi industri.
          </p>

          <a
            href="/artikel/jasa-pembuatan-mesin-custom/"
            class="article-link"
          >
            Baca Artikel →
          </a>

        </div>

      </article>

    </div>
  </section>


  <!-- TOPIC -->
  <section class="section section-soft">
    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          TOPIK INDUSTRI
        </span>

        <h2>
          Topik yang Akan Dibahas
        </h2>

        <p>
          Struktur konten akan dikembangkan berdasarkan kebutuhan
          informasi pengguna dan berbagai topik yang berkaitan
          dengan mesin custom.
        </p>

      </div>

      <div class="topic-grid">

        <article class="topic-card">
          <span>01</span>

          <h3>
            Mesin Custom
          </h3>

          <p>
            Informasi mengenai konsep, manfaat, desain,
            dan pembuatan mesin custom.
          </p>
        </article>

        <article class="topic-card">
          <span>02</span>

          <h3>
            Mesin Produksi
          </h3>

          <p>
            Pembahasan mesin untuk membantu berbagai
            proses produksi industri.
          </p>
        </article>

        <article class="topic-card">
          <span>03</span>

          <h3>
            Otomatisasi Industri
          </h3>

          <p>
            Informasi tentang otomatisasi proses,
            integrasi mesin, dan sistem produksi.
          </p>
        </article>

        <article class="topic-card">
          <span>04</span>

          <h3>
            Packaging
          </h3>

          <p>
            Pembahasan mesin filling, sealing,
            labeling, counting, dan packaging.
          </p>
        </article>

        <article class="topic-card">
          <span>05</span>

          <h3>
            Conveyor
          </h3>

          <p>
            Informasi mengenai conveyor custom,
            sistem pemindahan material, dan integrasi produksi.
          </p>
        </article>

        <article class="topic-card">
          <span>06</span>

          <h3>
            Fabrikasi Mesin
          </h3>

          <p>
            Informasi tentang rangka mesin, komponen,
            material, dan proses fabrikasi.
          </p>
        </article>

      </div>

    </div>
  </section>


  <!-- INTERNAL LINKS -->
  <section class="section">
    <div class="container">

      <div class="section-heading">

        <span class="section-label">
          JELAJAHI WEBSITE
        </span>

        <h2>
          Temukan Solusi Mesin yang Sesuai
        </h2>

      </div>

      <div class="link-grid">

        <a href="/jasa/" class="link-card">
          <strong>Jasa Pembuatan Mesin</strong>
          <span>Lihat seluruh layanan →</span>
        </a>

        <a href="/mesin/" class="link-card">
          <strong>Katalog Mesin</strong>
          <span>Lihat kategori mesin →</span>
        </a>

        <a href="/portfolio/" class="link-card">
          <strong>Portfolio</strong>
          <span>Lihat contoh proyek →</span>
        </a>

        <a href="/kontak/" class="link-card">
          <strong>Kontak</strong>
          <span>Konsultasikan kebutuhan →</span>
        </a>

      </div>

    </div>
  </section>


  <!-- CTA -->
  <section class="cta">
    <div class="container cta-inner">

      <div>

        <span class="section-label">
          KONSULTASI
        </span>

        <h2>
          Punya Kebutuhan Mesin Custom?
        </h2>

        <p>
          Jika kebutuhan mesin Anda tidak tersedia dalam
          spesifikasi standar, konsultasikan kebutuhan
          tersebut untuk mendapatkan konsep yang sesuai.
        </p>

      </div>

      <a
        href="https://wa.me/6281234567890?text=Halo%2C%20saya%20ingin%20konsultasi%20tentang%20jasa%20pembuatan%20mesin%20custom."
        class="btn"
        target="_blank"
        rel="noopener noreferrer"
      >
        Konsultasi via WhatsApp
      </a>

    </div>
  </section>

</BaseLayout>


<style>
  .hero {
    padding: 90px 0;
    background: linear-gradient(
      135deg,
      #f8fafc,
      #ecfeff
    );
  }

  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }

  .eyebrow,
  .section-label {
    display: inline-block;
    margin-bottom: 14px;
    color: #0f766e;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  .hero h1 {
    max-width: 850px;
    margin: 0 0 20px;
    color: #0f172a;
    font-size: clamp(40px, 5vw, 62px);
    line-height: 1.08;
    letter-spacing: -1.5px;
  }

  .hero p {
    max-width: 780px;
    margin: 0;
    color: #475569;
    font-size: 18px;
    line-height: 1.8;
  }

  .section {
    padding: 85px 0;
  }

  .section-soft {
    background: #f8fafc;
  }

  .section-heading {
    max-width: 780px;
    margin-bottom: 42px;
  }

  .section-heading h2 {
    margin: 0 0 18px;
    color: #0f172a;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.15;
  }

  .section-heading p {
    margin: 0;
    color: #64748b;
    font-size: 17px;
    line-height: 1.8;
  }

  .featured-card {
    padding: 42px;
    border: 1px solid #dbeafe;
    border-radius: 18px;
    background: #ffffff;
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.07);
  }

  .featured-content {
    max-width: 850px;
  }

  .article-category {
    display: inline-block;
    margin-bottom: 15px;
    color: #0f766e;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.3px;
  }

  .featured-content h2 {
    margin: 0 0 16px;
    color: #0f172a;
    font-size: clamp(27px, 4vw, 38px);
    line-height: 1.2;
  }

  .featured-content p {
    margin: 0 0 25px;
    color: #64748b;
    line-height: 1.8;
  }

  .article-link {
    color: #0f766e;
    text-decoration: none;
    font-weight: 800;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .topic-card {
    padding: 28px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
  }

  .topic-card span {
    color: #0f766e;
    font-size: 13px;
    font-weight: 800;
  }

  .topic-card h3 {
    margin: 15px 0 10px;
    color: #0f172a;
    font-size: 20px;
  }

  .topic-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.7;
  }

  .link-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .link-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 25px;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    background: #ffffff;
    color: inherit;
    text-decoration: none;
  }

  .link-card strong {
    color: #0f172a;
    font-size: 18px;
  }

  .link-card span {
    color: #0f766e;
    font-size: 14px;
    font-weight: 700;
  }

  .link-card:hover {
    border-color: #99f6e4;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
  }

  .cta {
    padding: 75px 0;
    background: #0f172a;
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .cta h2 {
    margin: 0 0 15px;
    color: #ffffff;
    font-size: clamp(30px, 4vw, 44px);
  }

  .cta p {
    max-width: 700px;
    margin: 0;
    color: #cbd5e1;
    line-height: 1.8;
  }

  .cta .section-label {
    color: #5eead4;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 15px 22px;
    border-radius: 9px;
    background: #0f766e;
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
  }

  .btn:hover {
    background: #115e59;
  }

  @media (max-width: 850px) {
    .topic-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cta-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding: 65px 0;
    }

    .section {
      padding: 65px 0;
    }

    .topic-grid,
    .link-grid {
      grid-template-columns: 1fr;
    }

    .featured-card {
      padding: 28px;
    }
  }
</style>
