---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Artikel Mesin Custom dan Industri"
  description="Artikel tentang mesin custom, fabrikasi mesin, otomatisasi industri, mesin produksi, packaging, conveyor, mesin makanan, pertanian, dan pengolahan limbah."
>

  <section class="hero">
    <div class="container">

      <span class="eyebrow">
        ARTIKEL & INFORMASI
      </span>

      <h1>
        Informasi Seputar Mesin Custom dan Industri
      </h1>

      <p>
        Temukan informasi, panduan, ide, dan pembahasan seputar
        pembuatan mesin custom untuk berbagai kebutuhan industri
        dan proses produksi.
      </p>

    </div>
  </section>


  <section class="articles-section">
    <div class="container">

      <div class="section-heading">

        <span class="eyebrow">
          TOPIK UTAMA
        </span>

        <h2>
          Artikel Mesin Custom
        </h2>

        <p>
          Pembahasan mengenai pemilihan mesin, proses fabrikasi,
          otomatisasi, conveyor, packaging, hingga berbagai jenis
          mesin khusus untuk kebutuhan industri.
        </p>

      </div>


      <div class="article-grid">

        <article class="article-card">

          <div class="article-label">
            MESIN CUSTOM
          </div>

          <h3>
            Jasa Pembuatan Mesin Custom untuk Kebutuhan Industri
          </h3>

          <p>
            Mengenal konsep mesin custom dan bagaimana mesin dapat
            dirancang sesuai kebutuhan proses produksi, kapasitas,
            material, serta kondisi operasional.
          </p>

          <a href="#">
            Baca Artikel →
          </a>

        </article>


        <article class="article-card">

          <div class="article-label">
            FABRIKASI MESIN
          </div>

          <h3>
            Mengenal Proses Fabrikasi Mesin Custom
          </h3>

          <p>
            Pembahasan mengenai tahapan pembuatan mesin mulai dari
            konsultasi, desain, pemilihan material, fabrikasi,
            perakitan hingga pengujian.
          </p>

          <a href="#">
            Baca Artikel →
          </a>

        </article>


        <article class="article-card">

          <div class="article-label">
            OTOMATISASI
          </div>

          <h3>
            Mesin Otomatisasi untuk Meningkatkan Efisiensi Produksi
          </h3>

          <p>
            Bagaimana sistem otomatisasi dapat membantu mengurangi
            pekerjaan manual dan meningkatkan konsistensi proses
            produksi.
          </p>

          <a href="#">
            Baca Artikel →
          </a>

        </article>


        <article class="article-card">

          <div class="article-label">
            CONVEYOR
          </div>

          <h3>
            Conveyor Custom untuk Kebutuhan Material Handling
          </h3>

          <p>
            Mengenal berbagai jenis conveyor dan faktor yang perlu
            diperhatikan ketika menentukan conveyor untuk kebutuhan
            produksi.
          </p>

          <a href="#">
            Baca Artikel →
          </a>

        </article>


        <article class="article-card">

          <div class="article-label">
            PACKAGING
          </div>

          <h3>
            Mesin Packaging Custom untuk Berbagai Jenis Produk
          </h3>

          <p>
            Pembahasan mengenai mesin filling, sealing, packing,
            labeling, dan sistem packaging yang dapat disesuaikan
            dengan kebutuhan produk.
          </p>

          <a href="#">
            Baca Artikel →
          </a>

        </article>


        <article class="article-card">

          <div class="article-label">
            INDUSTRI
          </div>

          <h3>
            Cara Menentukan Spesifikasi Mesin Produksi Custom
          </h3>

          <p>
            Faktor penting yang perlu dipertimbangkan sebelum
            membuat mesin produksi custom agar sesuai dengan
            kebutuhan proses dan target produksi.
          </p>

          <a href="#">
            Baca Artikel →
          </a>

        </article>

      </div>

    </div>
  </section>


  <section class="topics-section">
    <div class="container">

      <div class="section-heading">

        <span class="eyebrow">
          KATEGORI
        </span>

        <h2>
          Topik yang Akan Dibahas
        </h2>

      </div>


      <div class="topic-grid">

        <a href="/mesin/makanan-minuman/">
          Mesin Makanan & Minuman
        </a>

        <a href="/mesin/manufaktur-logam/">
          Manufaktur & Logam
        </a>

        <a href="/mesin/pertanian-agro/">
          Pertanian & Agro
        </a>

        <a href="/mesin/pengolahan-limbah/">
          Pengolahan Limbah
        </a>

        <a href="/mesin/packaging/">
          Mesin Packaging
        </a>

        <a href="/mesin/conveyor/">
          Conveyor
        </a>

      </div>

    </div>
  </section>


  <section class="cta-section">
    <div class="container">

      <div class="cta-box">

        <div>

          <span class="eyebrow">
            BUTUH MESIN CUSTOM?
          </span>

          <h2>
            Konsultasikan Kebutuhan Mesin Anda
          </h2>

          <p>
            Jika membutuhkan mesin dengan spesifikasi khusus,
            konsultasikan kebutuhan proses dan kapasitas produksi
            sebelum menentukan desain mesin.
          </p>

        </div>

        <a
          href="https://wa.me/6281234567890?text=Halo%2C%20saya%20ingin%20konsultasi%20tentang%20pembuatan%20mesin%20custom."
          class="btn-primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          Konsultasi WhatsApp
        </a>

      </div>

    </div>
  </section>

</BaseLayout>


<style>

  .hero {
    padding: 105px 0 85px;
    background:
      linear-gradient(
        135deg,
        #f0fdfa 0%,
        #ffffff 65%
      );
  }

  .container {
    width: min(1180px, 92%);
    margin: 0 auto;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 14px;
    color: #0f766e;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  h1 {
    max-width: 850px;
    margin: 0 0 22px;
    color: #0f172a;
    font-size: clamp(38px, 6vw, 62px);
    line-height: 1.08;
  }

  .hero p {
    max-width: 750px;
    margin: 0;
    color: #475569;
    font-size: 18px;
    line-height: 1.8;
  }

  .articles-section {
    padding: 90px 0;
  }

  .section-heading {
    max-width: 760px;
    margin-bottom: 45px;
  }

  .section-heading h2 {
    margin: 0 0 14px;
    color: #0f172a;
    font-size: 36px;
    line-height: 1.2;
  }

  .section-heading p {
    margin: 0;
    color: #64748b;
    line-height: 1.8;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .article-card {
    padding: 30px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .article-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 15px 35px rgba(15, 23, 42, 0.08);
  }

  .article-label {
    margin-bottom: 15px;
    color: #0f766e;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
  }

  .article-card h3 {
    margin: 0 0 13px;
    color: #0f172a;
    font-size: 20px;
    line-height: 1.35;
  }

  .article-card p {
    margin: 0 0 20px;
    color: #64748b;
    font-size: 14px;
    line-height: 1.75;
  }

  .article-card a {
    color: #0f766e;
    text-decoration: none;
    font-size: 14px;
    font-weight: 800;
  }

  .article-card a:hover {
    color: #115e59;
  }

  .topics-section {
    padding: 90px 0;
    background: #f8fafc;
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .topic-grid a {
    padding: 22px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    color: #334155;
    text-decoration: none;
    font-weight: 700;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .topic-grid a:hover {
    border-color: #0f766e;
    color: #0f766e;
    transform: translateY(-2px);
  }

  .cta-section {
    padding: 90px 0 0;
  }

  .cta-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
    padding: 45px;
    border-radius: 18px;
    background: #0f172a;
  }

  .cta-box h2 {
    max-width: 650px;
    margin: 0 0 12px;
    color: #ffffff;
    font-size: 34px;
    line-height: 1.2;
  }

  .cta-box p {
    max-width: 650px;
    margin: 0;
    color: #cbd5e1;
    line-height: 1.7;
  }

  .cta-box .eyebrow {
    color: #5eead4;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 13px 22px;
    border-radius: 8px;
    background: #14b8a6;
    color: #ffffff;
    text-decoration: none;
    font-weight: 700;
  }

  .btn-primary:hover {
    background: #0d9488;
  }

  @media (max-width: 900px) {

    .article-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .topic-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cta-box {
      flex-direction: column;
      align-items: flex-start;
    }

  }

  @media (max-width: 600px) {

    .hero {
      padding: 80px 0 65px;
    }

    .articles-section,
    .topics-section {
      padding: 65px 0;
    }

    .article-grid,
    .topic-grid {
      grid-template-columns: 1fr;
    }

    .section-heading h2 {
      font-size: 30px;
    }

    .cta-section {
      padding-top: 65px;
    }

    .cta-box {
      padding: 30px 24px;
    }

    .cta-box h2 {
      font-size: 28px;
    }

  }

</style>
